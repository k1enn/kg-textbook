  <data key="d1">khac</data>
  <data key="d2">Động tác làm sạch đường thở bao gồm việc quan sát khoang miệng để lấy dị vật nếu thấy.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="khí quản qua màng nhẫn giáp">
  <data key="d0">khí quản qua màng nhẫn giáp</data>
  <data key="d1">khac</data>
  <data key="d2">Là một kỹ thuật mở đường thở thông qua màng nhẫn giáp, được thực hiện bằng cách đi qua da.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="đặt canuyn hầu">
  <data key="d0">đặt canuyn hầu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật dùng để duy trì sự thông thoáng của đường thở và thông khí đầy đủ, giúp hút đờm dãi dễ dàng hơn.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="canuyn miệng hầu">
  <data key="d0">canuyn miệng hầu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Loại canuyn được sử dụng trong kỹ thuật đặt canuyn hầu, có các loại như Guedel và Berman.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="canuyn mũi hầu">
  <data key="d0">canuyn mũi hầu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thiết bị được đặt qua mũi để tạo đường đi từ lỗ mũi đến gốc lưỡi, dùng khi không thể đặt canuyn miệng họng&lt;SEP&gt;Loại canuyn khác được sử dụng trong kỹ thuật đặt canuyn hầu, được đặt vào mũi của bệnh nhân.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
