  <data key="d1">doi_tuong</data>
  <data key="d2">Quá trình xác định xem dị vật có bị tống ra và đường thở có được giải phóng không.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
