<node id="hồi sinh tim phổi cơ bản">
  <data key="d0">hồi sinh tim phổi cơ bản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật cấp cứu được thực hiện ngay sau khi phát hiện bệnh nhân ngừng tuần hoàn để duy trì tuần hoàn và hô hấp.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1793017791</data>
