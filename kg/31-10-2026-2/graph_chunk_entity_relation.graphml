<node id="nội khí quản">
  <data key="d0">nội khí quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Biện pháp khai thông đường thở bằng việc đặt nội khí quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="thông khí nhân tạo">
  <data key="d0">thông khí nhân tạo</data>
  <data key="d1">khac</data>
  <data key="d2">Thủ thuật hỗ trợ thông khí cho bệnh nhân qua mặt nạ mũi, miệng hoặc toàn bộ mặt&lt;SEP&gt;Thủ thuật hỗ trợ thông khí bằng cách xâm nhập vào đường thở.&lt;SEP&gt;Thủ thuật hỗ trợ hô hấp bằng cách cung cấp không khí nhân tạo cho bệnh nhân.&lt;SEP&gt;Báo động tối thiểu được thiết lập để phòng ngừa các biến chứng trong thông khí nhân tạo</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-006&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-008</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tắc nghẽn đường hô hấp trên">
  <data key="d0">tắc nghẽn đường hô hấp trên</data>
  <data key="d1">khac</data>
  <data key="d2">Đặt nội khí quản được chỉ định khi có tắc nghẽn đường hô hấp trên.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
