</edge>
<edge source="phù phổi cấp" target="ngồi thõng chân">
  <data key="d7">2.0</data>
  <data key="d8">Bệnh nhân có phù phổi cấp được đặt trong tư thế ngồi thõng chân để giảm áp lực lên phổi.&lt;SEP&gt;Tư thế ngồi thõng chân được dùng để hỗ trợ điều trị bệnh nhân có phù phổi cấp.</data>
  <data key="d9">dieu_tri,doi_tuong_cua,phù phổi cấp</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
