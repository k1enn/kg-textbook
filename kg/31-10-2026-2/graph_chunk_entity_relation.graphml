  <data key="d0">tĩnh mạch chủ dưới</data>
  <data key="d1">khac</data>
  <data key="d2">Một mạch máu lớn nằm dưới bụng, bị chèn ép khi mang thai trên 7 tháng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
