<node id="Bất động chi gãy ở tư thế chức năng hoặc tư thế bệnh nhân thấy dễ chịu">
  <data key="d0">Bất động chi gãy ở tư thế chức năng hoặc tư thế bệnh nhân thấy dễ chịu</data>
  <data key="d1">thu_thuat</data>
