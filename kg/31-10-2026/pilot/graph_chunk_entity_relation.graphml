  <data key="d1">khac</data>
  <data key="d2">Một yếu tố được sử dụng để đưa ra quyết định chẩn đoán và xử trí trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="nguyên tắc">
  <data key="d0">nguyên tắc</data>
  <data key="d1">khac</data>
  <data key="d2">Một hướng dẫn được tuân thủ để đưa ra chẩn đoán và xử trí hợp lý trong tình huống cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="đáp ứng với điều trị">
  <data key="d0">đáp ứng với điều trị</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu cho thấy bệnh nhân phản ứng tích cực với phương pháp điều trị được áp dụng</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="không đáp ứng với điều trị">
  <data key="d0">không đáp ứng với điều trị</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu cho thấy bệnh nhân không phản ứng với phương pháp điều trị được áp dụng</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="tập trung suy nghĩ">
  <data key="d0">tập trung suy nghĩ</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hành vi của bác sĩ khi dành ít nhất 2-3 phút để suy xét từng bệnh nhân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="định hướng chuyển">
  <data key="d0">định hướng chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định về việc bệnh nhân được nhập viện, ra viện hoặc lưu theo dõi tại khoa cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="nhập viện">
  <data key="d0">nhập viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định đưa bệnh nhân vào khoa bệnh viện để tiếp tục điều trị</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="ra viện">
  <data key="d0">ra viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định cho bệnh nhân rời khỏi khoa cấp cứu và trở về nhà</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="lưu theo dõi">
  <data key="d0">lưu theo dõi</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định để bệnh nhân được giữ lại tại khoa cấp cứu trong thời gian chờ quyết định cuối cùng</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="thời gian vàng">
  <data key="d0">thời gian vàng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian nhất định trong đó can thiệp sớm có thể cải thiện tiên lượng bệnh nhân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="ngừng tuần hoàn">
  <data key="d0">ngừng tuần hoàn</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh nhân ngừng hoạt động tim mạch, cần can thiệp cấp cứu ngay lập tức</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="sốc điện">
  <data key="d0">sốc điện</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh nhân có nguy cơ ngừng tuần hoàn do rối loạn điện tim</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="hội chứng động mạch vành cấp">
  <data key="d0">hội chứng động mạch vành cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý do tắc mạch vành, cần can thiệp sớm trong thời gian ngắn&lt;SEP&gt;Là một bệnh lý liên quan đến tắc nghẽn động mạch vành, có cửa sổ thời gian dùng thuốc tiêu sợi huyết là 12 giờ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="NMCT có ST chênh lên">
  <data key="d0">NMCT có ST chênh lên</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến hội chứng động mạch vành cấp cần dùng thuốc tiêu sợi huyết</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="điện sớm">
  <data key="d0">điện sớm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng xuất hiện trong vòng 3 đến 5 phút đầu tiên sau khi xảy ra sự cố.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="tắc mạch não">
  <data key="d0">tắc mạch não</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý xảy ra do tắc nghẽn mạch máu não, có cửa sổ thời gian dùng thuốc tiêu sợi huyết là 3 giờ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="sốc nhiễm khuẩn">
  <data key="d0">sốc nhiễm khuẩn</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý nghiêm trọng do nhiễm khuẩn, cần điều trị bằng kháng sinh tiêm trong vòng 1 giờ và điều trị tích cực trong 6 giờ đầu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="vết thương động mạch/ga rô mạch">
  <data key="d0">vết thương động mạch/ga rô mạch</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tổn thương mạch máu, cần can thiệp tưới máu trong vòng 6 giờ để tránh nguy cơ phải cắt cụt nếu để muộn hơn 6 giờ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="thuốc tiêu sợi huyết">
  <data key="d0">thuốc tiêu sợi huyết</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc được dùng trong điều trị các bệnh lý mạch máu, với cửa sổ thời gian sử dụng khác nhau tùy theo loại bệnh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="alteplase">
  <data key="d0">alteplase</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc tiêu sợi huyết được sử dụng trong điều trị tắc mạch não với cửa sổ thời gian là 3 giờ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="kháng sinh đường tiêm">
  <data key="d0">kháng sinh đường tiêm</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là loại thuốc được dùng để điều trị sốc nhiễm khuẩn, cần tiêm trong vòng 1 giờ sau khi phát hiện.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="cửa sổ thời gian">
  <data key="d0">cửa sổ thời gian</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một chỉ số thời gian quan trọng để xác định thời điểm dùng thuốc hoặc can thiệp trong điều trị các bệnh lý mạch máu và não.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân quay lại">
  <data key="d0">bệnh nhân quay lại</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm bệnh nhân có thể có vấn đề cấp cứu chưa được phát hiện hoặc xử trí đúng trong lần cấp cứu trước, tạo cơ hội để sửa chữa sai sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="nhồi máu cơ tim cấp">
  <data key="d0">nhồi máu cơ tim cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý cấp tính do tắc mạch máu cơ tim, cần được nghĩ đến và loại trừ trong chẩn đoán để tránh bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="tắc động mạch phổi">
  <data key="d0">tắc động mạch phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý do tắc nghẽn động mạch phổi, cần được nghĩ đến và loại trừ trong chẩn đoán để tránh bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="tắc động/tĩnh mạch">
  <data key="d0">tắc động/tĩnh mạch</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý do tắc nghẽn động mạch hoặc tĩnh mạch, cần được nghĩ đến và loại trừ trong chẩn đoán để tránh bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="xuất huyết dưới nhện">
  <data key="d0">xuất huyết dưới nhện</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý do xuất huyết dưới màng nhện, thường xảy ra ở bệnh nhân ngộ độc, cần được nghĩ đến và loại trừ trong chẩn đoán.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="chảy máu não">
  <data key="d0">chảy máu não</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý do chảy máu trong não, thường xảy ra ở bệnh nhân ngộ độc, cần được nghĩ đến và loại trừ trong chẩn đoán.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="viêm màng não">
  <data key="d0">viêm màng não</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý do viêm màng não, cần được nghĩ đến và loại trừ trong chẩn đoán để tránh bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="viêm ruột thừa">
  <data key="d0">viêm ruột thừa</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý do viêm ruột thừa, cần được nghĩ đến và loại trừ trong chẩn đoán để tránh bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="chửa ngoài tử cung">
  <data key="d0">chửa ngoài tử cung</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý xảy ra khi tổ chức sinh dục bên ngoài tử cung bị tổn thương hoặc thoát ra.&lt;SEP&gt;Là một tình trạng bệnh lý do chửa ngoài tử cung, cần được nghĩ đến và loại trừ trong chẩn đoán để tránh bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-008</data>
