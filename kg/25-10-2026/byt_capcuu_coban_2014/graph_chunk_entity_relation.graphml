  <data key="d1">thuoc</data>
  <data key="d2">Sử dụng thuốc phù hợp để đối phó với các tình trạng loạn nhịp tim trong tình trạng phân ly điện cơ.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
