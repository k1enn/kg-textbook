  <data key="d0">Morphin sulphat 2 – 4 mg tiêm tĩnh mạch</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc tiêm tĩnh mạch được dùng khi tình trạng đau ngực không đáp ứng với nitrat.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="Heparin không phân đoạn liều đầu 60 đơn vị/kg tiêm tĩnh mạch">
  <data key="d0">Heparin không phân đoạn liều đầu 60 đơn vị/kg tiêm tĩnh mạch</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là liều đầu tiên của heparin không phân đoạn được tiêm tĩnh mạch với liều 60 đơn vị/kg.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="Enoxaparin">
  <data key="d0">Enoxaparin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc chống đông được dùng tiêm tĩnh mạch hoặc dưới da tùy theo độ tuổi bệnh nhân.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="Metoprolol tartrat 25-50 mg uống mỗi 6 – 12 giờ">
  <data key="d0">Metoprolol tartrat 25-50 mg uống mỗi 6 – 12 giờ</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc ức chế bêta được dùng đường uống với liều 25-50 mg mỗi 6 – 12 giờ.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
