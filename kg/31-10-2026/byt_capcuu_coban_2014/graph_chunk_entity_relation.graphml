  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="đụng dập phổi">
  <data key="d0">đụng dập phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng xảy ra do chấn thương, có thể nhầm với mất máu hoặc sốc.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="nhồi máu cơ tim">
  <data key="d0">nhồi máu cơ tim</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng xảy ra do chấn thương hoặc mất máu, có thể nhầm với sốc.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="tắc mạch mỡ hoặc mạch hơi">
  <data key="d0">tắc mạch mỡ hoặc mạch hơi</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng xảy ra do chấn thương, có thể nhầm với mất máu hoặc sốc.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="tràn khí mạng phổi">
  <data key="d0">tràn khí mạng phổi</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là biến chứng xảy ra do chấn thương, có biểu hiện suy hô hấp và khí quản bị đẩy lệch.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="tụt huyết áp">
  <data key="d0">tụt huyết áp</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng xảy ra khi có mất máu hoặc chấn thương, biểu hiện bằng huyết áp hạ.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="tiếng tim mờ">
  <data key="d0">tiếng tim mờ</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng xuất hiện khi có sốc hoặc ép tim cấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="giảm tưới máu">
  <data key="d0">giảm tưới máu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng xảy ra trước khi có tụt huyết áp, phản ánh tình trạng thiếu máu nội tạng.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="sốc chấn thương">
  <data key="d0">sốc chấn thương</data>
  <data key="d1">benh</data>
  <data key="d2">Trạng thái bệnh lý xảy ra do chấn thương nặng, biểu hiện bằng suy giảm tuần hoàn và hô hấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="hồi phục thể tích lòng mạch">
  <data key="d0">hồi phục thể tích lòng mạch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật nhằm phục hồi thể tích máu trong mạch để duy trì huyết áp và tuần hoàn.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="thở oxy">
  <data key="d0">thở oxy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật cung cấp oxy cho cơ thể để hỗ trợ hô hấp trong tình trạng chấn thương nặng.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="cầm máu">
  <data key="d0">cầm máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật ngăn chặn chảy máu bằng cách băng ép, kẹp mạch hoặc sử dụng garô.&lt;SEP&gt;Là một kỹ thuật xử trí khi có chảy máu, áp dụng bằng cách ép trực tiếp vào động mạch hoặc dùng garô</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793021900</data>
  <data key="d6"></data>
</node>
<node id="nacl 0,9%">
  <data key="d0">nacl 0,9%</data>
  <data key="d1">thuoc</data>
  <data key="d2">Dịch truyền được sử dụng để bù dịch trong điều trị sốc chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="chế phẩm máu">
  <data key="d0">chế phẩm máu</data>
  <data key="d1">thuoc</data>
  <data key="d2">Chế phẩm máu được truyền để bù máu và các thành phần huyết tương trong trường hợp mất máu nặng.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
