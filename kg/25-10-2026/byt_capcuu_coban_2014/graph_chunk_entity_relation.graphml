  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="chẩn đoán" target="không đáp ứng với điều trị">
  <data key="d7">2.0</data>
  <data key="d8">Triệu chứng không đáp ứng với điều trị cũng góp phần định hướng chẩn đoán bệnh lý.&lt;SEP&gt;Không đáp ứng với điều trị được dùng để hỗ trợ định hướng chẩn đoán trong cấp cứu.</data>
