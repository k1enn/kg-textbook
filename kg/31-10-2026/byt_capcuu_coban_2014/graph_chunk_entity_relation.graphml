</node>
<node id="chấn thương xương">
  <data key="d0">chấn thương xương</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng tổn thương xương do va chạm hoặc tác động lực, có thể đi kèm với chấn thương mô mềm.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="chấn thương mô mềm">
  <data key="d0">chấn thương mô mềm</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng tổn thương mô mềm như cơ, dây chằng, và các tổ chức xung quanh xương do va chạm.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xương sườn">
  <data key="d0">xương sườn</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại gãy xương ở sườn, thường xảy ra do va chạm mạnh, có thể mất lượng máu từ 125 ml.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xương quay hoặc trụ">
  <data key="d0">xương quay hoặc trụ</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại gãy xương ở vùng quay hoặc trụ, có thể mất lượng máu từ 250 đến 500 ml.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
