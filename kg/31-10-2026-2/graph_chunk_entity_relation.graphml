  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là phản ứng dị ứng gây phù niêm mạc họng và khí quản khi bị ong đốt, kháng sinh hoặc các thuốc hạ huyết áp</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
