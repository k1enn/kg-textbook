  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="Điều trị tái tưới máu">
  <data key="d0">Điều trị tái tưới máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương pháp điều trị nhằm phục hồi dòng máu đến cơ tim trong trường hợp nhồi máu cơ tim cấp.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
