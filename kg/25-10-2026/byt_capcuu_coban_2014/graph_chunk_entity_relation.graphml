<node id="sơ đồ cây chẩn đoán">
  <data key="d0">sơ đồ cây chẩn đoán</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một phương pháp được sử dụng để tìm chẩn đoán trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="đáp ứng với điều trị">
  <data key="d0">đáp ứng với điều trị</data>
  <data key="d1">tri_tue</data>
  <data key="d2">Là dấu hiệu cho thấy bệnh nhân phản ứng tích cực với liệu pháp điều trị đang được áp dụng.&lt;SEP&gt;Một dấu hiệu được sử dụng để hỗ trợ định hướng chẩn đoán trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="không đáp ứng với điều trị">
  <data key="d0">không đáp ứng với điều trị</data>
  <data key="d1">tri_tue</data>
  <data key="d2">Là dấu hiệu cho thấy bệnh nhân không phản ứng với liệu pháp điều trị đang được áp dụng.&lt;SEP&gt;Một dấu hiệu được sử dụng để hỗ trợ định hướng chẩn đoán trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="định hướng chuyển">
  <data key="d0">định hướng chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định về việc bệnh nhân sẽ được nhập viện, ra viện hoặc lưu theo dõi tại khoa cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nhập viện">
  <data key="d0">nhập viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định đưa bệnh nhân vào một khoa bệnh viện để tiếp tục điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="ra viện">
  <data key="d0">ra viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định cho phép bệnh nhân rời khỏi khoa cấp cứu và trở về nhà sau khi điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="lưu theo dõi">
  <data key="d0">lưu theo dõi</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định để bệnh nhân được giữ lại tại khoa cấp cứu để theo dõi trong thời gian chưa có quyết định rõ ràng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="quy trình, hướng dẫn xử trí, điều trị cấp cứu">
  <data key="d0">quy trình, hướng dẫn xử trí, điều trị cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các quy trình chuẩn bị và hướng dẫn được áp dụng để xử trí và điều trị bệnh nhân cấp cứu một cách hiệu quả.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="thời gian vàng trong cấp cứu">
  <data key="d0">thời gian vàng trong cấp cứu</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian nhất định trong đó can thiệp điều trị cần được thực hiện để cải thiện tiên lượng bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="ngừng tuần hoàn (NTH)">
  <data key="d0">ngừng tuần hoàn (NTH)</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý xảy ra khi tim ngừng đập, cần can thiệp ngay lập tức để cứu sống bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="sốc điện">
  <data key="d0">sốc điện</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tình trạng bệnh lý xảy ra khi có hiện tượng loạn nhịp tim nghiêm trọng, cần can thiệp ngay lập tức.&lt;SEP&gt;Là một phương pháp can thiệp bằng điện để phục hồi nhịp tim ngừng ở bệnh nhân bị ngừng tuần hoàn.&lt;SEP&gt;Thủ thuật cấp cứu phá rung thất có hiệu quả nhất khi thực hiện trong vòng 5 phút đầu sau ngừng tim.&lt;SEP&gt;Thủ thuật được thực hiện khi có chỉ định để phục hồi nhịp tim.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1792918589</data>
  <data key="d6"></data>
</node>
<node id="hội chứng động mạch vành cấp">
  <data key="d0">hội chứng động mạch vành cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý xảy ra do tắc mạch vành, cần điều trị sớm trong thời gian nhất định.&lt;SEP&gt;Một tình trạng bệnh lý xảy ra do tắc mạch máu vành, có cửa sổ thời gian dùng thuốc tiêu sợi huyết là 12 giờ đối với bệnh nhân có ST chênh lên.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="tắc m">
  <data key="d0">tắc m</data>
  <data key="d1">khac</data>
  <data key="d2">Là phần chưa hoàn chỉnh của văn bản, không thể xác định rõ nội dung cụ thể.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="điện sớm trong vòng 3 đến 5 phút đầu tiên sau khi">
  <data key="d0">điện sớm trong vòng 3 đến 5 phút đầu tiên sau khi</data>
  <data key="d1">khac</data>
  <data key="d2">Một hiện tượng điện sinh lý xảy ra trong vòng 3 đến 5 phút đầu tiên sau khi xảy ra sự cố, có thể đạt tỷ lệ cứu sống từ 50% đến 75%.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="tắc mạch não">
  <data key="d0">tắc mạch não</data>
  <data key="d1">benh</data>
  <data key="d2">Một tình trạng bệnh lý do tắc mạch máu não, có cửa sổ thời gian dùng thuốc tiêu sợi huyết (Alteplase) là 3 giờ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="sốc nhiễm khuẩn/nhiễm khuẩn nặng">
  <data key="d0">sốc nhiễm khuẩn/nhiễm khuẩn nặng</data>
  <data key="d1">benh</data>
  <data key="d2">Một tình trạng bệnh lý do nhiễm khuẩn nặng, cần dùng kháng sinh đường tiêm trong vòng 1 giờ và điều trị tích cực trong 6 giờ đầu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="vết thương động mạch/ga rô mạch">
  <data key="d0">vết thương động mạch/ga rô mạch</data>
  <data key="d1">benh</data>
  <data key="d2">Một tình trạng bệnh lý do tổn thương động mạch hoặc ga rô mạch, cần can thiệp lập lại tưới máu trong vòng 6 giờ, nếu muộn hơn thì nguy cơ phải cắt cụt rất cao.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="thuốc tiêu sợi huyết">
  <data key="d0">thuốc tiêu sợi huyết</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc dùng để ngăn ngừa tắc mạch trong các tình trạng bệnh lý như hội chứng động mạch vành cấp và tắc mạch não.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Alteplase">
  <data key="d0">Alteplase</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc tiêu sợi huyết được dùng trong điều trị tắc mạch não với cửa sổ thời gian là 3 giờ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="kháng sinh đường tiêm">
  <data key="d0">kháng sinh đường tiêm</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc được dùng đường tiêm để điều trị súc nhiễm khuẩn/nhiễm khuẩn nặng trong vòng 1 giờ đầu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="chẩn đoán trước đó">
  <data key="d0">chẩn đoán trước đó</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Một tình trạng trong đó chẩn đoán ban đầu có thể ảnh hưởng đến kết quả chẩn đoán chính xác, gây rào cản lớn trong việc xác định chẩn đoán đúng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="suy nghĩ của người khác">
  <data key="d0">suy nghĩ của người khác</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Một yếu tố làm nhiễu chẩn đoán do bị ảnh hưởng bởi suy nghĩ hoặc quan điểm của người khác trong đội ngũ y tế.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="dấu hiệu sống">
  <data key="d0">dấu hiệu sống</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Một dấu hiệu lâm sàng cần được theo dõi để đánh giá tình trạng sinh tồn của bệnh nhân trong quá trình điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="ghi chép của tuyến trước">
  <data key="d0">ghi chép của tuyến trước</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Các ghi chép từ đội ngũ y tế trước đó được dùng để hỗ trợ hoặc kiểm tra lại chẩn đoán hiện tại.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="ghi chép của y tá">
  <data key="d0">ghi chép của y tá</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Các ghi chép do y tá thực hiện, được dùng làm thông tin tham khảo trong quá trình chẩn đoán và điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="gập hồ sơ vào quá sớm">
  <data key="d0">gập hồ sơ vào quá sớm</data>
  <data key="d1">khac</data>
  <data key="d2">Hành vi không nên thực hiện khi chưa có chẩn đoán rõ ràng, cần đưa bệnh nhân vào danh sách chưa có chẩn đoán hoặc chẩn đoán chưa rõ ràng và có cảnh báo, theo dõi thích hợp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="thời điểm nguy cơ cao">
  <data key="d0">thời điểm nguy cơ cao</data>
  <data key="d1">khac</data>
  <data key="d2">Các thời điểm như khi bệnh nhân ký để ra sớm, đông bệnh nhân, giờ cao điểm hoặc thời điểm mệt mỏi có nguy cơ cao dẫn đến sai lầm trong chẩn đoán.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nhóm bệnh nhân nguy cơ cao">
  <data key="d0">nhóm bệnh nhân nguy cơ cao</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhóm bệnh nhân có các yếu tố như lang thang, nghiện rượu, nghiện thuốc, bạo lực, bị lạm dụng, rối loạn tâm thần, cần được thận trọng khi điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân quay lại">
  <data key="d0">bệnh nhân quay lại</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Bệnh nhân có thể có vấn đề cấp cứu chưa được phát hiện hoặc xử trí đúng trong lần cấp cứu trước, là cơ hội để sửa chữa sai sót hoặc bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nhồi máu cơ tim cấp">
  <data key="d0">nhồi máu cơ tim cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Một tình trạng bệnh lý cần được nghĩ đến và loại trừ trước trong các chẩn đoán quan trọng có nguy cơ cấp cứu cao.&lt;SEP&gt;Là hậu quả của tắc đột ngột động mạch vành và có thể dẫn đến các biến chứng nặng như suy tim, rối loạn nhịp tim.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="tắc động mạch phổi">
  <data key="d0">tắc động mạch phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Một tình trạng bệnh lý cần được nghĩ đến và loại trừ trước trong các chẩn đoán quan trọng có nguy cơ cấp cứu cao.&lt;SEP&gt;Là bệnh lý cần chẩn đoán phân biệt với nhồi máu cơ tim cấp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
