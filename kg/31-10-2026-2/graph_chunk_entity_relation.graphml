  <data key="d0">triệu chứng sốc</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng sốc không kiểm soát được trong bệnh nhân dập vỡ động mạch chủ.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
