<node id="mặt nạ">
  <data key="d0">mặt nạ</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d2">Thủ thuật này được thực hiện qua mặt nạ mũi, miệng hoặc toàn bộ mặt cho bệnh nhân.</data>
