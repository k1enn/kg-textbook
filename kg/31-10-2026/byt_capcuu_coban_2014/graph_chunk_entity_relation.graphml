  <data key="d1">doi_tuong</data>
  <data key="d2">Là một nhóm người bệnh cần được chẩn đoán loại trừ các nguyên nhân do tổn thương cấu trúc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-003</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
