  <data key="d0">noradrenaline</data>
  <data key="d1">thuoc</data>
  <data key="d2">thuốc được dùng trong liều 0,05-0,5 mcg/kg/phút để hỗ trợ tim và mạch&lt;SEP&gt;Một loại thuốc được dùng để điều trị tụt huyết áp do giãn mạch giảm trương lực thành mạch.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-004&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
