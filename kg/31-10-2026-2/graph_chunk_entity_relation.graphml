</node>
<node id="màng phổi">
  <data key="d0">màng phổi</data>
  <data key="d1">khac</data>
  <data key="d2">Là một lớp màng bao bọc bên trong cơ thể, được đề cập trong bối cảnh hội chứng khoang liên quan đến chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
