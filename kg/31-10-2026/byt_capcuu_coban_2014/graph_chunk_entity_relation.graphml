  <data key="d1">benh</data>
  <data key="d2">Là chấn thương xương sườn ở các đốt từ 7 đến 9, thường do va chạm mạnh.</data>
  <data key="d3">11-cap-cuu-chan-thuong-bung-chunk-001</data>
