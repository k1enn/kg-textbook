  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng cho thấy tình trạng tuần hoàn và hô hấp của bệnh nhân đã ổn định sau khi loại trừ dị vật.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="trẻ nhỏ">
  <data key="d0">trẻ nhỏ</data>
  <data key="d1">khac</data>
  <data key="d2">Nhóm trẻ nhỏ do lỗ mũi nhỏ nên không được sử dụng canuyn mũi hầu&lt;SEP&gt;Nghiệm pháp Heimlich có thể gây chấn thương bụng khi dùng cho trẻ nhỏ.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
