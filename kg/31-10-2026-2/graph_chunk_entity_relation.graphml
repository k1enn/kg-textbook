  <data key="d1">khac</data>
  <data key="d2">Các phương pháp thăm dò, xét nghiệm được sử dụng để loại trừ hoặc khẳng định chẩn đoán</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-008</data>
