  <data key="d0">hầu thanh quản</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân nội sinh gây tắc nghẽn đường thở do phù thanh quản hoặc co thắt thanh quản.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-000</data>
