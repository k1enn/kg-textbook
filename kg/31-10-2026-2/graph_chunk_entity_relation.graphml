<node id="canuyn mũi">
  <data key="d0">canuyn mũi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Dụng cụ thở mũi với dòng oxy thấp 1-5 l/phút, nồng độ oxy 24%-48%</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-006</data>
