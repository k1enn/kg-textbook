  <data key="d0">fibrinogen</data>
  <data key="d1">chi_so</data>
  <data key="d2">là một chỉ số sinh học phản ánh mức độ đông máu trong máu</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
