<node id="tiền gánh thất trái">
  <data key="d0">tiền gánh thất trái</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là một tình trạng chức năng tim bị suy giảm do áp lực mạch phổi tăng cao.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-003</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
