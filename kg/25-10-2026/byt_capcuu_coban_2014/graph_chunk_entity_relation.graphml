  <data key="d1">thuoc</data>
  <data key="d2">Một nhóm thuốc được sử dụng trong quá trình xử trí tình trạng vô tâm thu, bao gồm adrenalin và atropin.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
