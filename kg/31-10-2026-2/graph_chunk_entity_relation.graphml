  <data key="d0">nằm ngửa, đùi gấp</data>
  <data key="d1">khac</data>
  <data key="d2">Tư thế nằm ngửa, đùi gấp có tác dụng làm lỏng cơ bụng để giảm đau bụng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tư thế sản khoa">
  <data key="d0">tư thế sản khoa</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là tư thế nằm nghiêng an toàn sang trái áp dụng cho bệnh nhân mang thai trên 7 tháng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
