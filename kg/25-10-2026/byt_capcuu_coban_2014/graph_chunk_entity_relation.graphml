  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="Tái tưới máu bằng thuốc tiêu sợi huyết">
  <data key="d0">Tái tưới máu bằng thuốc tiêu sợi huyết</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương pháp điều trị bằng thuốc tiêu sợi huyết khi không thể can thiệp mạch vành trong vòng 120 phút.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="aPTT bệnh/chứng = 1,5 – 2,0">
  <data key="d0">aPTT bệnh/chứng = 1,5 – 2,0</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số ngưỡng được dùng để duy trì khi điều trị bằng heparin không phân đoạn.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
