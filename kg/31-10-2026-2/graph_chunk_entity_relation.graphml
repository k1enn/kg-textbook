<node id="sử dụng các thuốc vận mạch">
  <data key="d0">sử dụng các thuốc vận mạch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật sử dụng thuốc vận mạch để nâng huyết áp sau khi bù dịch</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
