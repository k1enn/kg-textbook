  <data key="d0">nối chi</data>
  <data key="d1">khac</data>
  <data key="d2">Hội chẩn chuyên khoa ngoại chấn thương bao gồm kỹ thuật nối chi trong xử trí chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
<node id="mỏm cụt">
  <data key="d0">mỏm cụt</data>
  <data key="d1">khac</data>
  <data key="d2">Kỹ thuật cắt lọc được thực hiện khi mỏm cụt bị bẩn hoặc dập nát nhiều để đảm bảo an toàn phẫu thuật.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
<node id="chi thể đứt rời">
  <data key="d0">chi thể đứt rời</data>
  <data key="d1">khac</data>
  <data key="d2">Phần chi thể đứt rời được bỏ vào túi nilon sạch và dán kín để bảo quản tốt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
<node id="vết thương cắt cụt không hoàn toàn">
  <data key="d0">vết thương cắt cụt không hoàn toàn</data>
  <data key="d1">khac</data>
  <data key="d2">Kỹ thuật cầm máu bằng băng ép hoặc garo được áp dụng trong vết thương cắt cụt không hoàn toàn.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
<node id="bỏng do nóng">
  <data key="d0">bỏng do nóng</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng khi bệnh nhân tiếp xúc với dụng cụ chứa chất nóng bị vỡ, chất lỏng nóng, vật dụng nóng hoặc hơi nóng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng do lạnh">
  <data key="d0">bỏng do lạnh</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng do tiếp xúc với băng đá làm tổn thương tế bào.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng do hóa chất">
  <data key="d0">bỏng do hóa chất</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng khi bệnh nhân tiếp xúc với các hóa chất như acid, kiềm mạch, iod hoặc phospho dùng trong công nghiệp vôi tôi.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng do điện">
  <data key="d0">bỏng do điện</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng do điện giật hoặc sét đánh.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng do hít">
  <data key="d0">bỏng do hít</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng khi bệnh nhân hít phải các hơi máy hoặc xảy ra trong các vụ nổ.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng do phóng xạ">
  <data key="d0">bỏng do phóng xạ</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng do năng lượng phóng xạ hoặc các tia phóng xạ, thường gặp là bỏng mặt trời.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="đánh giá tình trạng nguy kịch">
  <data key="d0">đánh giá tình trạng nguy kịch</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quá trình đánh giá các dấu hiệu nguy kịch của bệnh nhân bị bỏng ảnh hưởng đến tính mạng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="đánh giá tổn thương bỏng">
  <data key="d0">đánh giá tổn thương bỏng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là bước đánh giá mức độ tổn thương da và mô do bỏng gây ra.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="sơ cứu">
  <data key="d0">sơ cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các biện pháp ban đầu nhằm hỗ trợ bệnh nhân bị bỏng trước khi đưa đến phòng cấp cứu.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="phân độ nặng">
  <data key="d0">phân độ nặng</data>
  <data key="d1">khac</data>
  <data key="d2">Đánh giá tổn thương bỏng là bước chẩn đoán để xác định mức độ nặng của bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="ng gây ra">
  <data key="d0">ng gây ra</data>
  <data key="d1">khac</data>
  <data key="d2">Là yếu tố gây ra các triệu chứng và biến chứng trong chấn thương do bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="đầu">
  <data key="d0">đầu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng ở vùng đầu, chiếm 9% tổng diện tích bỏng theo tiêu chí của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="thân mình">
  <data key="d0">thân mình</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng ở vùng thân mình, chiếm trước 18% và sau 18% theo tiêu chí của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="chi trên">
  <data key="d0">chi trên</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng ở chi trên, chiếm 9% tổng diện tích bỏng theo tiêu chí của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="chi dưới">
  <data key="d0">chi dưới</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng ở chi dưới, chiếm 18% tổng diện tích bỏng theo tiêu chí của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bộ phận sinh dục ngoài">
  <data key="d0">bộ phận sinh dục ngoài</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng ở bộ phận sinh dục ngoài, chiếm 1% tổng diện tích bỏng theo tiêu chí của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="độ 1">
  <data key="d0">độ 1</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng có biểu hiện da đỏ, đau, do kích thích đầu mút dây thần kinh, thường lành sau 3 ngày.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="độ 2a">
  <data key="d0">độ 2a</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng nông, lan rộng, đau nhiều, rỉ nước, có hiện tượng phỏng nước trên bề mặt vết bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="độ 2b">
  <data key="d0">độ 2b</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng sâu, đau ít hơn độ 2a, có vùng tê, da dính chặt, ấn kính dương, sẹo hình thành trong 3 tuần, có thể sẹo sâu hoặc sẹo lồi xấu.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="độ 3">
  <data key="d0">độ 3</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng có vùng da trắng bóng, đỏ tươi hoặc nâu, không đau, da bám chặt, cần ghép da để điều trị.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng hóa chất">
  <data key="d0">bỏng hóa chất</data>
  <data key="d1">benh</data>
  <data key="d2">Là một loại bỏng do tiếp xúc với hóa chất.&lt;SEP&gt;Nguyên nhân gây bỏng do tiếp xúc với hóa chất, tiên lượng phụ thuộc vào việc rửa sớm và cần chuyển nạn nhân đến chuyên khoa mắt nếu bị bỏng mắt.&lt;SEP&gt;Là tình trạng tổn thương do tiếp xúc với các hóa chất như acid, kiềm, phospho hoặc vôi nước tôi.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="wallace">
  <data key="d0">wallace</data>
  <data key="d1">khac</data>
  <data key="d2">Tiêu chí dùng để đánh giá độ nặng của vùng bỏng theo tỷ lệ diện tích cơ thể bị tổn thương.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="rửa sớm">
  <data key="d0">rửa sớm</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật được thực hiện ngay sau khi bị bỏng hóa chất để giảm tổn thương và cải thiện tiên lượng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="chuyên ngành mắt">
  <data key="d0">chuyên ngành mắt</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Đối tượng chuyên môn được chuyển đến khi bị bỏng mắt do hóa chất, cần điều trị tại chuyên khoa mắt.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng điện">
  <data key="d0">bỏng điện</data>
  <data key="d1">benh</data>
  <data key="d2">Là một loại bỏng do tiếp xúc với điện.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="albumin 5%">
  <data key="d0">albumin 5%</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại dịch truyền dùng trong điều trị mất nước do bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
