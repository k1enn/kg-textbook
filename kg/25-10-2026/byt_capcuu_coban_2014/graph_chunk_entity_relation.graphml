  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d2">Nguy kịch (khẩn cấp) là một dạng bệnh lý nghiêm trọng hơn so với cấp cứu (emergency) vì đe dọa tính mạng nhanh chóng nếu không can thiệp ngay.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
