  <data key="d1">benh</data>
  <data key="d2">Là bệnh do tổn thương màng phế nang mao mạch.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ARDS">
  <data key="d0">ARDS</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh do tổn thương màng phế nang mao mạch.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Viêm phổi">
  <data key="d0">Viêm phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh làm tăng nguy cơ cần dùng mặt nạ không thở lại.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="SpO2 &gt; 90%">
  <data key="d0">SpO2 &gt; 90%</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là ngưỡng đảm bảo ô xy hóa máu trong điều trị.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Dòng ô xy thấp">
  <data key="d0">Dòng ô xy thấp</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là dòng ô xy được sử dụng trong canuyn mũi và mặt nạ không thở lại.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Tổn thương màng phế nang mao mạch">
  <data key="d0">Tổn thương màng phế nang mao mạch</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến suy hô hấp nặng trong các dụng cụ thở.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Mặt nạ">
  <data key="d0">Mặt nạ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là dụng cụ tạo dòng ô xy được sử dụng trong thông khí nhân tạo.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="nồng độ ô xy từ 24%- 50%">
  <data key="d0">nồng độ ô xy từ 24%- 50%</data>
  <data key="d1">chi_so</data>
  <data key="d2">Giá trị nồng độ oxy được sử dụng trong điều trị cho bệnh nhân COPD cần độ chính xác cao.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thông khí nhân tạo">
  <data key="d0">thông khí nhân tạo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật hỗ trợ hô hấp cho bệnh nhân khi có suy hô hấp nặng hoặc đột biến.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thông khí nhân tạo không xâm nhập áp lực dương">
  <data key="d0">thông khí nhân tạo không xâm nhập áp lực dương</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật hỗ trợ thông khí qua mặt nạ mũi, miệng hoặc toàn bộ mặt cho bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp do phù phổi cấp huyết động">
  <data key="d0">suy hô hấp do phù phổi cấp huyết động</data>
  <data key="d1">benh</data>
  <data key="d2">Bệnh lý hô hấp cấp do phù phổi gây ra, thường xảy ra trong tình trạng đột ngột và nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="đợt cấp của COPD">
  <data key="d0">đợt cấp của COPD</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Tình trạng cấp tính của bệnh COPD, cần điều trị bằng thuốc giãn phế quản và hỗ trợ hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="HFQ">
  <data key="d0">HFQ</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng suy tim do giảm chức năng tim, có thể cần thông khí nhân tạo hỗ trợ.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thở gắng sức">
  <data key="d0">thở gắng sức</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng mệt cơ khi bệnh nhân thở không đủ, thường xuất hiện trong suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="TS thở &gt; 30/min">
  <data key="d0">TS thở &gt; 30/min</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số đo tốc độ thở vượt quá 30 lần mỗi phút, là dấu hiệu của suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="toan hô hấp cấp">
  <data key="d0">toan hô hấp cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng rối loạn pH máu do suy hô hấp, với pH dưới 7,25-7,30.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tỷ lệ PaO2/FiO2 &lt; 200">
  <data key="d0">tỷ lệ PaO2/FiO2 &lt; 200</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số đánh giá tình trạng oxy hóa máu, dưới ngưỡng 200 cho thấy tình trạng xấu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thuốc giãn phế quản">
  <data key="d0">thuốc giãn phế quản</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng để giãn phế quản, chỉ định cho COPD và hen phế quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="chất chủ vận β2">
  <data key="d0">chất chủ vận β2</data>
  <data key="d1">thuoc</data>
  <data key="d2">Loại thuốc giãn phế quản có tác dụng chủ yếu trên cơ phế quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thuốc kháng cholinergic">
  <data key="d0">thuốc kháng cholinergic</data>
  <data key="d1">thuoc</data>
  <data key="d2">Loại thuốc hỗ trợ giãn phế quản, thường dùng phối hợp với chất chủ vận β2.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="corticoid">
  <data key="d0">corticoid</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng trong điều trị các đợt cấp của hen phế quản và COPD.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="kháng sinh">
  <data key="d0">kháng sinh</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng khi có dấu hiệu viêm phổi hoặc nhiễm khuẩn trong đợt cấp COPD.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="lợi tiểu">
  <data key="d0">lợi tiểu</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng để giảm ứ tích máu và phù phổi trong suy tim và quá tải thể tích.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="mất khả năng bào vệ đường thở">
  <data key="d0">mất khả năng bào vệ đường thở</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Yếu tố nguy cơ làm giảm khả năng bảo vệ đường thở, làm tăng nguy cơ nhiễm trùng hoặc tắc đường thở.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="đờm dãi quá nhiều">
  <data key="d0">đờm dãi quá nhiều</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Tình trạng tiết đờm nhiều làm ảnh hưởng đến khả năng thở và sử dụng mặt nạ thông khí.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="vật vã hay không hợp tác">
  <data key="d0">vật vã hay không hợp tác</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Tình trạng bệnh nhân không hợp tác hoặc vật vã làm khó khăn trong việc đặt và sử dụng mặt nạ thông khí.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tình trạng bệnh nhân không cho phép đặt mặt nạ">
  <data key="d0">tình trạng bệnh nhân không cho phép đặt mặt nạ</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Điều kiện không cho phép đặt mặt nạ, làm chống chỉ định với thông khí nhân tạo không xâm nhập.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp nặng">
  <data key="d0">suy hô hấp nặng</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d2">Tím là biểu hiện của suy hô hấp nặng, xuất hiện khi Hb khử &gt; 5g/dL.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="giảm ô xy máu">
  <data key="d0">giảm ô xy máu</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d2">Triệu chứng giảm ô xy máu là đặc điểm lâm sàng của hô hấp hỗn hợp.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tăng CO2">
  <data key="d0">tăng CO2</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d2">Tăng CO2 trong máu là một dấu hiệu lâm sàng của hô hấp hỗn hợp.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ho khạc đờm tăng">
  <data key="d0">ho khạc đờm tăng</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d2">Bệnh phổi tắc nghẽn mạn tính là yếu tố nguy cơ gây ho khạc đờm tăng.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ho khạc đờm đục">
  <data key="d0">ho khạc đờm đục</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d2">Ho khạc đờm đục là triệu chứng lâm sàng của viêm phổi.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp giảm ô xy máu">
  <data key="d0">suy hô hấp giảm ô xy máu</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d2">Suy hô hấp giảm ô xy máu là biến chứng do tổn thương não do chấn thương khi có sặc phổi hoặc bệnh phổi mạn.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
