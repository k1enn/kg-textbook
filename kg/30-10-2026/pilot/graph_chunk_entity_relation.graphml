</edge>
<edge source="hội chứng động mạch vành cấp" target="thời gian vàng">
  <data key="d7">1.0</data>
  <data key="d8">Thời gian cửa sổ cho dùng thuốc tiêu sợi huyết là 12 giờ, là một phần của thời gian vàng trong điều trị.</data>
  <data key="d9">can thiệp,nguong_cua</data>
