  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật được thực hiện để loại bỏ chất độc khỏi dạ dày trong thời gian sớm sau khi tiếp xúc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
