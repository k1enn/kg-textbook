  <data key="d0">khoa thăm dò chức năng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là các khoa chuyên môn được sử dụng để tiếp nhận bệnh nhân sau khi được vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="phòng can thiệp">
  <data key="d0">phòng can thiệp</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là các phòng chuyên khoa được sử dụng để tiếp nhận bệnh nhân trong quá trình vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
