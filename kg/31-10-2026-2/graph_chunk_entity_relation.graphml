  <data key="d0">bí đái do mất phản xạ bàng quang</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Biến chứng xảy ra do mất phản xạ bàng quang trong các hội chứng tổn thương tủy sống.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="hội chứng đuôi ngựa">
  <data key="d0">hội chứng đuôi ngựa</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng do tổn thương các rễ thần kinh xuất phát từ cột sống thắt lưng, gây liệt vận động và mất cảm giác hai chi dưới.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
