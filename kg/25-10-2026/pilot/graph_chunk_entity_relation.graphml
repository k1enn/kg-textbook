  <data key="d0">rối loạn toan/kiềm máu nặng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng mất cân bằng pH máu do rối loạn chuyển hóa hoặc hô hấp nặng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="rối loạn kali máu">
  <data key="d0">rối loạn kali máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng nồng độ kali trong máu không ổn định, ảnh hưởng đến chức năng cơ và tim.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="hạ đường máu">
  <data key="d0">hạ đường máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng nồng độ đường huyết thấp, có thể gây nguy hiểm đến chức năng thần kinh và tim.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="tiền sử">
  <data key="d0">tiền sử</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thông tin về lịch sử bệnh lý hoặc điều kiện sức khỏe trước đó của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="bệnh sử">
  <data key="d0">bệnh sử</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thông tin chi tiết về các bệnh lý đã từng mắc của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
