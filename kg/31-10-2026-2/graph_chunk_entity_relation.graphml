  <data key="d1">thu_thuat</data>
  <data key="d2">Các phương pháp chẩn đoán chuyên sâu được sử dụng tại bệnh viện đích để đánh giá tình trạng bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
