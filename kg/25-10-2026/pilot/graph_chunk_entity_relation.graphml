  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="phù phổi cấp" target="ngồi thõng chân">
  <data key="d7">2.0</data>
  <data key="d8">Bệnh nhân có phù phổi cấp được đặt trong tư thế ngồi thõng chân.&lt;SEP&gt;Tư thế ngồi thõng chân được dùng cho bệnh nhân có phù phổi cấp.</data>
  <data key="d9">doi_tuong_cua,phù phổi cấp</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="ép bụng" target="nghiệm pháp Heimlich">
  <data key="d7">1.0</data>
  <data key="d8">Nghiệm pháp Heimlich là một kỹ thuật tương tự như ép bụng để xử trí tắc nghẽn đường thở.</data>
  <data key="d9">phan_biet_voi,ép bụng</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="đứng sau bệnh nhân" target="dùng cánh tay ôm eo bệnh nhân">
  <data key="d7">1.0</data>
  <data key="d8">Khi bệnh nhân đang ngồi hoặc đứng, người thực hiện dùng cánh tay ôm eo bệnh nhân để thực hiện thủ thuật Heimlich.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="một bàn tay nắm lại" target="ngón cái ở trên đường giữa">
  <data key="d7">1.0</data>
  <data key="d8">Việc đặt ngón cái ở trên đường giữa là một phần của thao tác dùng một bàn tay nắm lại để tạo lực ép.</data>
  <data key="d9">chan_doan_bang</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="đặt lên bụng hơi trên rốn" target="bàn tay kia ôm lên bàn tay đã nắm">
  <data key="d7">1.0</data>
  <data key="d8">Việc đặt tay lên bụng hơi trên rốn được thực hiện đồng thời với việc ôm bàn tay đã nắm để tạo lực ép.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="dùng động tác giật (để ép) lên trên và ra sau" target="lặp lại động tác tới khi giải phóng được tắc nghẽn">
  <data key="d7">1.0</data>
  <data key="d8">Động tác giật được lặp lại để giải phóng tắc nghẽn đường thở trong thủ thuật Heimlich.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="đặt bệnh nhân nằm ngửa" target="mặt ngửa lên trên">
  <data key="d7">1.0</data>
  <data key="d8">Khi bệnh nhân hôn mê, việc đặt bệnh nhân nằm ngửa giúp mặt hướng lên trên để dễ thực hiện thủ thuật Heimlich.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="nôn để đầu bệnh nhân nghiêng một bên" target="lau miệng">
  <data key="d7">1.0</data>
  <data key="d8">Việc nghiêng đầu bệnh nhân khi nôn đi kèm với thao tác lau miệng để đảm bảo đường thở sạch.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="người cấp cứu quỳ gối ở hai bên hông bệnh nhân" target="đặt một cùi bàn tay lên bụng ở giữa rốn và mũi ức">
  <data key="d7">1.0</data>
  <data key="d8">Khi bệnh nhân hôn mê, người cấp cứu quỳ gối ở hai bên hông để thực hiện việc đặt cùi bàn tay lên bụng.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="bàn tay kia úp lên trên, đưa người ra phía trước ép nhanh lên phía trên" target="làm lại nếu cần">
  <data key="d7">1.0</data>
  <data key="d8">Sau khi thực hiện ép nhanh, nếu chưa giải phóng tắc nghẽn thì sẽ làm lại thủ thuật Heimlich.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="quỳ gối ở một bên cạnh hông bệnh nhân" target="dùng tay ép như trên">
  <data key="d7">1.0</data>
  <data key="d8">Khi chỉ có một người cấp cứu, người đó quỳ gối ở một bên để dễ di chuyển và dùng tay ép như đã mô tả.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="một người hô hấp nhân tạo và ép tim" target="một người làm nghiệm pháp">
  <data key="d7">1.0</data>
  <data key="d8">Trong hai người cấp cứu, một người thực hiện hô hấp nhân tạo và ép tim, một người thực hiện nghiệm pháp để hỗ trợ.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="tự ép bụng bằng cách ấn nắm tay lên bụng" target="ép bụng vào các bề mặt chắc như bồn rửa, lưng ghế, mặt bàn">
  <data key="d7">1.0</data>
  <data key="d8">Khi chỉ có một mình nạn nhân, việc tự ép bụng có thể thực hiện bằng cách ấn tay lên bụng hoặc ép vào bề mặt chắc.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="Sau mỗi đợt ép bụng" target="dùng 2 đến 3 ngón tay để móc khoang miệng">
  <data key="d7">1.0</data>
  <data key="d8">Sau mỗi đợt ép bụng, cần dùng 2 đến 3 ngón tay để móc khoang miệng kiểm tra đường thở.</data>
  <data key="d9">nguong_cua</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="dùng 2 đến 3 ngón tay để móc khoang miệng" target="hô hấp lại cho bệnh nhân">
  <data key="d7">1.0</data>
  <data key="d8">Sau khi móc khoang miệng và kiểm tra, nếu có dị vật thì cần hô hấp lại cho bệnh nhân.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="kiểm tra đường thở" target="hô hấp nhân tạo">
  <data key="d7">1.0</data>
  <data key="d8">Sau khi kiểm tra đường thở, nếu không thể hô hấp được thì cần thực hiện hô hấp nhân tạo cho bệnh nhân.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="kiểm tra đường thở" target="đánh giá hiệu quả">
  <data key="d7">1.0</data>
  <data key="d8">Kiểm tra đường thở là bước đánh giá để xác định hiệu quả của các động tác xử lý.</data>
  <data key="d9">nguong_cua</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="vỗ lưng và ép ngực" target="đặt trẻ nhỏ nằm trên tay tư thế sấp">
  <data key="d7">1.0</data>
  <data key="d8">Khi thực hiện kỹ thuật vỗ lưng và ép ngực, trẻ nhỏ cần được đặt nằm trên tay tư thế sấp dọc theo trục tay.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="đặt Canuyn hầu" target="duy trì sự thông thoáng của đường thở">
  <data key="d7">1.0</data>
  <data key="d8">Việc đặt Canuyn hầu giúp ngăn ngừa tắc nghẽn đường thở trong quá trình điều trị.</data>
  <data key="d9">phong_ngua</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
<edge source="đặt Canuyn hầu" target="hút đờm dãi dễ dàng hơn">
  <data key="d7">1.0</data>
  <data key="d8">Việc đặt Canuyn hầu giúp giảm khó khăn trong việc hút đờm và dãi của bệnh nhân.</data>
  <data key="d9">phong_ngua</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792917436</data>
  <data key="d13"></data>
</edge>
