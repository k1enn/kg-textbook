  <data key="d1">xet_nghiem</data>
  <data key="d2">Các hình ảnh được thực hiện để đánh giá tình trạng chấn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="hội chẩn với chuyên khoa ngoại chấn thương">
  <data key="d0">hội chẩn với chuyên khoa ngoại chấn thương</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Việc phối hợp với chuyên khoa ngoại chấn thương để xử trí bệnh nhân chấn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="methylprednisolone">
  <data key="d0">methylprednisolone</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc corticoid được dùng với liều lượng 30mg/kg/15ph và duy trì trong 8 giờ đầu.&lt;SEP&gt;Là thuốc được sử dụng với liều bolus 30mg/kg/15ph và duy trì 5,4 mg/kg/h trong 23 giờ.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-006</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="mất máu nặng">
  <data key="d0">mất máu nặng</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân dẫn đến cần truyền máu và các chế phẩm máu trong trường hợp chấn thương nặng.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="phù nề tủy sống">
  <data key="d0">phù nề tủy sống</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Biến chứng xảy ra do giảm tưới máu hoặc do sử dụng thuốc không phù hợp trong chấn thương cột sống.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="tình trạng phù nề tủy sống">
  <data key="d0">tình trạng phù nề tủy sống</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Biến chứng xảy ra do giảm tưới máu hoặc do dùng corticoid liều cao trong 8 giờ đầu sau chấn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="icoid">
  <data key="d0">icoid</data>
  <data key="d1">khac</data>
  <data key="d2">Là một chất có thể giúp làm giảm tình trạng phù nề tủy sống khi dùng liều cao trong 8 giờ đầu.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-006</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="nẹp cổ">
  <data key="d0">nẹp cổ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương tiện cố định cột sống cổ, được sử dụng trong các trường hợp chấn thương và cần chọn cỡ phù hợp.&lt;SEP&gt;Một thủ thuật được sử dụng khi nghi ngờ có chấn thương cột sống cổ.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="cáng cứng">
  <data key="d0">cáng cứng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương tiện vận chuyển bệnh nhân chấn thương, cần sử dụng kỹ thuật log-roll và cố định chắc chắn để đảm bảo an toàn.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-006</data>
