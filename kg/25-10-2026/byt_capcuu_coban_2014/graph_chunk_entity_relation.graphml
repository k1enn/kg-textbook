</node>
<node id="áp lực nội sọ">
  <data key="d0">áp lực nội sọ</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
  <data key="d2">Duy trì áp lực nội sọ bình thường là mục tiêu nhằm kiểm soát tình trạng nội sọ.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
