</node>
<node id="rung thất sóng nhỏ">
  <data key="d0">rung thất sóng nhỏ</data>
  <data key="d1">benh</data>
  <data key="d2">Loại rung thất có sóng nhỏ, cần phân biệt với vô tâm thu trong chẩn đoán.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1793454119</data>
  <data key="d6"></data>
</node>
<node id="do tac mach">
  <data key="d0">do tac mach</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là yếu tố nguy cơ gây ra tình trạng ngừng tim phổi trong quá trình cấp cứu.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
