<node id="Định lượng D – Dimer">
  <data key="d0">Định lượng D – Dimer</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một trong các xét nghiệm khác được chỉ định tùy theo tình trạng bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="dị vật đường thở">
  <data key="d0">dị vật đường thở</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây suy hô hấp thường gặp, xuất hiện đột ngột với các triệu chứng xâm nhập.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tràn khí màng phổi">
  <data key="d0">tràn khí màng phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý gây khó thở đột ngột, có thể xuất hiện sau gắng sức hoặc tự phát.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="đợt cấp của bệnh phổi tắc nghẽn mạn tính (COPD)">
  <data key="d0">đợt cấp của bệnh phổi tắc nghẽn mạn tính (COPD)</data>
  <data key="d1">benh</data>
  <data key="d2">Là đợt cấp của COPD, đặc trưng bởi tăng tiết đờm và co thắt phế quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tắc đường hô hấp trên">
  <data key="d0">tắc đường hô hấp trên</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bệnh lý hô hấp có thể không có triệu chứng X quang rõ.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ức chế hô hấp hoặc liệt hô hấp">
  <data key="d0">ức chế hô hấp hoặc liệt hô hấp</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là các tình trạng gây bệnh lý hô hấp có thể không có triệu chứng X quang rõ.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hỗn hợp vừa có giảm ô xy máu và tăng CO2">
  <data key="d0">hỗn hợp vừa có giảm ô xy máu và tăng CO2</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là đặc điểm của suy hô hấp trong đợt cấp của COPD.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tiền sử bệnh nhân có tiền sử bệnh phổi tắc nghẽn mạn tính">
  <data key="d0">tiền sử bệnh nhân có tiền sử bệnh phổi tắc nghẽn mạn tính</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là điều kiện lâm sàng được dùng để chẩn đoán đợt cấp của COPD.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hô hấp hỗn hợp">
  <data key="d0">hô hấp hỗn hợp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng có giảm ô xy máu và tăng CO2 trong máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="bệnh phổi tắc nghẽn mạn tính">
  <data key="d0">bệnh phổi tắc nghẽn mạn tính</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tiền sử bệnh nhân có thể dẫn đến khó thở, ho khạc đờm tăng và đờm đục.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="viêm phổi">
  <data key="d0">viêm phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh gây suy hô hấp do giảm ô xy máu, có triệu chứng sốt, ho khạc đờm đục, khó thở và đau ngực.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hội chứng suy hô hấp tiến triển">
  <data key="d0">hội chứng suy hô hấp tiến triển</data>
  <data key="d1">benh</data>
  <data key="d2">Là biểu hiện của đáp ứng viêm hệ thống do tổn thương phổi hoặc nguyên nhân ngoài phổi, với tăng shunt làm suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tổn thương não do chấn thương">
  <data key="d0">tổn thương não do chấn thương</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây suy hô hấp có tăng CO2 máu, có thể dẫn đến suy hô hấp giảm ô xy máu khi có sặc phổi hoặc bệnh phổi mạn.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="suy tim ứ huyết mất bù">
  <data key="d0">suy tim ứ huyết mất bù</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh chủ yếu gây suy hô hấp giảm ô xy máu, có thể gặp thể tăng CO2 ở bệnh nhân có bệnh phổi mạn tính.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="cổ ưỡn">
  <data key="d0">cổ ưỡn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế dẫn lưu để khai thông đường thở trong xử trí cấp cứu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="canuyn Grudel">
  <data key="d0">canuyn Grudel</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là dụng cụ chống tụt lưỡi dùng trong khai thông đường thở.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hút đờm dãi">
  <data key="d0">hút đờm dãi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật hút đờm để hỗ trợ hô hấp trong tình trạng khó thở.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hút rửa phế quản">
  <data key="d0">hút rửa phế quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật hút rửa phế quản để khai thông đường thở.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tư thế nằm nghiêng an toàn">
  <data key="d0">tư thế nằm nghiêng an toàn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế sử dụng khi có nguy cơ sặc để bảo vệ đường thở.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="nội khí quản">
  <data key="d0">nội khí quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là biện pháp hữu hiệu để khai thông đường thở trong cấp cứu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="đường thở">
