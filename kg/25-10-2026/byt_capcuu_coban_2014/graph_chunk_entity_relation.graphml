  <data key="d0">120 phút sau khi bắt đầu đau ngực</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian tối đa để thực hiện can thiệp mạch vành hoặc điều trị bằng thuốc tiêu sợi huyết.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="90 phút sau khi xuất hiện đau ngực">
  <data key="d0">90 phút sau khi xuất hiện đau ngực</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian tối đa để tiến hành can thiệp mạch vành sau khi xuất hiện đau ngực.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
