<node id="lidocaine">
  <data key="d0">lidocaine</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc dùng trong xử trí rung thất.&lt;SEP&gt;Một loại thuốc được liệt kê trong danh sách các thuốc dùng để điều trị rối loạn nhịp tim.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-005</data>
