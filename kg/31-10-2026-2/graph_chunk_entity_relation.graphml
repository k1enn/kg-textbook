</node>
<node id="xq ngực">
  <data key="d0">xq ngực</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Xét nghiệm X quang ngực có thể phát hiện trung thất rộng, gẫy xương sườn số 1 hoặc 2, lệch trục khí quản và tràn má.&lt;SEP&gt;Xét nghiệm X quang ngực để phát hiện đám tăng tỉ trọng không đồng nhất ở phổi bị tổn thương.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-009</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="hội chẩn chuyên khoa ngoại lồng ngực">
  <data key="d0">hội chẩn chuyên khoa ngoại lồng ngực</data>
  <data key="d1">khac</data>
  <data key="d2">Hội chẩn chuyên khoa ngoại lồng ngực được thực hiện để xử trí bệnh nhân đụng dập tim.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="ương sườn số 1 hoặc 2">
  <data key="d0">ương sườn số 1 hoặc 2</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là dấu hiệu lâm sàng cho thấy tổn thương cơ sườn, có thể dẫn đến biến chứng phổi.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-008</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="phế quản gốc bên phải">
  <data key="d0">phế quản gốc bên phải</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hiện tượng phế quản gốc bên phải bị đẩy lên cao do tổn thương cơ hoành.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-008</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="phế quản gốc bên trái">
  <data key="d0">phế quản gốc bên trái</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hiện tượng phế quản gốc bên trái bị hạ thấp do tổn thương cơ hoành.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-008</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="an thần thở máy">
  <data key="d0">an thần thở máy</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là tình trạng bệnh nhân cần được an thần và thở máy khi chuyển viện.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-008</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
