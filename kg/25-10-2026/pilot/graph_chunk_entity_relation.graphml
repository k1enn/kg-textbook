  <data key="d0">triệu chứng suy tim</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là các dấu hiệu lâm sàng được ghi nhận trong thăm khám tim mạch.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="bệnh tim">
  <data key="d0">bệnh tim</data>
  <data key="d1">benh</data>
  <data key="d2">Là các bệnh lý liên quan đến hệ tim mạch.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ý thức">
  <data key="d0">ý thức</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là trạng thái nhận thức được đánh giá trong thăm khám thần kinh.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="triệu chứng liệt cơ hô hấp">
  <data key="d0">triệu chứng liệt cơ hô hấp</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng được ghi nhận trong thăm khám thần kinh.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="XQ phổi">
  <data key="d0">XQ phổi</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là phương pháp chẩn đoán hình ảnh được sử dụng để định hướng chẩn đoán bệnh lý hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Khí máu động mạch">
  <data key="d0">Khí máu động mạch</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm cần thiết để chẩn đoán và phân loại suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Điện tim">
  <data key="d0">Điện tim</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm giúp chẩn đoán bệnh tim và các rối loạn nhịp tim do suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Siêu âm tim">
  <data key="d0">Siêu âm tim</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một trong các xét nghiệm khác được chỉ định tùy theo tình trạng bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Chụp nhấp nháy phổi">
  <data key="d0">Chụp nhấp nháy phổi</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một trong các xét nghiệm khác được chỉ định tùy theo tình trạng bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Chụp CT scan phổi">
  <data key="d0">Chụp CT scan phổi</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một trong các xét nghiệm khác được chỉ định tùy theo tình trạng bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
