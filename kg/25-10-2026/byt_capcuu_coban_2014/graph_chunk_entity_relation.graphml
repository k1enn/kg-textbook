<node id="thuốc cấp cứu, thuốc duy trì điều trị">
  <data key="d0">thuốc cấp cứu, thuốc duy trì điều trị</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là các loại thuốc được mang theo để cấp cứu hoặc duy trì điều trị cho bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tối thiểu hai nhân viên (không kể lái xe)">
  <data key="d0">tối thiểu hai nhân viên (không kể lái xe)</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là yêu cầu về số lượng nhân viên tham gia vận chuyển bệnh nhân, tối thiểu hai người ngoài lái xe.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="HA">
  <data key="d0">HA</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật đo huyết áp liên tục, được thực hiện để theo dõi huyết áp của bệnh nhân trong thời gian vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="báo động tối thiểu">
  <data key="d0">báo động tối thiểu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tín hiệu cảnh báo khi thông khí nhân tạo đạt mức độ bất thường, thường do áp suất cao hoặc hở đường thở.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="khi rời khoa chuyển">
  <data key="d0">khi rời khoa chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thời điểm khi bệnh nhân được chuyển từ giường lên cáng hoặc xe ô tô trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="khi đến khoa tiếp nhận">
  <data key="d0">khi đến khoa tiếp nhận</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thời điểm khi bệnh nhân được chuyển từ cáng sang giường tại khoa tiếp nhận.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="bàn giao hồ sơ bệnh án">
  <data key="d0">bàn giao hồ sơ bệnh án</data>
  <data key="d1">hoat_dong</data>
  <data key="d2">Là hành động trao đổi thông tin về tình trạng bệnh nhân giữa các khoa trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="xquang">
  <data key="d0">xquang</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm hình ảnh được thực hiện để đánh giá tình trạng phổi và cơ quan hô hấp của bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="bàn giao các y lệnh">
  <data key="d0">bàn giao các y lệnh</data>
  <data key="d1">hoat_dong</data>
  <data key="d2">Là hành động trao đổi các chỉ định điều trị giữa các khoa trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="thực hiện các y lệnh">
  <data key="d0">thực hiện các y lệnh</data>
  <data key="d1">hoat_dong</data>
  <data key="d2">Là hành động thực hiện các chỉ định điều trị như thuốc đang dùng, đã dùng hoặc thuốc pha trong dịch truyền.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="đảm bảo sự liên tục về theo dõi - điều trị - kế hoạch thăm dò chẩn đoán, điều trị">
  <data key="d0">đảm bảo sự liên tục về theo dõi - điều trị - kế hoạch thăm dò chẩn đoán, điều trị</data>
  <data key="d1">hoat_dong</data>
  <data key="d2">Là hành động đảm bảo sự liên tục trong việc theo dõi, điều trị và lên kế hoạch chẩn đoán, điều trị cho bệnh nhân trong suốt quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm ngửa">
  <data key="d0">nằm ngửa</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế nằm ngửa, dùng trong các tình huống cần đảm bảo hô hấp và tuần hoàn khi bệnh nhân được vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm nghiêng">
  <data key="d0">nằm nghiêng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế nằm nghiêng, dùng để hỗ trợ hô hấp và giảm áp lực lên các cơ quan trong bệnh nhân chấn thương.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="ngồi">
  <data key="d0">ngồi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế ngồi, dùng trong trường hợp bệnh nhân tỉnh và cần cảm thấy dễ chịu khi vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm sấp">
  <data key="d0">nằm sấp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế nằm sấp, dùng trong một số trường hợp chấn thương bụng hoặc cần giảm đau bụng.&lt;SEP&gt;Là một tư thế hiếm khi áp dụng cho vết thương hoặc vết bỏng lưng quá đau, tuy nhiên gây khó chịu cho bệnh nhân và nguy cơ làm nặng thêm tình trạng hô hấp, khó theo dõi bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="giữ thẳng trục đầu - cổ - thân">
  <data key="d0">giữ thẳng trục đầu - cổ - thân</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật giữ ổn định trục đầu - cổ - thân để tránh tổn thương cột sống khi vận chuyển bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="chảy máu nhiều">
  <data key="d0">chảy máu nhiều</data>
  <data key="d1">tri_tue</data>
  <data key="d2">Là tình trạng xảy ra khi bệnh nhân có lượng máu mất nhiều, cần điều trị kịp thời trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="giảm thể tích nặng">
  <data key="d0">giảm thể tích nặng</data>
  <data key="d1">tri_tue</data>
  <data key="d2">Là tình trạng giảm thể tích máu nặng, ảnh hưởng đến tuần hoàn và hô hấp trong bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="vết thương hoặc chấn thương bụng kín">
  <data key="d0">vết thương hoặc chấn thương bụng kín</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng tổn thương bụng kín, cần xử lý khi bệnh nhân có vết thương bụng hoặc chấn thương bụng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tăng tuần hoàn tĩnh m">
  <data key="d0">tăng tuần hoàn tĩnh m</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hiệu quả đạt được khi đặt tư thế nằm ngửa đầu cao 10-30 độ, giúp tăng tuần hoàn máu đến não.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="gẫy chân hoặc xương chậu">
  <data key="d0">gẫy chân hoặc xương chậu</data>
  <data key="d1">tri_tue</data>
  <data key="d2">Là tình trạng tổn thương xương do gãy chân hoặc xương chậu, gây chống chỉ định trong một số tư thế vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="ngửa, đùi gấp">
  <data key="d0">ngửa, đùi gấp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế dùng để giảm đau bụng do làm lỏng các cơ bụng khi có vết thương hoặc chấn thương bụng kín.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm ngửa, đầu cao 10-30 độ">
  <data key="d0">nằm ngửa, đầu cao 10-30 độ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng cho chấn thương sọ não để tăng tuần hoàn tĩnh mạch trở về và giảm phù não.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm nghiêng an toàn">
  <data key="d0">nằm nghiêng an toàn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng cho bệnh nhân có rối loạn ý thức mà không có rối loạn hô hấp hoặc tuần hoàn để giải phóng đường thở và hạn chế nguy cơ hít vào phổi.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tư thế sản khoa (nằm nghiêng an toàn sang trái)">
  <data key="d0">tư thế sản khoa (nằm nghiêng an toàn sang trái)</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng cho bệnh nhân mang thai trên 7 tháng để giảm chèn ép của tử cung vào tĩnh mạch chủ dưới.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="ngồi - chân thõng">
  <data key="d0">ngồi - chân thõng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng trong trường hợp phù phổi cấp để giảm tuần hoàn tĩnh mạch trở về tim.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nửa ngồi - chân thẳng">
  <data key="d0">nửa ngồi - chân thẳng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng khi bệnh nhân khó thở và còn tỉnh (HPQ, bệnh phổi mãn) để cơ hoành dễ di động hơn và giảm đè ép của các tạng ổ bụng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nửa ngồi- chân gấp">
  <data key="d0">nửa ngồi- chân gấp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng cho chấn thương bụng-ngực để ngồi giúp dễ thở và gấp chân làm chùng cơ bụng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="ngồi ngả ra trước">
  <data key="d0">ngồi ngả ra trước</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế áp dụng cho bệnh nhân bị viêm nắp thanh quản (chưa đặt NKQ) để giảm cản trở hô hấp và giảm nguy cơ tắc đường khí do phù nề nắp thanh quản, đồng thời hạn chế chảy máu mũi nếu có.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="garô vòng quanh chi">
  <data key="d0">garô vòng quanh chi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một biện pháp dùng để cầm máu khi có vết thương cắt cụt hoặc gần cắt cụt bằng cách vòng quanh chi.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nẹp bằng nẹp hơi">
  <data key="d0">nẹp bằng nẹp hơi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một biện pháp dùng để cố định xương và cầm máu khi có tổn thương xương gây chảy máu.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="đặt lại đúng tư thế">
  <data key="d0">đặt lại đúng tư thế</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một biện pháp dùng để đặt lại đúng tư thế và nẹp lại chi khi có gãy xương và trật khớp gây biến dạng chi trước khi vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="gãy xương kín bị chuyển thành gãy xương hở">
  <data key="d0">gãy xương kín bị chuyển thành gãy xương hở</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một biến chứng có thể xảy ra nếu không xử trí đúng khi có gãy xương và trật khớp gây biến dạng chi.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="hoại tử vùng da bị căng, kéo xoắn hoặc ép động mạch">
  <data key="d0">hoại tử vùng da bị căng, kéo xoắn hoặc ép động mạch</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một biến chứng có thể xảy ra do không xử trí đúng khi có gãy xương và trật khớp gây biến dạng chi.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="viêm nắp thanh quản">
  <data key="d0">viêm nắp thanh quản</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý xảy ra khi có tình trạng phù nề nắp thanh quản, có thể dẫn đến tắc đường khí hô hấp.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="chấn thương bụng-ngực">
  <data key="d0">chấn thương bụng-ngực</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng chấn thương ảnh hưởng đến cả bụng và ngực, thường được xử trí bằng tư thế nửa ngồi - chân gấp.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="rối loạn ý thức">
  <data key="d0">rối loạn ý thức</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một nhóm người bệnh không có rối loạn hô hấp hoặc tuần hoàn, được chỉ định dùng tư thế nằm nghiêng an toàn.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="bệnh phổi mãn">
  <data key="d0">bệnh phổi mãn</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý mãn tính về phổi, được chỉ định dùng tư thế nửa ngồi - chân thẳng khi bệnh nhân khó thở và còn tỉnh.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="HPQ">
  <data key="d0">HPQ</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một nhóm người bệnh còn tỉnh khi khó thở, được chỉ định dùng tư thế nửa ngồi - chân thẳng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="giữ thẳng đầu gối khi nâng">
  <data key="d0">giữ thẳng đầu gối khi nâng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d2">Đảm bảo lực nâng được truyền hiệu quả từ đùi và hông đến cơ thể.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tạo điều kiện thuận lợi cho sự cân bằng">
  <data key="d0">tạo điều kiện thuận lợi cho sự cân bằng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d2">Đi về phía trước giúp duy trì sự cân bằng và thuận lợi cho vận chuyển.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tuân thủ các nguyên tắc như khi nâng">
  <data key="d0">tuân thủ các nguyên tắc như khi nâng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d2">Áp dụng các nguyên tắc nâng để đảm bảo an toàn khi đặt cáng hoặc ván khiêng xuống.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tình trạng bệnh nhân ổn định">
  <data key="d0">tình trạng bệnh nhân ổn định</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d2">Di dời cấp cứu chỉ thực hiện khi tình trạng bệnh nhân ổn định và không cần cấp cứu ngay lập tức.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="đánh giá và dự đoán được nhu cầu chăm sóc">
  <data key="d0">đánh giá và dự đoán được nhu cầu chăm sóc</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d2">Kế hoạch vận chuyển chu đáo cần bao gồm đánh giá và dự đoán nhu cầu chăm sóc trong quá trình vận chuyển.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="xử lý được các diễn biến trong khi vận chuyển">
  <data key="d0">xử lý được các diễn biến trong khi vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d2">Nhân viên vận chuyển cần có năng lực xử lý các diễn biến bất ngờ trong quá trình vận chuyển.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="đáp ứng được các diễn biến trong khi vận chuyển">
  <data key="d0">đáp ứng được các diễn biến trong khi vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d2">Phương tiện vận chuyển cần được lựa chọn để đáp ứng các diễn biến có thể xảy ra trong quá trình vận chuyển.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Ghi chỉ định vận chuyển">
  <data key="d0">Ghi chỉ định vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d2">Hồ sơ bệnh án ghi lại chỉ định vận chuyển trong quá trình vận chuyển</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Ghi diễn biến trong quá trình vận chuyển">
  <data key="d0">Ghi diễn biến trong quá trình vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d2">Hồ sơ bệnh án ghi lại diễn biến trong quá trình vận chuyển</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Máy thở khi vận chuyển">
  <data key="d0">Máy thở khi vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d2">Máy thở khi vận chuyển đảm bảo theo dõi chức năng hô hấp của bệnh nhân</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="hồ sơ bệnh án">
  <data key="d0">hồ sơ bệnh án</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d2">Các phim X-quang, CT scan, MRI được lưu trữ trong hồ sơ bệnh án để hỗ trợ chẩn đoán.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="đặt NKQ, xử lý loạn nhịp, cấp cứu ngừng tuần hoàn, ngừng thở">
  <data key="d0">đặt NKQ, xử lý loạn nhịp, cấp cứu ngừng tuần hoàn, ngừng thở</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d2">Bác sĩ và kỹ thuật viên vận chuyển thực hiện các thao tác cấp cứu như đặt NKQ, xử lý loạn nhịp, ngừng tuần hoàn.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="chấn thương cột">
  <data key="d0">chấn thương cột</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d2">Tư thế nằm sấp được dùng để giảm áp lực lên cột sống trong một số trường hợp chấn thương.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm ngửa, chân cao">
  <data key="d0">nằm ngửa, chân cao</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d2">Tư thế nằm ngửa, chân cao được áp dụng khi bệnh nhân có chảy máu nhiều và giảm thể tích nặng.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nằm ngửa, đùi gấp">
  <data key="d0">nằm ngửa, đùi gấp</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d2">Tư thế nằm ngửa, đùi gấp được áp dụng để giảm đau bụng khi có vết thương hoặc chấn thương bụng kín.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân mang thai trên 7 tháng">
  <data key="d0">bệnh nhân mang thai trên 7 tháng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Tư thế này được dùng để điều trị bệnh nhân mang thai trên 7 tháng bằng cách giảm chèn ép của tử cung vào tĩnh mạch chủ dưới.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="vết thương hoặc vết bỏng lưng quá đau">
  <data key="d0">vết thương hoặc vết bỏng lưng quá đau</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Tư thế này được dùng để điều trị vết thương hoặc vết bỏng lưng quá đau, tuy nhiên gây khó chịu và nguy cơ làm nặng thêm tình trạng hô hấp.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="vết thương cắt cụt hoặc gần cắt cụt">
  <data key="d0">vết thương cắt cụt hoặc gần cắt cụt</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Biện pháp cầm máu được áp dụng cho vết thương cắt cụt hoặc gần cắt cụt bằng cách ép trực tiếp vào động mạch.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="tổn thương xương gây chảy máu">
  <data key="d0">tổn thương xương gây chảy máu</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Biện pháp cầm máu được áp dụng cho tổn thương xương gây chảy máu bằng cách nẹp bằng nẹp hơi để cố định xương và cầm máu.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="gãy xương và trật khớp gây biến dạng chi">
  <data key="d0">gãy xương và trật khớp gây biến dạng chi</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Biện pháp đặt lại đúng tư thế được áp dụng cho gãy xương và trật khớp gây biến dạng chi để phòng các biến chứng như gãy xương hở hoặc hoại tử vùng da.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="phù nề nắp thanh quản">
  <data key="d0">phù nề nắp thanh quản</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Viêm nắp thanh quản có triệu chứng là phù nề nắp thanh quản dẫn đến tắc đường khí hô hấp.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<edge source="Nguy kịch (khẩn cấp)" target="cấp cứu (emergency)">
  <data key="d7">1.0</data>
  <data key="d8">Nguy kịch (khẩn cấp) là một dạng bệnh lý nghiêm trọng hơn so với cấp cứu (emergency) vì đe dọa tính mạng nhanh chóng nếu không can thiệp ngay.</data>
  <data key="d9">bệnh nền,yeu_to_nguy_co_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Nguy kịch (khẩn cấp)" target="Công tác thực hành cấp cứu">
  <data key="d7">1.0</data>
  <data key="d8">Công tác thực hành cấp cứu bao gồm việc đánh giá và xử trí cho bệnh nhân trong tình trạng nguy kịch (khẩn cấp).</data>
  <data key="d9">bệnh,dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Nguy kịch (khẩn cấp)" target="Can thiệp điều trị">
  <data key="d7">1.0</data>
  <data key="d8">Các can thiệp điều trị được áp dụng để can thiệp ngay cho bệnh nhân nguy kịch.</data>
  <data key="d9">can_thiệp,dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Nguy kịch (khẩn cấp)" target="Tập trung cấp cứu">
  <data key="d7">1.0</data>
  <data key="d8">Bệnh nhân nguy kịch cần được tập trung cấp cứu ngay để đảm bảo an toàn tính mạng.</data>
  <data key="d9">can_thiệp,phong_ngua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Nguy kịch (khẩn cấp)" target="Xác định xem bệnh nhân có nguy cơ tử vong hiển hiện không?">
  <data key="d7">1.0</data>
  <data key="d8">Việc xác định nguy cơ tử vong là yếu tố quyết định để phân loại bệnh nhân thành nhóm nguy kịch.</data>
  <data key="d9">nguyen_nhan_cua,tử_vong</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Cấp cứu (emergency)" target="Công tác thực hành cấp cứu">
  <data key="d7">1.0</data>
  <data key="d8">Công tác thực hành cấp cứu bao gồm việc đánh giá và xử trí cho bệnh nhân trong tình trạng cấp cứu (emergency).</data>
  <data key="d9">bệnh,dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Cấp cứu (emergency)" target="Điều trị cấp cứu">
  <data key="d7">1.0</data>
  <data key="d8">Các loại điều trị cấp cứu được áp dụng cho bệnh nhân cấp cứu để tránh tiến triển nặng.</data>
  <data key="d9">can_thiệp,dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Cấp cứu (emergency)" target="Đặt trong tầm mắt cảnh giới theo dõi">
  <data key="d7">1.0</data>
  <data key="d8">Bệnh nhân cấp cứu cần được đặt trong tầm mắt cảnh giới theo dõi để theo dõi sát tình trạng.</data>
  <data key="d9">phong_ngua,theo_dõi</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Công tác thực hành cấp cứu" target="Hạn chế về thời gian">
  <data key="d7">1.0</data>
  <data key="d8">Hạn chế về thời gian là yếu tố nguy cơ làm tăng áp lực trong công tác thực hành cấp cứu do phải đưa ra quyết định nhanh và chính xác.</data>
  <data key="d9">thủ thuật,yeu_to_nguy_co_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Công tác thực hành cấp cứu" target="Cần đánh giá nhanh và ra quyết định với lượng thông tin hạn chế, chưa đầy đủ">
  <data key="d7">1.0</data>
  <data key="d8">Sự thiếu hụt thông tin trong đánh giá ban đầu là một thách thức lớn trong công tác thực hành cấp cứu, ảnh hưởng đến tính chính xác của chẩn đoán và xử trí.</data>
  <data key="d9">thủ thuật,yeu_to_nguy_co_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Công tác thực hành cấp cứu" target="Không gian và môi trường làm việc">
  <data key="d7">1.0</data>
  <data key="d8">Môi trường làm việc đông đúc và mở gây áp lực lớn, ảnh hưởng đến hiệu suất và khả năng phản ứng trong công tác thực hành cấp cứu.</data>
  <data key="d9">thủ thuật,yeu_to_nguy_co_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Công tác thực hành cấp cứu" target="Rèn luyện kỹ năng thăm khám và cấp cứu bệnh nhân theo 2 bước (primary và secondary)">
  <data key="d7">1.0</data>
  <data key="d8">Phương pháp rèn luyện kỹ năng theo hai bước (primary và secondary) là một phần quan trọng trong công tác thực hành cấp cứu để đảm bảo tiến trình xử trí hợp lý.</data>
  <data key="d9">phan_biet_voi,thủ thuật</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="Công tác thực hành cấp cứu" target="Tác phong khẩn trương và phản ứng theo trình tự">
  <data key="d7">1.0</data>
  <data key="d8">Tác phong khẩn trương và phản ứng theo trình tự là yếu tố then chốt giúp đảm bảo hiệu quả và an toàn trong công tác thực hành cấp cứu.</data>
  <data key="d9">dieu_tri,thủ thuật</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="thời gian" target="không gian và môi trường làm việc">
  <data key="d7">1.0</data>
  <data key="d8">Thời gian ngắn và thiếu thông tin đầy đủ tạo ra áp lực làm việc trong môi trường làm việc tại khoa cấp cứu.</data>
  <data key="d9">khac,ảnh hưởng đến</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="thời gian" target="chẩn đoán">
  <data key="d7">1.0</data>
  <data key="d8">Thời gian là yếu tố ảnh hưởng đến việc xác định nguyên nhân bệnh lý trong cấp cứu.</data>
  <data key="d9">nguyen_nhan_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="môi trường làm việc tại khoa cấp cứu" target="nhiều lo lắng và dễ bị phân tâm">
  <data key="d7">1.0</data>
  <data key="d8">Môi trường làm việc tại khoa cấp cứu với không gian mở, đông người và dòng người di chuyển nhanh gây ra sự lo lắng và phân tâm cho nhân viên y tế.</data>
  <data key="d9">gây ra,khac</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="nhiều lo lắng và dễ bị phân tâm" target="nguy cơ bị đe dọa về tinh thần và bạo lực">
  <data key="d7">1.0</data>
  <data key="d8">Sự phân tâm của nhân viên y tế do nhiều việc phải xử lý làm tăng nguy cơ bị đe dọa về tinh thần và bạo lực từ bệnh nhân hoặc người thân.</data>
  <data key="d9">dẫn đến,khac</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="nguy cơ bị quá tải" target="lượng bệnh nhân đến cấp cứu">
  <data key="d7">1.0</data>
  <data key="d8">Lượng bệnh nhân đến cấp cứu thay đổi không ổn định và khó dự đoán, dẫn đến tình trạng quá tải công việc và bệnh nhân bị bỏ sót.</data>
  <data key="d9">khac,tạo ra</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="nguy cơ bị quá tải" target="công suất">
  <data key="d7">1.0</data>
  <data key="d8">Khi công suất của khoa cấp cứu đạt đến 140%, sẽ có nguy cơ quá tải và bệnh nhân bị bỏ sót.</data>
  <data key="d9">khac,khi đạt đến</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="thời điểm các khoa cấp cứu bị quá tải bệnh nhân" target="nguy cơ bỏ sót bệnh nhân">
  <data key="d7">1.0</data>
  <data key="d8">Khi khoa cấp cứu bị quá tải bệnh nhân, có nguy cơ bệnh nhân bị bỏ sót trong quá trình cấp cứu.</data>
  <data key="d9">phong_ngua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="tính ưu tiên cấp cứu" target="quy trình phân loại bệnh nhân">
  <data key="d7">1.0</data>
  <data key="d8">Tính ưu tiên cấp cứu yêu cầu triển khai quy trình phân loại bệnh nhân để xác định mức độ cấp thiết.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="quy trình phân loại bệnh nhân" target="kỹ năng phân loại bệnh nhân">
  <data key="d7">1.0</data>
  <data key="d8">Quy trình phân loại bệnh nhân cần được rèn luyện kỹ năng để thực hiện hiệu quả.</data>
  <data key="d9">chan_doan_bang</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="kỹ năng phân loại bệnh nhân" target="phân loại các công việc, kỹ thuật can thiệp cấp cứu">
  <data key="d7">1.0</data>
  <data key="d8">Kỹ năng phân loại bệnh nhân được áp dụng để phân loại các công việc và kỹ thuật can thiệp theo ưu tiên.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="phản ứng xử lý cấp cứu theo tính ưu tiên cấp cứu" target="can thiệp nào cấp thiết hơn thì ưu tiên thực hiện trước">
  <data key="d7">1.0</data>
  <data key="d8">Phản ứng xử lý cấp cứu theo tính ưu tiên giúp các can thiệp cấp thiết hơn được thực hiện trước.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="bệnh nhân ngừng tuần hoàn" target="xác nhận tử vong">
  <data key="d7">1.0</data>
  <data key="d8">Việc xác nhận tử vong là một bước xử lý khi bệnh nhân ngừng tuần hoàn và không còn sống.</data>
  <data key="d9">phan_biet_voi</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="bệnh nhân tử vong" target="thông báo và chuẩn bị tâm lý cho người than của bệnh nhân tử vong">
  <data key="d7">1.0</data>
  <data key="d8">Khi bệnh nhân tử vong, cần thông báo và chuẩn bị tâm lý cho người thân.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="tại sao bệnh nhân tử vong" target="nguy cơ lây bệnh cho người khác (nhân viên y tế, gia đình và người thân…)">
  <data key="d7">1.0</data>
  <data key="d8">Nguyên nhân tử vong có thể dẫn đến nguy cơ lây bệnh cho người khác.</data>
  <data key="d9">nguyen_nhan_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="một bác sỹ cấp cứu, y tá cấp cứu đang trong ca làm việc" target="đảm bảo bao quát để kiểm soát cả bệnh phòng/khu vực">
  <data key="d7">1.0</data>
  <data key="d8">Nhân viên y tế trong ca làm việc cần đảm bảo kiểm soát toàn bộ khu vực và bệnh nhân trong phạm vi trách nhiệm.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="kỹ năng quan sát nhanh" target="phương pháp tổ chức làm việc hợp lý">
  <data key="d7">1.0</data>
  <data key="d8">Kỹ năng quan sát nhanh được kết hợp với phương pháp tổ chức làm việc để nâng cao hiệu suất.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="phương pháp tổ chức làm việc hợp lý" target="biết tiết kiệm cũng như phân phối sức lực">
  <data key="d7">1.0</data>
  <data key="d8">Phương pháp tổ chức làm việc hợp lý hỗ trợ việc tiết kiệm và phân phối sức lực cho nhân viên.</data>
  <data key="d9">dieu_tri</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
