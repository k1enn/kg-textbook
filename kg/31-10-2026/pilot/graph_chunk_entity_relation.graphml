  <data key="d0">áp lực công việc</data>
  <data key="d1">khac</data>
  <data key="d2">Các áp lực công việc và từ bệnh nhân và người thân làm nhân viên y tế khó tập trung và đảm bảo tuân thủ quy trình cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
