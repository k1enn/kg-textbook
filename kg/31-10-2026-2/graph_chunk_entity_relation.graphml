<node id="đường tiêu hoá">
  <data key="d0">đường tiêu hoá</data>
  <data key="d1">khac</data>
  <data key="d2">Nôn được chỉ định để loại bỏ chất độc qua đường tiêu hóa khi nạn nhân còn tỉnh táo.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="ngộ độc">
  <data key="d0">ngộ độc</data>
  <data key="d1">khac</data>
  <data key="d2">Axít là một nguyên nhân gây ngộ độc khi tiếp xúc qua đường tiêu hóa.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
