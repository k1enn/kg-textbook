  <data key="d0">chảy máu nhiều</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một nguyên nhân gây ra tình trạng giảm thể tích máu nặng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
