<node id="chất độc">
  <data key="d0">chất độc</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ra các triệu chứng ngộ độc trong cơ thể nạn nhân.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nạn nhân">
  <data key="d0">nạn nhân</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là đối tượng bị ảnh hưởng trực tiếp bởi chất độc và có thể xuất hiện các triệu chứng ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="tỉnh táo">
  <data key="d0">tỉnh táo</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng cho thấy nạn nhân còn có ý thức và phản xạ bình thường.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="kiềm mạnh">
  <data key="d0">kiềm mạnh</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một loại chất hóa học mạnh có thể gây ngộ độc khi tiếp xúc hoặc hấp thu qua đường tiêu hóa.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
