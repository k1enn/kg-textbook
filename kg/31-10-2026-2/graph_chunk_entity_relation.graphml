  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là yếu tố nguy cơ liên quan đến tổn thương xương sọ sau chấn thương sọ não.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
