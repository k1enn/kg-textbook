  <data key="d1">doi_tuong</data>
  <data key="d2">Là hai loại canuyn được sử dụng trong thực tiễn lâm sàng, tùy thuộc vào tình trạng bệnh nhân.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
