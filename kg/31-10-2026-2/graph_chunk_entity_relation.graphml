  <data key="d0">kinh nghiệm</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là sự tích lũy từ nhiều trường hợp thực tế để đưa ra quyết định nhanh chóng trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="nguyên tắc">
  <data key="d0">nguyên tắc</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là các quy định cố định được tuân thủ để đưa ra chẩn đoán và xử trí hợp lý trong điều kiện thiếu thông tin.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
