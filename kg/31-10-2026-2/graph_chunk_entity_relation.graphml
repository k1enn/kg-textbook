  <data key="d6"></data>
</node>
<node id="vận chuyển">
  <data key="d0">vận chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hành động chuyển bệnh nhân giữa các bệnh viện để tiếp nhận chăm sóc hồi sức tích cực hơn hoặc kỹ thuật chuyên khoa cao hơn.&lt;SEP&gt;Là tình trạng vận chuyển bệnh nhân sau khi xử trí tổn thương xương.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
