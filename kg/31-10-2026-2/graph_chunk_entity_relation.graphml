  <data key="d0">hít vào phổi</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Một triệu chứng khi bệnh nhân có nguy cơ hít vào phổi trong tư thế nằm nghiêng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tử cung">
  <data key="d0">tử cung</data>
  <data key="d1">khac</data>
  <data key="d2">Một cơ quan trong cơ thể có thể chèn ép tĩnh mạch chủ dưới khi mang thai.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
