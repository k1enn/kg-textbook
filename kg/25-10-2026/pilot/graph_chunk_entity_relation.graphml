  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d2">Nhồi máu cơ tim cấp là một trong các chẩn đoán quan trọng có nguy cơ cấp cứu cao cần được nghĩ đến và loại trừ trước.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
