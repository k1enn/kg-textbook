</node>
<node id="ống thông dạ dày nằm trên ngực">
  <data key="d0">ống thông dạ dày nằm trên ngực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hiện tượng ống thông dạ dày nằm trên ngực khi có tổn thương cơ hoành.</data>
