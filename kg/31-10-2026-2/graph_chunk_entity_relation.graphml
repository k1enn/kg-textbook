  <data key="d1">thu_thuat</data>
  <data key="d2">Một mắt xích trong dây truyền cấp cứu cho bệnh nhân chấn thương sọ não.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000</data>
