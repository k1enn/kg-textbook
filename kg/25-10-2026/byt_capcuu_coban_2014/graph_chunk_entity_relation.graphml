  <data key="d1">khac</data>
  <data key="d2">Phương pháp thực hiện khi trọng lượng cần đẩy ở thấp, bệnh nhân hoặc người thao tác thực hiện bằng việc quỳ gối và đẩy.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
