  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật ấn giữ hàm để mở đường thở, chủ yếu do nhân viên y tế thực hiện khi nghi ngờ chấn thương cột sống cổ</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
