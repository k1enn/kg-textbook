  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật được tiến hành ngay sau khi phát hiện nghi ngờ ngừng tuần hoàn.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1792918589</data>
  <data key="d6"></data>
</node>
<node id="NTH">
  <data key="d0">NTH</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng bệnh nhân không cử động và không phản ứng khi được lay gọi.&lt;SEP&gt;Một tình trạng y học xảy ra đột ngột, không thể dự đoán trước, liên quan đến mất chức năng tim mạch.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
