  <data key="d0">truyền dịch</data>
  <data key="d1">khac</data>
  <data key="d2">Máy truyền dịch được dùng để đảm bảo việc truyền dịch đúng lượng và đúng thời gian cho bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
