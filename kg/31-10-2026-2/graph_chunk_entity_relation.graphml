  <data key="d0">chẩn đoán quan trọng</data>
  <data key="d1">khac</data>
  <data key="d2">Nhồi máu cơ tim cấp là một chẩn đoán cần được nghĩ đến và loại trừ trước khi đưa ra kết luận.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="chẩn đoán trước">
  <data key="d0">chẩn đoán trước</data>
  <data key="d1">khac</data>
  <data key="d2">Bệnh nhân quay lại có thể có các vấn đề cấp cứu chưa được phát hiện hoặc xử trí đúng trong lần đến cấp cứu trước.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="sai sót">
  <data key="d0">sai sót</data>
  <data key="d1">khac</data>
  <data key="d2">Bệnh nhân quay lại là cơ hội để sửa chữa các sai sót hoặc bỏ sót trong chẩn đoán và xử trí lần đến cấp cứu trước.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="não">
  <data key="d0">não</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý liên quan đến hệ thần kinh trung ương.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
