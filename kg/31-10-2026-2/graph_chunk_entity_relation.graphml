  <data key="d2">Là xét nghiệm theo dõi hoạt động nhịp tim bằng máy monitor trong quá trình cấp cứu.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-003</data>
