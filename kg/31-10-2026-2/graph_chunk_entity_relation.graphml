  <data key="d1">doi_tuong</data>
  <data key="d2">Là nơi thực hiện các thủ thuật phẫu thuật sau khi xử lý cấp cứu.&lt;SEP&gt;Việc chuyển ghép nối chi được thực hiện trong phòng mổ hoặc tại tuyến trên.&lt;SEP&gt;Là phòng mổ được sử dụng để tiếp nhận bệnh nhân sau khi được vận chuyển</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-003&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
