  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="chỉ có một mình nạn nhân" target="tự ép bụng bằng cách ấn nắm tay lên bụng hoặc ép bụng vào các bề mặt chắc như bồn rửa, lưng ghế, mặt bàn, v.v...">
  <data key="d7">1.0</data>
  <data key="d8">Nạn nhân tự thực hiện việc ép bụng bằng tay hoặc bề mặt chắc khi không có người cấp cứu.</data>
  <data key="d9">thuoc</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="vỗ lưng và ép ngực" target="đặt trẻ nhỏ nằm trên tay tư thế sấp dọc theo trục của tay và đầu trẻ ở thấp">
  <data key="d7">1.0</data>
  <data key="d8">Thủ thuật vỗ lưng và ép ngực được thực hiện khi trẻ nhỏ nằm trên tay tư thế sấp.</data>
  <data key="d9">thuoc</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="vỗ lưng và ép ngực" target="dùng phần phẳng của bàn tay vỗ nhẹ và nhanh">
  <data key="d7">2.0</data>
  <data key="d8">Hành động vỗ lưng nhẹ và nhanh được thực hiện để tống dị vật ra khỏi đường thở ở trẻ nhỏ.&lt;SEP&gt;Thủ thuật vỗ lưng và ép ngực sử dụng hành động vỗ nhẹ và nhanh để loại trừ dị vật.</data>
  <data key="d9">thuoc</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="vỗ lưng và ép ngực" target="kiểm tra đường thở">
  <data key="d7">1.0</data>
  <data key="d8">Sau khi thực hiện vỗ lưng hoặc ép ngực, cần kiểm tra đường thở để đảm bảo hiệu quả.</data>
  <data key="d9">thuoc</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="vỗ lưng và ép ngực" target="trẻ nhỏ">
  <data key="d7">1.0</data>
  <data key="d8">Thủ thuật vỗ lưng và ép ngực được áp dụng cho trẻ nhỏ để tránh chấn thương do thủ thuật Heimlich.</data>
  <data key="d9">đối_tuong</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="dùng phần phẳng của bàn tay vỗ nhẹ và nhanh" target="kiểm tra đường thở">
  <data key="d7">1.0</data>
  <data key="d8">Sau khi vỗ lưng, cần kiểm tra đường thở để đảm bảo dị vật đã được loại bỏ.</data>
  <data key="d9">thuoc</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="lập lại quá trình: Ép bụng, kiểm tra đường thở và hô hấp nhân tạo" target="hô hấp nhân tạo">
  <data key="d7">1.0</data>
  <data key="d8">Sau khi không thể hô hấp, quá trình được lặp lại với ép bụng, kiểm tra đường thở và hô hấp nhân tạo.</data>
