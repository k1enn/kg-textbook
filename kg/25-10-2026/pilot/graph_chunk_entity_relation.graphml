<node id="bệnh nhân">
  <data key="d0">bệnh nhân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d2">Dấu hiệu sống là một triệu chứng lâm sàng quan trọng được theo dõi để đánh giá tình trạng bệnh nhân trong quá trình cấp cứu.&lt;SEP&gt;Nhóm người bệnh cần được hỗ trợ thông khí và điều trị theo các chỉ định cụ thể.</data>
  <data key="d1">doi_tuong</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
