<graph edgedefault="undirected"><node id="nguy kịch">
  <data key="d0">nguy kịch</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương hoặc rối loạn đe dọa tính mạng, có nguy cơ tử vong nhanh nếu không được can thiệp cấp cứu ngay&lt;SEP&gt;Là tình trạng bệnh lý, tổn thương hoặc rối loạn đe dọa tính mạng, có nguy cơ tử vong nhanh nếu không được can thiệp cấp cứu ngay.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="cấp cứu">
  <data key="d0">cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương hoặc rối loạn có thể tiến triển nặng nếu không được can thiệp điều trị nhanh chóng&lt;SEP&gt;Là quá trình can thiệp nhanh chóng nhằm ổn định bệnh nhân có tổn thương hoặc rối loạn có nguy cơ tiến triển nặng.&lt;SEP&gt;Là các tình trạng bệnh lý xảy ra đột ngột và cần can thiệp ngay lập tức.&lt;SEP&gt;Phân công là một phần trong quá trình tổ chức công tác cấp cứu.&lt;SEP&gt;Là các biện pháp điều trị cấp tính nhằm cứu sống bệnh nhân bị bỏng trong tình trạng nguy kịch.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="thực hành cấp cứu">
  <data key="d0">thực hành cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là công tác đánh giá, xử trí và điều trị cho bệnh nhân có bệnh lý, tổn thương hoặc rối loạn cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="đánh giá nhanh">
  <data key="d0">đánh giá nhanh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một hành động cần thiết để đưa ra quyết định chẩn đoán và xử trí khi thông tin chưa đầy đủ trong tình huống cấp cứu.&lt;SEP&gt;Là kỹ năng đánh giá nhanh bệnh nhân với lượng thông tin hạn chế và chưa đầy đủ</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="quyết định xử trí">
  <data key="d0">quyết định xử trí</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hành động đưa ra ngay sau khi tiếp cận bệnh nhân trong điều kiện thông tin hạn chế và thời gian ngắn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="môi trường làm việc">
  <data key="d0">môi trường làm việc</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là điều kiện làm việc tại khoa cấp cứu với áp lực cao do không gian mở, đông người và dòng người di chuyển nhanh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="cấp cứu trước khi đến viện">
  <data key="d0">cấp cứu trước khi đến viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hoạt động thực hiện ngoài trời, trong môi trường không có hỗ trợ y tế và có nguy cơ đối với nhân viên y tế.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="nhiều lo lắng và dễ bị phân tâm">
  <data key="d0">nhiều lo lắng và dễ bị phân tâm</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tình trạng nhân viên y tế phải xử lý nhiều việc hành chính, trật tự và phân luồng bệnh nhân, ảnh hưởng đến tập trung chuyên môn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="nhân viên y tế">
  <data key="d0">nhân viên y tế</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người tham gia công tác y tế, thường xuyên gặp áp lực từ công việc và bệnh nhân.&lt;SEP&gt;Là người thực hiện các nhiệm vụ quan sát, tổ chức làm việc và phân phối sức lực trong ca trực.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="áp lực công việc">
  <data key="d0">áp lực công việc</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là yếu tố làm ảnh hưởng đến khả năng tập trung và tuân thủ quy trình của nhân viên y tế.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="thăm khám và đánh giá tuần tự">
  <data key="d0">thăm khám và đánh giá tuần tự</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương pháp thực hiện khám bệnh theo trình tự từng bước, có thể không phù hợp với nhu cầu cấp cứu nhanh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="quá tải">
  <data key="d0">quá tải</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tình trạng khi lượng bệnh nhân vượt quá công suất hoạt động của khoa cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân bị bỏ sót">
  <data key="d0">bệnh nhân bị bỏ sót</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là hậu quả xảy ra khi bệnh nhân không được cấp cứu kịp thời hoặc không được thăm khám đầy đủ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="tính ưu tiên cấp cứu">
  <data key="d0">tính ưu tiên cấp cứu</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số xác định mức độ ưu tiên trong việc xử lý các bệnh nhân và các can thiệp y tế.&lt;SEP&gt;là yếu tố xác định thứ tự xử trí bệnh nhân và can thiệp trong khoa cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="140% công suất">
  <data key="d0">140% công suất</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là ngưỡng công suất hoạt động mà khi vượt quá sẽ dẫn đến nguy cơ bỏ sót bệnh nhân và sai sót trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="phân loại bệnh nhân">
  <data key="d0">phân loại bệnh nhân</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">là kỹ năng được rèn luyện để xác định mức độ cấp cứu và ưu tiên xử trí bệnh nhân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="xác nhận tử vong">
  <data key="d0">xác nhận tử vong</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">là bước thực hiện khi có bệnh nhân tử vong để xác định tình trạng ngừng tuần hoàn</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="nguy cơ lây bệnh">
  <data key="d0">nguy cơ lây bệnh</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">là yếu tố cần được đánh giá khi có bệnh nhân tử vong để đảm bảo an toàn cho nhân viên và người thân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="triage">
  <data key="d0">triage</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương pháp xác định bệnh nhân nào cần được thăm khám trước trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="tử vong nhanh chóng">
  <data key="d0">tử vong nhanh chóng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là hậu quả nghiêm trọng xảy ra khi bệnh nhân không được can thiệp kịp thời trong tình trạng nguy kịch.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="không cấp cứu">
  <data key="d0">không cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm bệnh nhân có tổn thương nhẹ, ít nguy cơ tiến triển nặng và không đe dọa tính mạng, được chờ khám sau khi bệnh nhân cấp cứu ổn định.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="ổn định bệnh nhân">
  <data key="d0">ổn định bệnh nhân</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước can thiệp đầu tiên nhằm đảm bảo các chức năng sống của bệnh nhân trước khi tiến hành thăm khám chi tiết.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="thăm khám">
  <data key="d0">thăm khám</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là quá trình đánh giá bệnh nhân qua hai bước tuần tự để đảm bảo đầy đủ và không bỏ sót tổn thương.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="primary survey">
  <data key="d0">primary survey</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước đầu tiên trong quá trình thăm khám, tập trung vào đánh giá và kiểm soát các chức năng sống của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="secondary survey">
  <data key="d0">secondary survey</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước tiếp theo trong quá trình thăm khám, thực hiện sau primary survey để đánh giá chi tiết các tổn thương.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="abcd">
  <data key="d0">abcd</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là trình tự đánh giá và kiểm soát các chức năng sống gồm đường thở, hô hấp, tuần hoàn và thần kinh.&lt;SEP&gt;Là trình tự đánh giá và xử trí trong thăm khám sơ bộ, bao gồm các bước về đường thở, hô hấp, tuần hoàn và thần kinh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1793457333</data>
  <data key="d6"></data>
</node>
<node id="tràn khí màng phổi áp lực">
  <data key="d0">tràn khí màng phổi áp lực</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là biến chứng xảy ra do tích tụ khí trong màng phổi, gây ảnh hưởng đến chức năng hô hấp và có thể đe dọa tính mạng.&lt;SEP&gt;Là một trong các nguyên nhân gây ngừng tuần hoàn thường gặp và có thể điều trị nhanh chóng.&lt;SEP&gt;biến chứng xảy ra khi khí tích tụ trong màng phổi gây áp lực, ảnh hưởng đến chức năng hô hấp&lt;SEP&gt;Là tình trạng bệnh lý do khí tích tụ trong màng phổi gây áp lực.&lt;SEP&gt;Là biến chứng xảy ra khi có khí tích tụ trong màng phổi do chấn thương ngực.&lt;SEP&gt;Một tình trạng bệnh lý xảy ra khi có khí tích tụ trong màng phổi, gây áp lực lên lồng ngực và ảnh hưởng đến hô hấp.&lt;SEP&gt;Một biến chứng xảy ra khi vết thương ngực hở không được xử trí kịp thời, dẫn đến khí tích tụ trong màng phổi.&lt;SEP&gt;Là hiện tượng tràn khí màng phổi áp lực do tổn thương thanh-khí-phế quản.&lt;SEP&gt;một yếu tố gây tắc nghẽn cơ học trong chấn thương&lt;SEP&gt;Là một tình trạng bệnh lý do chấn thương, có biểu hiện suy hô hấp và tụt huyết áp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-000&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-002&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-008&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-000&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="vết thương mạch máu">
  <data key="d0">vết thương mạch máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tổn thương làm ảnh hưởng đến mạch máu, có thể gây mất máu hoặc rối loạn tuần hoàn nghiêm trọng.&lt;SEP&gt;Là một dạng tổn thương có thể dẫn đến rối loạn chức năng tim mạch và gây ra các biến chứng nghiêm trọng trong quá trình cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="rối loạn toan/kiềm máu nặng">
  <data key="d0">rối loạn toan/kiềm máu nặng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng mất cân bằng pH máu do rối loạn chuyển hóa, ảnh hưởng đến chức năng cơ thể và có thể đe dọa tính mạng.&lt;SEP&gt;Là tình trạng mất cân bằng acid-base nghiêm trọng trong máu, có thể do tổn thương cơ quan hoặc thiếu oxy.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="rối loạn kali máu">
  <data key="d0">rối loạn kali máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng mất cân bằng nồng độ kali trong máu, ảnh hưởng đến chức năng cơ và tim, có thể gây nguy hiểm nếu không điều trị kịp thời.&lt;SEP&gt;Là tình trạng thay đổi nồng độ kali trong máu, ảnh hưởng đến chức năng tim và cơ bắp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="hạ">
  <data key="d0">hạ</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị chỉ số thể hiện mức độ giảm của một chỉ tiêu sinh học, thường liên quan đến huyết áp hoặc chức năng cơ thể.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="hạ đường máu">
  <data key="d0">hạ đường máu</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng nồng độ đường huyết thấp, có thể gây nguy hiểm cho chức năng thần kinh và tim mạch.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="khai thông đường thở">
  <data key="d0">khai thông đường thở</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật cấp cứu nhằm mở rộng đường thở để đảm bảo bệnh nhân có thể thở hiệu quả.&lt;SEP&gt;Là một thủ thuật cấp cứu nhằm đảm bảo oxy và thông khí đầy đủ cho bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="đặt nkq">
  <data key="d0">đặt nkq</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật đặt ống nội khí quản để duy trì đường thở trong tình trạng cấp cứu.&lt;SEP&gt;Thủ thuật đặt ống nội khí quản để duy trì đường thở trong tình trạng nguy kịch.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="bóp bóng">
  <data key="d0">bóp bóng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật sử dụng bóng để nén màng phổi hoặc màng ngoài tim nhằm giảm áp lực và ổn định chức năng tim.&lt;SEP&gt;Thủ thuật bóp bóng để duy trì tuần hoàn tạm thời trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1793454119</data>
  <data key="d6"></data>
</node>
<node id="thở ô xy">
  <data key="d0">thở ô xy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật cung cấp oxy cho bệnh nhân để cải thiện tình trạng hô hấp và giảm nguy cơ suy hô hấp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="đặt đường truyền tĩnh mạch">
  <data key="d0">đặt đường truyền tĩnh mạch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật đặt ống tĩnh mạch để truyền thuốc, dịch và chất dinh dưỡng vào cơ thể.&lt;SEP&gt;Thủ thuật đặt đường truyền tĩnh mạch để truyền dịch hoặc thuốc vào cơ thể.&lt;SEP&gt;Là kỹ thuật đặt đường truyền tĩnh mạch để duy trì tuần hoàn cho bệnh nhân bị bỏng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bồi phụ thể tích">
  <data key="d0">bồi phụ thể tích</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là quá trình bổ sung thể tích máu hoặc dịch để duy trì huyết áp và chức năng tuần hoàn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="cầm máu">
  <data key="d0">cầm máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật nhằm ngăn chặn chảy máu từ các tổn thương mạch máu.&lt;SEP&gt;Thủ thuật cầm máu bằng cách dùng băng ép, bất động chi gãy, hoặc garo.&lt;SEP&gt;Là kỹ thuật ngăn chặn chảy máu ở các vị trí tổn thương trong chấn thương.&lt;SEP&gt;Hành động sơ cứu khi có chảy máu ngoài, thực hiện bằng cách dùng băng ép hoặc garô.&lt;SEP&gt;Kỹ thuật cầm máu bằng băng ép hoặc garo được thực hiện để kiểm soát chảy máu trong chấn thương.&lt;SEP&gt;Là kỹ thuật xử trí trong trường hợp chảy máu, bao gồm dùng garô hoặc ép trực tiếp vào động mạch</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-001&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="chọc màng phổi">
  <data key="d0">chọc màng phổi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật chọc màng phổi để rút dịch hoặc chẩn đoán tình trạng viêm hoặc nhiễm trùng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="chọc dịch màng ngoài tim">
  <data key="d0">chọc dịch màng ngoài tim</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật chọc dịch trong màng ngoài tim để giảm áp lực và ổn định chức năng tim.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="sốc điện chuyển nhịp nhanh">
  <data key="d0">sốc điện chuyển nhịp nhanh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật sử dụng điện để điều chỉnh nhịp tim trong trường hợp rối loạn nhịp tim cấp tính.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="tiền sử">
  <data key="d0">tiền sử</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thông tin về bệnh sử và điều kiện sức khỏe trước đó của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="bệnh sử">
  <data key="d0">bệnh sử</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là thông tin chi tiết về các bệnh lý, triệu chứng và phản ứng trước đó của bệnh nhân.&lt;SEP&gt;Thông tin về yếu tố chấn thương được thu thập từ bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1793455017</data>
  <data key="d6"></data>
</node>
<node id="thuốc đang dùng">
  <data key="d0">thuốc đang dùng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là danh sách các thuốc mà bệnh nhân đang sử dụng trước khi cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="xét nghiệm nhanh">
  <data key="d0">xét nghiệm nhanh</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm được thực hiện nhanh để đánh giá tình trạng bệnh nhân trong thời gian cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="đánh giá đầy đủ các tổn thương">
  <data key="d0">đánh giá đầy đủ các tổn thương</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là mục tiêu nhằm xác định toàn bộ các tổn thương để lập kế hoạch điều trị phù hợp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
