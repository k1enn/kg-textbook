  <data key="d2">Quy trình phân loại bệnh nhân theo mức độ ưu tiên để tiếp nhận cấp cứu phù hợp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Bảng phân loại">
  <data key="d0">Bảng phân loại</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Các bảng phân loại khác nhau được sử dụng để phân loại bệnh nhân trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Tập trung cấp cứu">
  <data key="d0">Tập trung cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Hành động tập trung cấp cứu bệnh nhân nguy kịch hoặc cấp cứu cần được thực hiện ngay.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Đặt trong tầm mắt cảnh giới theo dõi">
  <data key="d0">Đặt trong tầm mắt cảnh giới theo dõi</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Hành động đặt bệnh nhân cấp cứu vào vùng theo dõi sát sao của nhân viên y tế.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Ổn định bệnh nhân">
  <data key="d0">Ổn định bệnh nhân</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Hành động đảm bảo tình trạng ổn định của bệnh nhân trước khi tiến hành thăm khám chi tiết.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Thăm khám">
  <data key="d0">Thăm khám</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Quy trình thăm khám bệnh nhân cấp cứu theo trình tự đảm bảo đầy đủ và không bỏ sót tổn thương.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="trung vào thăm khám chi tiết">
  <data key="d0">trung vào thăm khám chi tiết</data>
  <data key="d1">khac</data>
  <data key="d2">Là một hướng tiếp cận trong việc thăm khám bệnh nhân cấp cứu nhằm đảm bảo ổn định bệnh nhân và thực hiện thăm khám đầy đủ mà không bỏ sót tổn thương.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="tiến hành qua 2 bước">
  <data key="d0">tiến hành qua 2 bước</data>
  <data key="d1">khac</data>
  <data key="d2">Là phương pháp thăm khám bệnh nhân cấp cứu được chia thành hai cấp độ: bước 1 (primary survey) và bước 2 (secondary survey).</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="bước 1 (primary survey)">
  <data key="d0">bước 1 (primary survey)</data>
  <data key="d1">khac</data>
  <data key="d2">Là bước đầu tiên trong quá trình thăm khám bệnh nhân cấp cứu, nhằm nhận định và kiểm soát các chức năng sống.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="bước 2 (secondary survey)">
  <data key="d0">bước 2 (secondary survey)</data>
  <data key="d1">khac</data>
  <data key="d2">Là bước thứ hai trong quá trình thăm khám bệnh nhân cấp cứu, nhằm đánh giá đầy đủ các tổn thương và bệnh lý để lập kế hoạch xử trí.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nhận định và kiểm soát ổn định các chức năng sống">
  <data key="d0">nhận định và kiểm soát ổn định các chức năng sống</data>
  <data key="d1">khac</data>
  <data key="d2">Là mục tiêu của bước 1 (primary survey) trong quá trình thăm khám bệnh nhân cấp cứu, nhằm phát hiện và can thiệp ngay các rối loạn đe dọa chức năng sống.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="đường thở">
  <data key="d0">đường thở</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một chức năng sống cần được đánh giá và kiểm soát trong quá trình thăm khám bệnh nhân cấp cứu.&lt;SEP&gt;Một yếu tố được bảo vệ bằng việc đặt nội khí quản nếu cần trong xử trí chấn thương.&lt;SEP&gt;Là hệ thống đường dẫn khí từ miệng đến phổi, được đánh giá trong quá trình xử trí chấn thương.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-004&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="hô hấp">
  <data key="d0">hô hấp</data>
  <data key="d1">khac</data>
  <data key="d2">Là một chức năng sống cần được đánh giá và kiểm soát trong quá trình thăm khám bệnh nhân cấp cứu.&lt;SEP&gt;Một hệ thống cơ quan được thăm khám trong quá trình khám bệnh nhân cấp cứu.&lt;SEP&gt;Một chỉ số đánh giá chức năng hô hấp trong cơ thể.&lt;SEP&gt;Một nhóm chức năng sinh lý được hỗ trợ bằng bóp bóng ambu hoặc máy thở khi cần.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="tuần hoàn">
  <data key="d0">tuần hoàn</data>
  <data key="d1">khac</data>
  <data key="d2">Là một chức năng sống cần được đánh giá và kiểm soát trong quá trình thăm khám bệnh nhân cấp cứu.&lt;SEP&gt;Một nhóm chức năng sinh lý được hỗ trợ bằng băng ép cầm máu và hồi sức dịch.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="thần kinh">
  <data key="d0">thần kinh</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một chức năng sống cần được đánh giá và kiểm soát trong quá trình thăm khám bệnh nhân cấp cứu.&lt;SEP&gt;Một hệ thống cơ quan được thăm khám trong quá trình khám bệnh nhân cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="ABCD">
  <data key="d0">ABCD</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương pháp đánh giá và kiểm soát tuần tự bao gồm đường thở, hô hấp, tuần hoàn và thần kinh trong quá trình thăm khám bệnh nhân cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="tràn khí màng phổi áp lực">
  <data key="d0">tràn khí màng phổi áp lực</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một biến chứng có thể ảnh hưởng đến chức năng sống và cần được xử trí ngay trong quá trình thăm khám cấp cứu.&lt;SEP&gt;Biến chứng xảy ra khi khí tích tụ trong màng phổi gây áp lực, có thể dẫn đến ngừng tuần hoàn.&lt;SEP&gt;Là biến chứng xảy ra do chấn thương ngực gây ra khi có áp lực trong phổi.&lt;SEP&gt;Biến chứng xảy ra khi có tổn thương thanh-khí-phế quản và khí tích tụ trong màng phổi dưới áp lực.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-006&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="vết thương mạch máu">
  <data key="d0">vết thương mạch máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một tổn thương có thể ảnh hưởng đến chức năng sống và cần được xử trí ngay trong quá trình thăm khám cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="ép tim cấp do tràn dịch/máu màng ngoài tim">
  <data key="d0">ép tim cấp do tràn dịch/máu màng ngoài tim</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một rối loạn nghiêm trọng có thể ảnh hưởng đến chức năng sống và cần được xử trí ngay trong quá trình thăm khám cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="rối loạn toan/kiềm máu nặng">
  <data key="d0">rối loạn toan/kiềm máu nặng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một rối loạn nghiêm trọng ảnh hưởng đến chức năng sống và cần được xử trí ngay trong quá trình thăm khám cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="rối loạn kali máu">
  <data key="d0">rối loạn kali máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một rối loạn nghiêm trọng ảnh hưởng đến chức năng sống và cần được xử trí ngay trong quá trình thăm khám cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="hạ đường máu">
  <data key="d0">hạ đường máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một rối loạn nghiêm trọng ảnh hưởng đến chức năng sống và cần được xử trí ngay trong quá trình thăm khám cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="khai thông đường thở">
  <data key="d0">khai thông đường thở</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật cấp cứu được thực hiện để đảm bảo đường thở của bệnh nhân được mở rộng và duy trì.&lt;SEP&gt;Thủ thuật nhằm mở đường thở để đảm bảo thông khí cho bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="đặt NKQ">
  <data key="d0">đặt NKQ</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một thủ thuật cấp cứu được thực hiện để hỗ trợ hô hấp của bệnh nhân trong tình trạng cấp cứu.&lt;SEP&gt;Thủ thuật đặt ống nội khí quản để hỗ trợ hô hấp trong tình trạng sốc.&lt;SEP&gt;Một hành động đặt thiết bị hỗ trợ tuần hoàn để duy trì dòng máu trong tình trạng phân ly điện cơ.&lt;SEP&gt;Là một thao tác đặt ống nội khí quản để duy trì đường thở trong bệnh nhân chấn thương.&lt;SEP&gt;Là tình trạng bệnh nhân được đặt thuốc gây ngủ hoặc an thần, cần duy trì phương tiện bất động cột sống cổ.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-003&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1792919162</data>
  <data key="d6"></data>
</node>
<node id="bóp bóng">
  <data key="d0">bóp bóng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật cấp cứu được thực hiện để duy trì đường thở và hỗ trợ hô hấp của bệnh nhân.&lt;SEP&gt;Thủ thuật được phối hợp sử dụng trong cấp cứu nâng cao ngừng tuần hoàn để duy trì tuần hoàn.&lt;SEP&gt;Là một kỹ thuật hỗ trợ hô hấp bằng cách bóp bóng phổi trong bệnh nhân không có đường thở.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="thở ô xy">
  <data key="d0">thở ô xy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một can thiệp cấp cứu được thực hiện để cung cấp oxy cho bệnh nhân trong tình trạng thiếu oxy.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="đặt đường truyền tĩnh mạch">
  <data key="d0">đặt đường truyền tĩnh mạch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật cấp cứu được thực hiện để tạo đường truyền để truyền dịch hoặc thuốc vào cơ thể bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="bồi phụ thể tích">
  <data key="d0">bồi phụ thể tích</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một can thiệp cấp cứu được thực hiện để bù thể tích trong cơ thể bệnh nhân khi có mất máu hoặc mất dịch.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="cầm máu">
  <data key="d0">cầm máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một can thiệp cấp cứu được thực hiện để ngăn chặn chảy máu trong tình trạng cấp cứu.&lt;SEP&gt;Là thủ thuật cầm máu bằng băng ép, bất động chi gãy hoặc garo.&lt;SEP&gt;Thao tác cầm máu để ngăn ngừa mất máu trong chấn thương.&lt;SEP&gt;Là một biện pháp xử trí dùng để cầm máu khi có vết thương cắt cụt hoặc các vết thương khác bằng cách ép trực tiếp vào động mạch hoặc dùng băng đo HA bơm lên số HA tối đa.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="chọc màng phổi">
  <data key="d0">chọc màng phổi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật cấp cứu được thực hiện để xử trí tràn khí màng phổi hoặc tràn dịch màng phổi.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
