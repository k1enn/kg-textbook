  <data key="d0">phương pháp thăm khám</data>
  <data key="d1">khac</data>
  <data key="d2">Phương pháp thăm khám và đánh giá tuần tự, lần lượt từng quy trình có thể không phù hợp và chậm trễ trong cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="quá tải">
  <data key="d0">quá tải</data>
  <data key="d1">khac</data>
  <data key="d2">Khoa cấp cứu có nguy cơ bị quá tải dẫn đến bệnh nhân bị bỏ sót (ra viện mà chưa được xem)</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="lượng bệnh nhân">
  <data key="d0">lượng bệnh nhân</data>
  <data key="d1">khac</data>
  <data key="d2">Lượng bệnh nhân đến cấp cứu thay đổi theo thời điểm trong ngày, giữa các ngày trong tuần và giữa các mùa</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="kỹ năng phân loại">
  <data key="d0">kỹ năng phân loại</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ năng mà nhân viên cấp cứu cần rèn luyện để phân loại bệnh nhân và các công việc theo yêu cầu cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="tử vong">
  <data key="d0">tử vong</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh nhân ngừng tuần hoàn và không thể hồi phục, dẫn đến việc phải xử lý các vấn đề liên quan đến thông báo và tâm lý.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="xác nhận tử vong">
  <data key="d0">xác nhận tử vong</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước xử lý cần thực hiện khi có bệnh nhân tử vong, nhằm xác định chính xác tình trạng của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="tính ưu tiên cấp cứu">
  <data key="d0">tính ưu tiên cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nguyên tắc được áp dụng để xác định thứ tự xử trí giữa các bệnh nhân và các can thiệp trong khoa cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="quy trình phân loại">
  <data key="d0">quy trình phân loại</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là quy trình được triển khai để phân loại bệnh nhân và công việc theo mức độ ưu tiên trong cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="can thiệp điều trị">
  <data key="d0">can thiệp điều trị</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các can thiệp điều trị cần thiết được thực hiện để xử trí bệnh nhân cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
