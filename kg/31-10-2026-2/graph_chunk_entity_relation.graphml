  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng chóp tủy do tổn thương tủy sống vùng cùng cụt.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
