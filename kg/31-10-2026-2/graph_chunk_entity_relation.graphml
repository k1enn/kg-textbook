  <data key="d0">than hoạt</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc được dùng để hấp thụ chất độc trong đường tiêu hóa.&lt;SEP&gt;Là một loại thuốc được dùng để hấp thụ chất độc trong dạ dày và ruột.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
