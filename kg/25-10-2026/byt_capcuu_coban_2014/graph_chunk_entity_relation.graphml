  <data key="d0">đặt ngay tạo nhịp ngoài qua da</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một thủ thuật thực hiện để tạo nhịp tim ngoài cơ thể thông qua da trong tình trạng không có mạch cảnh.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
