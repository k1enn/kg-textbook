  <data key="d12">1792918589</data>
  <data key="d13"></data>
</edge>
<edge source="sốc điện" target="rung thất">
  <data key="d7">1.0</data>
  <data key="d8">Sốc điện được thực hiện ngay khi có chỉ định để xử trí rung thất.</data>
  <data key="d9">dieu_tri,loạn nhịp</data>
