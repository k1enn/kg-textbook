  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="gãy xương">
  <data key="d0">gãy xương</data>
  <data key="d1">benh</data>
  <data key="d2">Là biểu hiện vật lý khi có chấn thương nặng gây ra mất máu.&lt;SEP&gt;Là tình trạng tổn thương xương do chấn thương, có thể kèm theo gãy khớp hở.&lt;SEP&gt;Là tình trạng xương bị gãy do tác động lực, có thể là gãy kín, gãy hở, hoặc trật khớp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xét nghiệm công thức máu">
  <data key="d0">xét nghiệm công thức máu</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm dùng để đánh giá tình trạng mất máu và các chỉ số máu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="bicarbonate">
  <data key="d0">bicarbonate</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là chỉ số trong xét nghiệm máu dùng để đánh giá tình trạng mất máu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="lactat máu">
  <data key="d0">lactat máu</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là chỉ số trong xét nghiệm máu dùng để đánh giá tình trạng suy hô hấp hoặc mất máu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="xquang">
  <data key="d0">xquang</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là phương pháp chẩn đoán hình ảnh dùng để phát hiện chấn thương trong ngực, bụng hoặc khung chậu.&lt;SEP&gt;Xét nghiệm chẩn đoán hình ảnh dùng để đánh giá tình trạng bệnh nhân</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793021900</data>
  <data key="d6"></data>
</node>
<node id="cắt lớp vi tính">
  <data key="d0">cắt lớp vi tính</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là phương pháp chẩn đoán hình ảnh dùng để phát hiện chấn thương trong ngực, bụng hoặc khung chậu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
