<node id="thời gian từ khi chấn thương đến lúc vào viện">
  <data key="d0">thời gian từ khi chấn thương đến lúc vào viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là yếu tố được khai thác trong bệnh sử khi đánh giá chấn thương sọ não</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000</data>
