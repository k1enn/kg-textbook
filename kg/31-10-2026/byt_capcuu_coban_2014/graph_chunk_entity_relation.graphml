  <data key="d1">benh</data>
  <data key="d2">Là tình trạng nghiêm trọng khi các tạng trong ổ bụng bị đẩy ra ngoài do chấn thương.</data>
  <data key="d3">11-cap-cuu-chan-thuong-bung-chunk-001</data>
