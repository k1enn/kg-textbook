<node id="đáp ứng với điều trị">
  <data key="d0">đáp ứng với điều trị</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu cho thấy bệnh nhân phản ứng tích cực với liệu pháp điều trị hiện tại.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="không đáp ứng với điều trị">
  <data key="d0">không đáp ứng với điều trị</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu cho thấy bệnh nhân không có phản ứng nào với liệu pháp điều trị hiện tại.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="thăm dò">
  <data key="d0">thăm dò</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các xét nghiệm hoặc kiểm tra được thực hiện để loại trừ hoặc khẳng định chẩn đoán bệnh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="xét nghiệm">
  <data key="d0">xét nghiệm</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các phương pháp chẩn đoán được sử dụng để hỗ trợ định hướng chẩn đoán và quyết định điều trị.&lt;SEP&gt;Là các xét nghiệm được thực hiện để bổ sung đánh giá tổn thương trong chấn thương.&lt;SEP&gt;Các xét nghiệm được thực hiện để chẩn đoán và đánh giá tình trạng bệnh nhân trong quá trình xử trí.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="định hướng chuyển">
  <data key="d0">định hướng chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định về việc bệnh nhân sẽ được nhập viện, ra viện hoặc lưu theo dõi tại khoa cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="nhập viện">
  <data key="d0">nhập viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định đưa bệnh nhân vào khoa bệnh viện để tiếp tục điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="ra viện">
  <data key="d0">ra viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định cho bệnh nhân rời khỏi khoa cấp cứu và trở về nhà sau khi điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="lưu theo dõi">
  <data key="d0">lưu theo dõi</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định để bệnh nhân được giữ lại tại khoa cấp cứu để theo dõi tình trạng trong thời gian dài hơn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="thời gian vàng">
  <data key="d0">thời gian vàng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian nhất định trong đó can thiệp sớm có thể cải thiện tiên lượng bệnh tật hoặc cứu sống bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793016812</data>
  <data key="d6"></data>
</node>
<node id="ngừng tuần hoàn">
  <data key="d0">ngừng tuần hoàn</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d2">Thời gian vàng là khoảng thời gian tối ưu để can thiệp trong trường hợp ngừng tuần hoàn.&lt;SEP&gt;Tình trạng mất tuần hoàn máu đột ngột, được xác định bằng mất ý thức, ngừng thở và mất mạch cảnh.</data>
  <data key="d1">benh</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1793017791</data>
  <data key="d6"></data>
</node>
<node id="thượng vị nhanh">
  <data key="d0">thượng vị nhanh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là động tác đẩy cơ hoành lên trên gây tăng áp lực lồng ngực và tạo luồng khí mạnh tống dị vật ra khỏi đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="thủ thuật heimlich">
  <data key="d0">thủ thuật heimlich</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật ép bụng hoặc ép ngực để loại bỏ dị vật khỏi đường thở của bệnh nhân.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="hô hấp nhân tạo">
  <data key="d0">hô hấp nhân tạo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật hỗ trợ hô hấp cho bệnh nhân không thể tự thở được.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="động tác giật">
  <data key="d0">động tác giật</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là động tác ép nhanh và dứt khoát để giải phóng tắc nghẽn đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="vỗ lưng">
  <data key="d0">vỗ lưng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là động tác vỗ nhẹ và nhanh trên lưng trẻ nhỏ để tống dị vật ra khỏi đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="ép ngực">
  <data key="d0">ép ngực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là động tác ép lên ngực trẻ nhỏ để loại bỏ dị vật khi vỗ lưng không hiệu quả.&lt;SEP&gt;Là động tác tiếp theo được thực hiện khi vỗ lưng không hiệu quả để đẩy dị vật ra.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="dị vật">
  <data key="d0">dị vật</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là vật cản bị mắc trong đường thở gây tắc nghẽn hô hấp.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="đường thở">
  <data key="d0">đường thở</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hệ thống đường dẫn khí từ mũi và miệng đến phổi, cần được kiểm tra và đảm bảo thông suốt.&lt;SEP&gt;Là vùng cần được kiểm tra và làm sạch để đảm bảo thông thoáng khi xử lý dị vật.&lt;SEP&gt;Là hệ thống đường đi của không khí từ miệng đến phổi, cần được kiểm tra để đảm bảo không bị tắc nghẽn.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793019575</data>
  <data key="d6"></data>
</node>
<node id="tắc nghẽn">
  <data key="d0">tắc nghẽn</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng đường thở bị chặn do dị vật hoặc các yếu tố khác.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân hôn mê">
  <data key="d0">bệnh nhân hôn mê</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là người bệnh không có phản xạ, cần được xử trí bằng tư thế nằm ngửa và hỗ trợ hô hấp nhân tạo.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="chỉ động tác vỗ lưng">
  <data key="d0">chỉ động tác vỗ lưng</data>
  <data key="d1">khac</data>
  <data key="d2">Là động tác đầu tiên được thực hiện để tống dị vật ra khỏi trẻ nhỏ.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
  <data key="d6"></data>
</node>
<node id="trẻ nhỏ">
  <data key="d0">trẻ nhỏ</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhóm đối tượng được chỉ định để thực hiện các động tác vỗ lưng và ép ngực.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793017077</data>
