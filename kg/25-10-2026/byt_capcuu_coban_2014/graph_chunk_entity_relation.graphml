</edge>
<edge source="loại trừ dị vật thành công khi thấy" target="bệnh nhân thở rõ và nói được">
  <data key="d7">1.0</data>
  <data key="d8">Khi bệnh nhân thở rõ và nói được, thì được coi là đã loại trừ dị vật thành công.</data>
  <data key="d9">dieu_tri,loại trừ dị vật</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="loại trừ dị vật thành công khi thấy" target="bệnh nhân tỉnh hơn">
  <data key="d7">1.0</data>
  <data key="d8">Khi bệnh nhân trở về trạng thái tỉnh hơn, thì được coi là đã loại trừ dị vật thành công.</data>
  <data key="d9">dieu_tri,loại trừ dị vật</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
