  <data key="d0">dấu hiệu lâm sàng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Các dấu hiệu lâm sàng gợi ý chấn thương sọ não trên bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1793455017</data>
  <data key="d6"></data>
</node>
<node id="tai nạn giao thông">
  <data key="d0">tai nạn giao thông</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân dẫn đến tăng số trường hợp chấn thương sọ não tại Việt Nam.&lt;SEP&gt;Tai nạn giao thông là một cơ chế chấn thương có thể dẫn đến chấn thương sọ não.&lt;SEP&gt;Là nguyên nhân thường gặp dẫn đến chấn thương cột sống với tỷ lệ 48%&lt;SEP&gt;nguyên nhân phổ biến gây chấn thương ngực nặng</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-001&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-000&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-000</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
