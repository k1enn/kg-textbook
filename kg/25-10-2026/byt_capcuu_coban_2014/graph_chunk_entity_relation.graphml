</node>
<node id="thiếu oxy máu nặng kém đáp ứng với thở oxy">
  <data key="d0">thiếu oxy máu nặng kém đáp ứng với thở oxy</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d2">Là ngưỡng đảm bảo ô xy hóa máu trong điều trị suy hô hấp nặng không đáp ứng thở oxy.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
