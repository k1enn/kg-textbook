  <data key="d0">Hội chẩn chuyên khoa chấn thương</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-003</data>
  <data key="d2">Hội chẩn chuyên khoa chấn thương được thực hiện để xử trí hiệu quả chấn thương xương chậu.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
</node>
<node id="điều trị và theo dõi hội chứng tiêu cơ vân cấp">
  <data key="d0">điều trị và theo dõi hội chứng tiêu cơ vân cấp</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d2">Điều trị và theo dõi hội chứng tiêu cơ vân cấp là một phần trong xử trí hội chứng chèn ép khoang khi có biến chứng.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
</node>
<node id="Đắp gạc tẩm nước muối sinh lý vô khuẩn, băng kín">
  <data key="d0">Đắp gạc tẩm nước muối sinh lý vô khuẩn, băng kín</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d2">Việc đặt lại tư thế giải phẫu là bước trước để đắp gạc và băng kín</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
</node>
<node id="Bỏng">
  <data key="d0">Bỏng</data>
  <data key="d1">benh</data>
  <data key="d2">Một loại chấn thương trên da hay các mô khác xảy ra khi một vài hay tất cả các tế bào bị tiêu diệt bởi sức nóng, lạnh, điện, phóng xạ, hay các tác nhân hóa học khác.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Sức nóng">
  <data key="d0">Sức nóng</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một trong những nguyên nhân gây ra bỏng khi bệnh nhân tiếp xúc với dụng cụ chứa chất nóng bị vỡ, chất lỏng nóng, vật dụng nóng, hơi nóng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Hóa chất">
  <data key="d0">Hóa chất</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một trong những nguyên nhân gây ra bỏng khi bệnh nhân tiếp xúc với các loại hóa chất như acid, kiềm mạch hoặc iod, phospho dùng trong công nghiệp vôi tôi.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Điện">
  <data key="d0">Điện</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một trong những nguyên nhân gây ra bỏng do điện giật hoặc sét đánh.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Hít">
  <data key="d0">Hít</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một trong những nguyên nhân gây ra bỏng khi có các vụ nổ hoặc hít phải các hơi máy.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Phóng xạ">
  <data key="d0">Phóng xạ</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một trong những nguyên nhân gây ra bỏng do năng lượng phóng xạ hoặc các loại phóng xạ gây ra, thường gặp là 'bỏng mặt trời'.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Thần kinh">
  <data key="d0">Thần kinh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Tình trạng của bệnh nhân khi bị bỏng, biểu hiện là co giật.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Hô hấp">
  <data key="d0">Hô hấp</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Tình trạng hô hấp của bệnh nhân bị bỏng vùng mặt, cổ khi bị kẹt trong nhà cháy, dễ bị phù mặt cổ và các biến chứng đường hô hấp do hít phải khói, hơi, khí độc.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Tuần hoàn">
  <data key="d0">Tuần hoàn</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Tình trạng sốc khi bệnh nhân bị bỏng, thể hiện bằng mạch nhanh, huyết áp tụt, dấu hiệu giảm tưới máu.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Đầu">
  <data key="d0">Đầu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng với diện tích chiếm 9% theo phương pháp đánh giá của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Thân mình">
  <data key="d0">Thân mình</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng với diện tích chiếm trước 18% và sau 18% theo phương pháp đánh giá của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
