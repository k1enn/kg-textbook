  <data key="d1">thu_thuat</data>
  <data key="d2">Một thủ thuật được thực hiện để rửa da và niêm mạc khi bị ngộ độc hóa chất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="xà phòng">
  <data key="d0">xà phòng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một chất được dùng để rửa da và niêm mạc khi bị ngộ độc hóa chất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="rửa mắt">
  <data key="d0">rửa mắt</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một thủ thuật được thực hiện để xử lý khi chất độc bắn vào mắt.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nôn">
  <data key="d0">nôn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một phản xạ được kích thích để loại bỏ chất độc qua đường tiêu hóa.&lt;SEP&gt;Là một thủ thuật được thực hiện bằng cách kích thích phản xạ nôn để loại bỏ chất độc khỏi cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="axít">
  <data key="d0">axít</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một loại chất có thể gây ngộ độc khi tiếp xúc qua đường tiêu hóa.&lt;SEP&gt;Là một loại chất hóa học mạnh có thể gây ngộ độc khi tiếp xúc hoặc hấp thu qua đường tiêu hóa.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
