  <data key="d1">bien_chung</data>
  <data key="d2">Là biến chứng nghiêm trọng do chấn thương ngực gây ra, ảnh hưởng đến chức năng tim.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-001</data>
