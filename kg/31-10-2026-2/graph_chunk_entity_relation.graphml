  <data key="d0">lưu theo dõi</data>
  <data key="d1">khac</data>
  <data key="d2">Hành động để bệnh nhân được lưu lại theo dõi tại khoa cấp cứu khi chưa có quyết định rõ ràng</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-008</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân">
  <data key="d0">bệnh nhân</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhóm người được theo dõi và can thiệp trong điều trị cấp cứu&lt;SEP&gt;Dấu hiệu sống là một triệu chứng lâm sàng phản ánh tình trạng sinh tồn của bệnh nhân.&lt;SEP&gt;Metoprolol tartrat được dùng đường uống cho tất cả bệnh nhân ngoại trừ trường hợp chống chỉ định.&lt;SEP&gt;Cấp cứu ngoại viện được thực hiện cho bệnh nhân chấn thương.&lt;SEP&gt;Hồi sức được thực hiện để phục hồi chức năng cho bệnh nhân sau khi bỏng nặng.&lt;SEP&gt;Người được chuyển giữa các bệnh viện để tiếp nhận điều trị hồi sức tích cực hoặc kỹ thuật chuyên khoa cao hơn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-009&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="thời gian vàng">
  <data key="d0">thời gian vàng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Khoảng thời gian nhất định để can thiệp sớm nhằm cải thiện tiên lượng bệnh tật hoặc biến chứng</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="ngừng tuần hoàn">
  <data key="d0">ngừng tuần hoàn</data>
  <data key="d1">benh</data>
  <data key="d2">Trạng thái ngừng hoạt động của tim mạch trong cấp cứu&lt;SEP&gt;Tình trạng mất tuần hoàn đột ngột do thiếu máu hoặc thiếu oxy tại các cơ quan&lt;SEP&gt;Trạng thái bệnh nhân không cử động và không phản ứng khi được lay gọi.&lt;SEP&gt;Thiếu thể tích tuần hoàn là nguyên nhân gây ra tình trạng ngừng tuần hoàn.&lt;SEP&gt;Là tình trạng ngừng hoạt động tuần hoàn đột ngột, không dự đoán được.&lt;SEP&gt;Tình trạng ngừng hoạt động của hệ tuần hoàn, dẫn đến mất dòng máu đến các cơ quan.&lt;SEP&gt;Một tình trạng ngừng hoạt động của hệ tuần hoàn trong bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-009&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-003&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="sốc điện">
  <data key="d0">sốc điện</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Trạng thái rối loạn điện giải do mất cân bằng điện thế trong tim&lt;SEP&gt;Phương pháp sử dụng máy sốc điện để phục hồi nhịp tim.&lt;SEP&gt;Là một thủ thuật được thực hiện để phục hồi nhịp tim trong trường hợp ngừng tuần hoàn.&lt;SEP&gt;Thủ thuật cấp cứu phá rung thất để phục hồi tuần hoàn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-009&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-003&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1793454119</data>
  <data key="d6"></data>
</node>
