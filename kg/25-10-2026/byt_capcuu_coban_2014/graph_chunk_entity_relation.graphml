<node id="đau nhức tự nhiên khu trú ở vùng khoang bị chèn ép">
  <data key="d0">đau nhức tự nhiên khu trú ở vùng khoang bị chèn ép</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng đau dữ dội, dai dẳng tại vùng bị chèn ép, không đáp ứng với thuốc giảm đau.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
