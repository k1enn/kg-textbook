<node id="bình oxy">
  <data key="d0">bình oxy</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thiết bị cung cấp oxy cho bệnh nhân&lt;SEP&gt;Dịch truyền oxy đủ dùng trong thời gian 30 phút để hỗ trợ hô hấp cho bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
