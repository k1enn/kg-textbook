  <data key="d7">1.0</data>
  <data key="d8">Sử dụng thuốc tiêu sợi huyết là can thiệp điều trị sớm trong hội chứng động mạch vành cấp.</data>
  <data key="d9">can thiệp sớm,nguyen_nhan_cua</data>
