<node id="vận chuyển bệnh nhân">
  <data key="d0">vận chuyển bệnh nhân</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hành động di dời bệnh nhân từ một nơi sang nơi khác trong điều kiện cấp cứu.&lt;SEP&gt;Là tình trạng bệnh nhân cần được vận chuyển trong hoặc giữa các bệnh viện do nhu cầu điều trị và hồi sức tích cực</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tư thế thích hợp">
  <data key="d0">tư thế thích hợp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là vị trí được thiết lập để đảm bảo an toàn cho bệnh nhân khi di chuyển trong quá trình cấp cứu.&lt;SEP&gt;Bệnh nhân tỉnh có khả năng tự lựa chọn tư thế phù hợp để cảm thấy dễ chịu.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="phủ kín, phủ ấm">
  <data key="d0">phủ kín, phủ ấm</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động che phủ bệnh nhân để giữ nhiệt và đảm bảo an toàn trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="an toàn">
  <data key="d0">an toàn</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là điều kiện cần thiết để đảm bảo không xảy ra chấn thương cho bệnh nhân và nhân viên trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="môi trường xung quanh">
  <data key="d0">môi trường xung quanh</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là môi trường xung quanh có thể làm tổn thương đến sự an toàn của bệnh nhân và nhân viên cứu hộ</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nguyên tắc nâng - khiêng">
  <data key="d0">nguyên tắc nâng - khiêng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hai nguyên tắc cơ bản về nâng và khiêng khi vận chuyển bệnh nhân</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="đánh giá tình hình">
  <data key="d0">đánh giá tình hình</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là việc đánh giá tình hình để đảm bảo nhân viên cứu hộ có thể nâng bệnh nhân và vượt qua tình huống khó khăn</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="sử dụng các phương tiện">
  <data key="d0">sử dụng các phương tiện</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là việc sử dụng các phương tiện hỗ trợ trong quá trình nâng - khiêng bệnh nhân</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="trọng lượng">
  <data key="d0">trọng lượng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là lượng tối đa mà một người có thể nâng được, phụ thuộc vào tuổi, giới, khối cơ và hoàn cảnh thực tế.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="vuông góc">
  <data key="d0">vuông góc</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là việc giữ vai vuông góc với khung chậu khi nâng bệnh nhân để đảm bảo sự ổn định và giảm nguy cơ chấn thương.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="giữ thẳng">
  <data key="d0">giữ thẳng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động giữ lưng thẳng và đầu gối thẳng khi nâng bệnh nhân để phân bố lực đều và tránh tổn thương cơ.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="phân bố trọng lượng">
  <data key="d0">phân bố trọng lượng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là việc phân bố trọng lượng bệnh nhân đều lên hai chân khi nâng để đảm bảo sự cân bằng và an toàn.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="khiêng cáng">
  <data key="d0">khiêng cáng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là tình huống khi nhân viên y tế cần vận chuyển bệnh nhân bằng cách sử dụng cáng hoặc ván khiêng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="thiết bị đi kèm">
  <data key="d0">thiết bị đi kèm</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là các thiết bị đi kèm như cáng, võng, bình oxy mà nhân viên y tế cần nâng khi vận chuyển bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="phối hợp">
  <data key="d0">phối hợp</data>
  <data key="d1">khac</data>
  <data key="d2">Việc phối hợp chặt chẽ với đồng nghiệp giúp duy trì sự ổn định khi vận chuyển bệnh nhân trên địa hình không bằng phẳng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="trở ngại khác">
  <data key="d0">trở ngại khác</data>
  <data key="d1">khac</data>
  <data key="d2">Là một tình huống hoặc yếu tố gây khó khăn không được cụ thể hóa trong văn bản</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nâng bệnh nhân">
  <data key="d0">nâng bệnh nhân</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hoạt động thực hiện nhằm hỗ trợ bệnh nhân trong quá trình di chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
