  <data key="d1">khac</data>
  <data key="d2">Là động tác đầu tiên được thực hiện để tống dị vật ra khỏi trẻ nhỏ.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
