  <data key="d0">tổn thương cấu trúc</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân có thể gây ra suy giảm ý thức trong khám toàn diện.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-003</data>
