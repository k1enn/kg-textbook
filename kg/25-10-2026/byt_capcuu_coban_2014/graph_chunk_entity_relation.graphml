  <data key="d0">xét nghiệp cần thiết khác</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các xét nghiệm hình ảnh hoặc chẩn đoán khác cần thiết để đánh giá bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="chuyển phẫu thuật càng sớm càng tốt">
  <data key="d0">chuyển phẫu thuật càng sớm càng tốt</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một nguyên tắc thực hiện để chuyển bệnh nhân đến phòng phẫu thuật sớm khi có chỉ định.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
