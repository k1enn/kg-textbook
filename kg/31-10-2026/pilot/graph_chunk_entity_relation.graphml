<graph edgedefault="undirected"><node id="xét nghiệm">
  <data key="d0">xét nghiệm</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các phương pháp chẩn đoán được sử dụng để đánh giá tình trạng bệnh nhân&lt;SEP&gt;Là các phương pháp chẩn đoán được sử dụng để hỗ trợ định hướng chẩn đoán bệnh nhân&lt;SEP&gt;Một phương pháp chẩn đoán được sử dụng để loại trừ hoặc khẳng định chẩn đoán.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="nguy kịch">
  <data key="d0">nguy kịch</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương hoặc rối loạn đe dọa tính mạng, có nguy cơ tử vong nhanh nếu không được can thiệp cấp cứu ngay&lt;SEP&gt;Là tình trạng bệnh lý đe dọa tính mạng với nguy cơ tử vong nhanh nếu không can thiệp cấp cứu ngay</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="cấp cứu">
  <data key="d0">cấp cứu</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương hoặc rối loạn có thể tiến triển nặng nếu không được can thiệp điều trị nhanh chóng&lt;SEP&gt;Là tình trạng bệnh lý có thể tiến triển nặng nếu không được can thiệp điều trị nhanh chóng&lt;SEP&gt;Một tình trạng bệnh lý được ưu tiên trong chẩn đoán và xử trí cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="không cấp cứu">
  <data key="d0">không cấp cứu</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý ít có khả năng tiến triển nặng và không đe dọa tính mạng</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="triage">
  <data key="d0">triage</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quy trình xác định bệnh nhân cần được thăm khám trước trong cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="ổn định bệnh nhân">
  <data key="d0">ổn định bệnh nhân</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các can thiệp được thực hiện để đảm bảo bệnh nhân được ổn định trước khi thăm khám chi tiết</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="primary survey">
  <data key="d0">primary survey</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước đầu tiên trong quá trình thăm khám, tập trung vào việc nhận định và kiểm soát các chức năng sống cơ bản như đường thở, hô hấp, tuần hoàn và thần kinh.&lt;SEP&gt;Là bước đầu tiên trong quá trình thăm khám bệnh nhân cấp cứu nhằm đảm bảo ổn định</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="secondary survey">
  <data key="d0">secondary survey</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước thứ hai trong quá trình thăm khám, nhằm đánh giá đầy đủ các tổn thương, rối loạn và bệnh lý để lập kế hoạch điều trị phù hợp.&lt;SEP&gt;Là bước thứ hai trong quá trình thăm khám bệnh nhân cấp cứu sau khi ổn định</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="abcd">
  <data key="d0">abcd</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là trình tự đánh giá và kiểm soát các chức năng sống cơ bản theo thứ tự: đường thở, hô hấp, tuần hoàn và thần kinh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="ngực">
  <data key="d0">ngực</data>
  <data key="d1">khac</data>
  <data key="d2">Một bộ phận cơ thể được thăm khám trong quá trình khám bệnh toàn diện.</data>
