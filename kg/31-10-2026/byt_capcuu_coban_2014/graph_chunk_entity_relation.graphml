<node id="hội chứng thần kinh phó giao cảm">
  <data key="d0">hội chứng thần kinh phó giao cảm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là hội chứng bao gồm hạ huyết áp, mạch giảm, thân nhiệt giảm, đồng tử co, giảm vận động co bóp, phản xạ gân xương cơ giảm, bệnh nhân lơ mơ và hôn mê.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-004</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
