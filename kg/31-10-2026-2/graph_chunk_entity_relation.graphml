<node id="dịch nahco3">
  <data key="d0">dịch nahco3</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại dịch được sử dụng trong điều trị ngộ độc quinidine và thuốc chống trầm cảm tricyclic.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
