  <data key="d1">thu_thuat</data>
  <data key="d2">Một thủ thuật cấp cứu được thực hiện khi có tràn dịch hoặc tràn khí màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
