  <data key="d0">truyền máu và các chế phẩm máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật truyền máu và các chế phẩm máu khi cần thiết</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
