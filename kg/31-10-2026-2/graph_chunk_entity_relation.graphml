  <data key="d0">rạch cân cơ giảm áp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được thực hiện để giảm áp lực trong khoang cơ sau chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
