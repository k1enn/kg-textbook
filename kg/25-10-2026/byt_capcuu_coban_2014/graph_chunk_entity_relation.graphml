</edge>
<edge source="dùng đèn soi thanh quản và lấy dị vật bằng kẹp Margill" target="mở khí quản qua màng nhẫn giáp">
  <data key="d7">1.0</data>
  <data key="d8">Các kỹ thuật nâng cao như dùng đèn soi và kẹp Margill, mở khí quản qua màng nhẫn giáp nhằm phòng ngừa biến chứng đường thở.</data>
  <data key="d9">kỹ thuật nâng cao,phong_ngua</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="mở khí quản qua màng nhẫn giáp" target="mở khí quản qua da">
  <data key="d7">1.0</data>
  <data key="d8">Các kỹ thuật mở khí quản qua màng nhẫn giáp và qua da là các biện pháp nâng cao nhằm phòng ngừa biến chứng đường thở.</data>
  <data key="d9">kỹ thuật nâng cao,phong_ngua</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
