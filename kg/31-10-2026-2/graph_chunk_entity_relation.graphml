  <data key="d0">dấu hiệu sống</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng cần được theo dõi để đánh giá tình trạng sinh tồn của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010</data>
