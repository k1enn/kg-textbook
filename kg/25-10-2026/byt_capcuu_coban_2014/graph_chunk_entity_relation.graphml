  <data key="d1">thu_thuat</data>
  <data key="d2">Là một nhóm biện pháp nhằm duy trì chức năng hô hấp của bệnh nhân trong tình trạng chấn thương.&lt;SEP&gt;Là thủ thuật hỗ trợ hô hấp bằng thông khí nhân tạo xâm nhập hoặc không xâm nhập.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-004&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="oxy liệu pháp">
  <data key="d0">oxy liệu pháp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một phương pháp hỗ trợ hô hấp bằng việc cung cấp oxy cho bệnh nhân.&lt;SEP&gt;Là phương pháp điều trị bằng việc cung cấp oxy qua kính mũi hoặc mặt nạ.&lt;SEP&gt;Là phương pháp hỗ trợ hô hấp bằng cung cấp oxy cho bệnh nhân.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="thở máy xâm nhập">
  <data key="d0">thở máy xâm nhập</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một phương pháp hỗ trợ hô hấp bằng thiết bị thở máy xâm nhập vào đường thở.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="không xâm nhập">
  <data key="d0">không xâm nhập</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một phương pháp hỗ trợ hô hấp không cần xâm nhập vào đường thở.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="CO2 35-45 mmHg">
  <data key="d0">CO2 35-45 mmHg</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một chỉ số kiểm soát nồng độ CO2 trong máu nhằm đảm bảo chức năng hô hấp ổn định.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="hỗ trợ tuần hoàn">
  <data key="d0">hỗ trợ tuần hoàn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một nhóm biện pháp nhằm duy trì tuần hoàn máu trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-004</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="đặt đường truyền">
  <data key="d0">đặt đường truyền</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thao tác thiết lập đường truyền để truyền dịch hoặc thuốc cho bệnh nhân.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="truyền dịch tinh thể">
  <data key="d0">truyền dịch tinh thể</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại dịch truyền được sử dụng để hỗ trợ tuần hoàn trong bệnh nhân chấn thương.&lt;SEP&gt;Là thuốc truyền để bù lượng tuần hoàn trong trường hợp sốc.&lt;SEP&gt;Là phương pháp truyền dịch được sử dụng trong xử trí cấp cứu cho bệnh nhân tràn máu màng phổi nhiều.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="duy trì huyết áp">
  <data key="d0">duy trì huyết áp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một mục tiêu nhằm duy trì huyết áp ổn định trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="kiểm soát chảy máu">
  <data key="d0">kiểm soát chảy máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một biện pháp thực hiện để ngăn ngừa và kiểm soát chảy máu trong bệnh nhân chấn thương.&lt;SEP&gt;Là thủ thuật thực hiện bằng băng ép, bất động chi gãy hoặc garo để cầm máu.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="băng ép">
  <data key="d0">băng ép</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một biện pháp hỗ trợ nhằm kiểm soát chảy máu và ổn định tổn thương tại chỗ.&lt;SEP&gt;Kỹ thuật dùng để cầm máu và cố định vùng tổn thương khi gãy xương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-002</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
</node>
<node id="nẹp">
  <data key="d0">nẹp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thiết bị dùng để cố định và bảo vệ cột sống hoặc xương trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="duy trì HA tâm thu &gt; 90 mmHg">
  <data key="d0">duy trì HA tâm thu &gt; 90 mmHg</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một chỉ số yêu cầu để duy trì huyết áp tâm thu trên 90 mmHg trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="khám thần kinh">
  <data key="d0">khám thần kinh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một bước đánh giá chức năng thần kinh của bệnh nhân trong tình trạng chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="đồng tử">
  <data key="d0">đồng tử</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng đánh giá chức năng thần kinh của bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
