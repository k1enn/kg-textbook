  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="một người hô hấp nhân tạo và ép tim" target="một người làm nghiệm pháp">
  <data key="d7">1.0</data>
  <data key="d8">Trong nhóm hai người, một người thực hiện hô hấp nhân tạo và ép tim, một người thực hiện nghiệm pháp.</data>
  <data key="d9">phân_chia_nhiệm_vụ</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
