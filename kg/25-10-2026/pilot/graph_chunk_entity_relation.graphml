</node>
<node id="ép tim cấp do tràn dịch/máu màng ngoài tim">
  <data key="d0">ép tim cấp do tràn dịch/máu màng ngoài tim</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tình trạng tim bị ép do dịch hoặc máu tích tụ trong màng ngoài tim.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
