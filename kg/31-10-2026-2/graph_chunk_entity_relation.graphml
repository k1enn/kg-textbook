  <data key="d0">kê chân cao</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là góc độ kê chân khi vận chuyển bệnh nhân có tổn thương chi dưới.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
