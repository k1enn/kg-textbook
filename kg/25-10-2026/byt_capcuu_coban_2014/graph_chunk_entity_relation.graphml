<node id="D penicilamin">
  <data key="d0">D penicilamin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong điều trị ngộ độc chì.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="huyết thanh kháng nọc các loại rắn">
  <data key="d0">huyết thanh kháng nọc các loại rắn</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong điều trị ngộ độc từ nọc rắn như hổ chúa, hổ mang, cạp nia, lục tre, choàm quạp.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="giải độc qua tương tác hoá học">
  <data key="d0">giải độc qua tương tác hoá học</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một cơ chế tác dụng của thuốc giải độc thông qua phản ứng hóa học với độc chất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="giải độc qua tác dụng dược lý">
  <data key="d0">giải độc qua tác dụng dược lý</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một cơ chế tác dụng của thuốc giải độc thông qua tác động sinh học trên cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="cạnh tranh thể cảm thụ">
  <data key="d0">cạnh tranh thể cảm thụ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một cơ chế giải độc bằng cách cạnh tranh với độc chất tại các thụ thể trên tế bào.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="đối kháng tác dụng">
  <data key="d0">đối kháng tác dụng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một cơ chế giải độc bằng cách phản ứng trực tiếp với tác dụng độc hại của chất độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="phục hồi chức năng bình thường">
  <data key="d0">phục hồi chức năng bình thường</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một cơ chế giải độc nhằm phục hồi chức năng bình thường của các cơ quan bị ảnh hưởng.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="liều lượng">
  <data key="d0">liều lượng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là lượng thuốc được sử dụng trong điều trị, cần được xác định phù hợp cho từng bệnh nhân.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="người khỏe mạnh bình thường">
  <data key="d0">người khỏe mạnh bình thường</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm đối tượng được dùng để tham khảo khi xác định liều lượng thuốc giải độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="người bệnh">
  <data key="d0">người bệnh</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là đối tượng bị ngộ độc và cần được điều trị bằng thuốc giải độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="phác đồ điều trị cụ thể">
  <data key="d0">phác đồ điều trị cụ thể</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là kế hoạch điều trị được kiểm chứng qua lâm sàng, áp dụng cho từng loại ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="huyết học">
  <data key="d0">huyết học</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một lĩnh vực y học cần được điều trị trong quá trình hồi sức toàn diện.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="nước điện giải">
  <data key="d0">nước điện giải</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một yếu tố cần được hỗ trợ trong quá trình điều trị triệu chứng và hồi sức.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="viêm cơ tim nhiễm độc">
