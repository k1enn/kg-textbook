  <data key="d0">tràn máu ổ bụng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Biến chứng do tổn thương cột sống, được phát hiện bằng siêu âm.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="xử trí cấp cứu tại khoa cấp cứu">
  <data key="d0">xử trí cấp cứu tại khoa cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật thực hiện ngay tại khoa cấp cứu để xử trí chấn thương cột sống.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="bất động cột sống cổ">
  <data key="d0">bất động cột sống cổ</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Thủ thuật được thực hiện trong mọi trường hợp chấn thương để tránh tổn thương cột sống cổ.&lt;SEP&gt;Là biện pháp được thực hiện để bảo vệ cột sống cổ trong quá trình xử trí cấp cứu.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="mở khí quản cấp cứu qua màng">
  <data key="d0">mở khí quản cấp cứu qua màng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật được thực hiện để mở đường thở trong tình trạng cấp cứu.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="thở">
  <data key="d0">thở</data>
  <data key="d1">khac</data>
  <data key="d2">Hoạt động hỗ trợ trong xử trí cấp cứu, bao gồm việc bảo đảm cột sống bất động, đặt nội khí quản, và mở khí quản nếu cần.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
