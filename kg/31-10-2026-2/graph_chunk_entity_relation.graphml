  <data key="d0">dồn trọng lượng cơ thể</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động tập trung trọng lượng lên bàn chân hoặc phía sau cơ thể khi nâng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="hướng dẫn khiêng an toàn">
  <data key="d0">hướng dẫn khiêng an toàn</data>
  <data key="d1">khac</data>
  <data key="d2">Là các nguyên tắc được đề ra để thực hiện việc khiêng bệnh nhân một cách an toàn</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="kéo">
  <data key="d0">kéo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật di dời bệnh nhân bằng cách kéo theo hướng thẳng trục với cơ thể và giữ trọng lực gần với cơ thể&lt;SEP&gt;Là hành động sử dụng lực kéo để di chuyển vật nặng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="đẩy">
  <data key="d0">đẩy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật di dời bệnh nhân bằng cách phát ra lực đẩy từ khoảng giữa vai và thắt lưng, hoặc quỳ gối và đẩy khi trọng lượng cần đẩy ở thấp&lt;SEP&gt;Là hành động sử dụng lực đẩy để di chuyển vật nặng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tránh xoay vặn">
  <data key="d0">tránh xoay vặn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động tránh việc xoay hoặc vặn cơ thể khi tiếp cận bệnh nhân</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tránh quá ưỡn lưng">
  <data key="d0">tránh quá ưỡn lưng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động tránh việc ưỡn lưng quá mức khi nâng vật nặng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tránh vươn quá xa">
  <data key="d0">tránh vươn quá xa</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động tránh việc vươn tay quá xa khi đỡ vật nặng có kích thước lớn</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="quyết định vận chuyển">
  <data key="d0">quyết định vận chuyển</data>
  <data key="d1">khac</data>
  <data key="d2">Là quyết định phải được đánh giá kỹ lưỡng giữa lợi ích và nguy cơ của việc vận chuyển bệnh nhân</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nhân viên vận chuyển">
  <data key="d0">nhân viên vận chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là đội ngũ nhân viên được đào tạo để xử lý các tình huống phát sinh trong quá trình vận chuyển bệnh nhân&lt;SEP&gt;Nhóm người tham gia vào quá trình vận chuyển bệnh nhân, bao gồm y tá hồi sức cấp cứu, y tá chuyên về vận chuyển và người phụ như kỹ thuật viên hoặc y tá thường.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="phương tiện vận chuyển">
  <data key="d0">phương tiện vận chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là phương tiện được lựa chọn để đáp ứng các diễn biến trong quá trình vận chuyển bệnh nhân</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="đội vận chuyển chuyên nghiệp">
  <data key="d0">đội vận chuyển chuyên nghiệp</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm nhân viên được trang bị chuyên môn để thực hiện việc vận chuyển bệnh nhân trong bệnh viện</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
