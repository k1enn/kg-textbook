  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng mạch một nửa thân mình giảm hoặc mất trong bệnh nhân dập vỡ động mạch chủ.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
