<edge source="thủ thuật Heimlich" target="ép ngực">
  <data key="d7">1.0</data>
  <data key="d8">Ép ngực là kỹ thuật được thực hiện sau khi vỗ lưng không hiệu quả để loại bỏ dị vật ở trẻ nhỏ.</data>
  <data key="d9">kỹ thuật cho trẻ nhỏ,phan_biet_voi</data>
