  <data key="d0">tác dụng: giảm đau bụng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một hiệu quả của tư thế nằm ngửa, đùi gấp trong xử trí chấn thương bụng.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
