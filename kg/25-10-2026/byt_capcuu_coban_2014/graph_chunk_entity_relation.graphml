  <data key="d0">thương tổn của các tạng trong khoang</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là hậu quả nghiêm trọng xảy ra khi tình trạng chèn ép kéo dài trong khoang giải phẫu.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
