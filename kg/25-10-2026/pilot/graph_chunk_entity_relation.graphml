  <data key="d5">1792917436</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp cấp">
  <data key="d0">suy hô hấp cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là một cấp cứu nội khoa xảy ra khi hệ thống hô hấp không thể đáp ứng được nhu cầu chuyển hóa của cơ thể.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thiếu ô xy máu">
  <data key="d0">thiếu ô xy máu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Xuất hiện khi PaO2 ≤ 50-60mmHg, là dấu hiệu của suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tăng CO2 máu">
  <data key="d0">tăng CO2 máu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Xuất hiện khi PaCO2 ≥ 50 mmHg kèm theo tình trạng toan máu pH &lt; 7,36.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thể hỗn hợp">
  <data key="d0">thể hỗn hợp</data>
  <data key="d1">benh</data>
  <data key="d2">Là dạng suy hô hấp vừa có giảm ô xy hóa máu và tăng CO2 máu, thường gặp trên bệnh nhân nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tím">
  <data key="d0">tím</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Xuất hiện khi Hb khử &gt; 5g/dL, là biểu hiện của suy hô hấp nặng, có thể xuất hiện từ môi đến toàn thân.&lt;SEP&gt;Là một triệu chứng lâm sàng xuất hiện khi PaO2 &lt; 45 mmHg, đặc biệt trong tình trạng thiếu máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="vã mồ hôi">
  <data key="d0">vã mồ hôi</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng thường xuất hiện khi bệnh nhân có suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="rối loạn tim mạch">
  <data key="d0">rối loạn tim mạch</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Gồm mạch nhanh, rối loạn nhịp, huyết áp tăng hoặc tụt, thường kết hợp với các triệu chứng suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="rối loạn thần kinh và ý thức">
  <data key="d0">rối loạn thần kinh và ý thức</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng nặng của suy hô hấp, bao gồm lo lắng, vật vã, ngủ gà, lờ đờ hoặc hôn mê.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="PaO2 ≤ 50-60mmHg">
  <data key="d0">PaO2 ≤ 50-60mmHg</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là ngưỡng xác định khi có thiếu ô xy máu trong suy hô hấp cấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="PaCO2 ≥ 50 mmHg">
  <data key="d0">PaCO2 ≥ 50 mmHg</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là ngưỡng xác định khi có tăng CO2 máu trong suy hô hấp cấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="pH &lt; 7,36">
  <data key="d0">pH &lt; 7,36</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số xác định tình trạng toan máu trong suy hô hấp cấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="khó thở nhanh">
  <data key="d0">khó thở nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dạng của khó thở với nhịp thở nhanh hơn 25 lần/phút.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="loạn nhịp thở">
  <data key="d0">loạn nhịp thở</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là hiện tượng rối loạn nhịp thở như Kussmaul, Cheyne - Stockes.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="mạch nhanh">
  <data key="d0">mạch nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng trong rối loạn tim mạch do suy hô hấp.&lt;SEP&gt;Là một triệu chứng lâm sàng xuất hiện khi đã có suy hô hấp nặng và rối loạn trao đổi khí nghiêm trọng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="rung nhĩ">
  <data key="d0">rung nhĩ</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dạng rối loạn nhịp tim thường xuất hiện trong bệnh nhân suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="cơn nhịp nhanh trên thất">
  <data key="d0">cơn nhịp nhanh trên thất</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dạng rối loạn nhịp tim có thể xuất hiện trong bệnh nhân suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="rung thất">
  <data key="d0">rung thất</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dạng rối loạn nhịp tim có thể xuất hiện trong bệnh nhân suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="huyết áp tăng">
  <data key="d0">huyết áp tăng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là hiện tượng huyết áp tăng trong bệnh nhân suy hô hấp, có thể nặng đến tụt huyết áp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="thở nhanh">
  <data key="d0">thở nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng xuất hiện khi đã có suy hô hấp nặng và rối loạn trao đổi khí nghiêm trọng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tăng huyết áp">
  <data key="d0">tăng huyết áp</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng có thể xuất hiện khi saO2 đã giảm rất thấp dưới 70-80%.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="PaO2 &lt; 45 mmHg">
  <data key="d0">PaO2 &lt; 45 mmHg</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là ngưỡng giá trị của PaO2 khi tím có thể xuất hiện, đặc biệt trong tình trạng thiếu máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="câu ngắn">
  <data key="d0">câu ngắn</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là biểu hiện của khả năng nói giảm khi mức độ suy hô hấp tăng lên.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tím ++">
  <data key="d0">tím ++</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là mức độ tăng của triệu chứng tím trong tình trạng suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tím +++">
  <data key="d0">tím +++</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là mức độ tăng cao của triệu chứng tím trong tình trạng suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="vã mồ hôi ++">
  <data key="d0">vã mồ hôi ++</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là mức độ tăng của triệu chứng vã mồ hôi trong tình trạng suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="vã mồ hôi +++">
  <data key="d0">vã mồ hôi +++</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là mức độ tăng cao của triệu chứng vã mồ hôi trong tình trạng suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="HA bình thường">
  <data key="d0">HA bình thường</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là trạng thái huyết áp bình thường trong tình trạng suy hô hấp nhẹ.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="COPD">
  <data key="d0">COPD</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là bệnh nền thường đi kèm với các đợt cấp gây suy hô hấp.&lt;SEP&gt;Là một yếu tố nguy cơ bệnh nền có thể làm tăng nguy cơ phát triển suy hô hấp.&lt;SEP&gt;Là yếu tố nguy cơ làm tăng nguy cơ suy hô hấp.&lt;SEP&gt;Bệnh lý hô hấp mãn tính do co thắt phế quản, thường cần hỗ trợ thông khí và thuốc giãn phế quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hen phế quản">
  <data key="d0">hen phế quản</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân có thể dẫn đến suy hô hấp khi có tiền sử bệnh lý.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="bệnh lý tim mạch">
  <data key="d0">bệnh lý tim mạch</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân có thể dẫn đến suy hô hấp khi có tiền sử bệnh lý.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="co kéo cơ hô hấp">
  <data key="d0">co kéo cơ hô hấp</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng do cơ hô hấp bị co thắt, có tiếng rít, khó thở thanh quản, ran rít.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="biên độ thở yếu">
  <data key="d0">biên độ thở yếu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng do nhược cơ hoặc mệt cơ, có thể xảy ra trong suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="đau ngực">
  <data key="d0">đau ngực</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng do tràn khí màng phổi, nhồi máu phổi, viêm màng phổi hoặc nhồi máu cơ tim.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="sốt">
  <data key="d0">sốt</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng do nhiễm trùng, có thể xuất hiện trong viêm phổi hoặc viêm phế quản.&lt;SEP&gt;Là triệu chứng lâm sàng xuất hiện trong viêm phổi và bệnh phổi tắc nghẽn mạn tính.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ran ẩm">
  <data key="d0">ran ẩm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng khi khám phổi, có thể xuất hiện trong tình trạng suy hô hấp.&lt;SEP&gt;Là dấu hiệu lâm sàng thấy được trong khám phổi khi có viêm phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="ran rít">
  <data key="d0">ran rít</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng khi khám phổi, có thể xuất hiện trong tình trạng suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="hội chứng 3 giảm">
  <data key="d0">hội chứng 3 giảm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng khi có tràn khí màng phổi, thể hiện bằng ba dấu hiệu giảm.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="đông đặc">
  <data key="d0">đông đặc</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng trong hội chứng 3 giảm khi có tràn khí màng phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tam chứng của tràn khí màng phổi">
  <data key="d0">tam chứng của tràn khí màng phổi</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là hội chứng lâm sàng có các dấu hiệu giảm, đông đặc và đau ngực do tràn khí màng phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="suy tim mất bù">
  <data key="d0">suy tim mất bù</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân có thể dẫn đến suy hô hấp khi có tình trạng mất bù trong suy tim.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Ran ẩm, ran rít">
  <data key="d0">Ran ẩm, ran rít</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng được ghi nhận trong thăm khám kỹ phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="Hội chứng 3 giảm, đông đặc, tam chứng của tràn khí màng phổi">
  <data key="d0">Hội chứng 3 giảm, đông đặc, tam chứng của tràn khí màng phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng đặc trưng của tràn khí màng phổi, bao gồm ba dấu hiệu giảm, đông đặc và tam chứng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
