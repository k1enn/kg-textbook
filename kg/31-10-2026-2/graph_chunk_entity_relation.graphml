  <data key="d0">tăng nhịp tim</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng lâm sàng thường gặp là nhịp tim nhanh, xuất hiện khi cơ thể phản ứng để duy trì huyết áp.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-002</data>
