</edge>
<edge source="ngừng tuần hoàn (NTH)" target="hồi sinh tim phổi kết hợp với sốc điện">
  <data key="d7">1.0</data>
  <data key="d8">Hồi sinh tim phổi kết hợp với sốc điện là thủ thuật phòng ngừa biến chứng sau khi ngừng tuần hoàn.</data>
  <data key="d9">can thiệp sớm,phong_ngua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1792917938</data>
  <data key="d13"></data>
</edge>
<edge source="sốc điện" target="ngừng tuần hoàn">
  <data key="d7">2.0</data>
  <data key="d8">Sốc điện là một phương pháp hồi sinh được sử dụng để phục hồi nhịp tim ngừng ở bệnh nhân bị ngừng tuần hoàn.&lt;SEP&gt;Sốc điện được dùng để điều trị trong cấp cứu ngừng tuần hoàn, đặc biệt hiệu quả trong vòng 5 phút đầu.</data>
  <data key="d9">dieu_tri,hồi sinh,sốc điện</data>
  <data key="d10">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
