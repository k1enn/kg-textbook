</node>
<node id="dấu hiệu thần kinh khu trú">
  <data key="d0">dấu hiệu thần kinh khu trú</data>
  <data key="d1">khac</data>
  <data key="d2">Liệt nửa người là một dấu hiệu thần kinh khu trú do tổn thương thần kinh sọ.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
