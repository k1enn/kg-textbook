  <data key="d0">pháp tăng thải trừ độc chất</data>
  <data key="d1">khac</data>
  <data key="d2">Là một nhóm biện pháp nhằm tăng cường thải trừ độc chất trong cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="uống than hoạt hàng loạt">
  <data key="d0">uống than hoạt hàng loạt</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một biện pháp sử dụng than hoạt để hấp phụ độc chất trong cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
