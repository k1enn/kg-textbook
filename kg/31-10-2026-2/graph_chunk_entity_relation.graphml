  <data key="d0">cắt cụt chi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là biện pháp thực hiện sau 36 giờ khi chấn thương nghiêm trọng.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="đau nhức tự nhiên khu trú">
  <data key="d0">đau nhức tự nhiên khu trú</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng xuất hiện ở vùng khoang bị chèn ép, có tính chất đau dữ dội và dai dẳng.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="sưng, căng phồng vùng bị chèn ép">
  <data key="d0">sưng, căng phồng vùng bị chèn ép</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng khi vùng bị chèn ép có hiện tượng sưng và căng phồng, sờ chạm gây đau dữ dội.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
