</node>
<node id="môi trường làm việc">
  <data key="d0">môi trường làm việc</data>
  <data key="d1">khac</data>
  <data key="d2">Môi trường làm việc tại khoa cấp cứu có nhiều áp lực do không gian mở, đông bệnh nhân và người thân, dòng người di chuyển nhanh và ồn ào&lt;SEP&gt;Là môi trường làm việc tại khoa cấp cứu có áp lực cao do không gian mở, đông bệnh nhân và áp lực thời gian</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
<node id="thời gian">
  <data key="d0">thời gian</data>
  <data key="d1">khac</data>
  <data key="d2">Thời gian làm việc tại khoa cấp cứu thường ngắn và chưa có thông tin đầy đủ</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793353069</data>
  <data key="d6"></data>
</node>
