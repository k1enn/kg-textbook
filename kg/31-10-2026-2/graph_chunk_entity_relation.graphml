<node id="hội chứng sừng sau">
  <data key="d0">hội chứng sừng sau</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng tổn thương sừng sau tủy sống, hiếm gặp và chỉ ảnh hưởng đến cảm giác ở vùng dưới tổn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
