  <data key="d0">cryo</data>
  <data key="d1">thuoc</data>
  <data key="d2">là một loại dịch truyền được sử dụng trong điều trị thiếu hụt fibrinogen</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
