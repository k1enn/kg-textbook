  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật hỗ trợ ổn định bệnh nhân bị suy giảm tuần hoàn do chấn thương ngực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-000</data>
