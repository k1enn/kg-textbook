</edge>
<edge source="bệnh nhân đang ngồi hoặc đứng" target="thủ thuật Heimlich">
  <data key="d7">1.0</data>
  <data key="d8">Thủ thuật Heimlich được thực hiện với bệnh nhân đang ngồi hoặc đứng, với cách thực hiện cụ thể bằng tay ôm eo và ép bụng.</data>
  <data key="d9">chong_chi_dinh,đối tượng</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
