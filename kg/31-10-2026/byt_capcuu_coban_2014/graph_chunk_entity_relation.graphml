  <data key="d1">khac</data>
  <data key="d2">Vị trí thể hiện khi thực hiện động tác ép ngực sau khi vỗ lưng không hiệu quả.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
