  <data key="d0">nằm nghiêng an toàn sang trái</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một kỹ thuật tư thế dùng để giảm chèn ép của tử cung vào tĩnh mạch chủ dưới</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="ngồi - chân thõng">
  <data key="d0">ngồi - chân thõng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế áp dụng trong trường hợp phù phổi cấp để giảm tuần hoàn tĩnh mạch trở về tim</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nửa ngồi - chân thẳng">
  <data key="d0">nửa ngồi - chân thẳng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế áp dụng khi khó thở và bệnh nhân còn tỉnh, giúp cơ hoành dễ di động hơn và giảm đè ép của các tạng ổ bụng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nửa ngồi - chân gấp">
  <data key="d0">nửa ngồi - chân gấp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế áp dụng trong chấn thương bụng-ngực, giúp ngồi dễ thở và gấp chân làm chùng cơ bụng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="ngồi ngả ra trước">
  <data key="d0">ngồi ngả ra trước</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là tư thế dùng trong viêm nắp thanh quản để giảm cản trở hô hấp và giảm nguy cơ tắc đường khí do phù nề nắp thanh quản</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="vết thương cắt cụt">
  <data key="d0">vết thương cắt cụt</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là loại vết thương gây chảy máu, cần dùng garô vòng quanh chi để cầm máu</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="vết thương khác">
  <data key="d0">vết thương khác</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là các vết thương khác ngoài vết thương cắt cụt, cần ép trực tiếp vào động mạch hoặc băng đo HA để cầm máu</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="gãy xương và trật khớp">
  <data key="d0">gãy xương và trật khớp</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tổn thương gây biến dạng chi, cần đặt lại đúng tư thế và nẹp lại trước khi vận chuyển để phòng biến chứng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="chấn thương bụng-ngực">
  <data key="d0">chấn thương bụng-ngực</data>
  <data key="d1">khac</data>
  <data key="d2">Tư thế nửa ngồi - chân gấp được áp dụng trong chấn thương bụng-ngực để giúp bệnh nhân dễ thở và giảm chèn ép cơ bụng</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="viêm nắp thanh quản">
  <data key="d0">viêm nắp thanh quản</data>
  <data key="d1">khac</data>
  <data key="d2">Tư thế ngồi ngả ra trước được dùng để điều trị viêm nắp thanh quản bằng cách giảm cản trở hô hấp và nguy cơ tắc đường khí</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="biến chứng">
  <data key="d0">biến chứng</data>
  <data key="d1">khac</data>
  <data key="d2">Tổn thương gãy xương và trật khớp có thể dẫn đến các biến chứng khi không được xử trí đúng cách trước khi vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="ương">
  <data key="d0">ương</data>
  <data key="d1">khac</data>
  <data key="d2">Là hành động cầm máu khi có tổn thương xương.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tư thế nửa ngồi">
  <data key="d0">tư thế nửa ngồi</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là tư thế vận chuyển được chọn khi tổn thương ở chi trên.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
