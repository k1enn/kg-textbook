  <data key="d0">siêu âm đánh giá dịch ổ bụng</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Xét nghiệm sử dụng siêu âm để phát hiện nguồn chảy máu trong ổ bụng.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="HATB">
  <data key="d0">HATB</data>
  <data key="d1">khac</data>
  <data key="d2">Giá trị huyết áp tối thiểu cần thiết trong chấn thương sọ não</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
