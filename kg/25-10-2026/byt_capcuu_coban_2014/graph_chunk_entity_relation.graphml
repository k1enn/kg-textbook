  <data key="d2">Là thiết bị dùng để đặt đường thở phụ miệng hầu hoặc mũi hầu.&lt;SEP&gt;Là một loại đường thở phụ được đặt vào miệng hoặc mũi hầu để duy trì đường thở trong tình trạng cấp cứu.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="hầu họng">
  <data key="d0">hầu họng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là vùng cơ thể nằm ở phía trên của cổ, thường được sử dụng làm điểm đặt đường thở.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="gắp dị vật">
  <data key="d0">gắp dị vật</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật dùng để khai thác và loại bỏ dị vật khỏi đường thở.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="panh magi">
  <data key="d0">panh magi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một dụng cụ dùng để gắp dị vật trong miệng và hầu họng.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="phổi áp lực">
  <data key="d0">phổi áp lực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật sử dụng miếng nilon mỏng, sạch để xử trí tại khoa cấp cứu.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="miếng nilon mỏng, sạch">
  <data key="d0">miếng nilon mỏng, sạch</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là vật liệu được sử dụng trong thủ thuật phổi áp lực, cần đảm bảo vô khuẩn.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="nút bịt ngực Asherman">
  <data key="d0">nút bịt ngực Asherman</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là sản phẩm thương mại có cơ chế tác dụng tương tự với thủ thuật phổi áp lực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="dẫn lưu màng phổi">
  <data key="d0">dẫn lưu màng phổi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật cấp cứu được thực hiện khi có tràn dịch hoặc tràn khí màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="mở màng phổi cấp cứu">
  <data key="d0">mở màng phổi cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật cấp cứu thực hiện khi có tràn dịch hoặc tràn khí màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="phát hiện các thương tổn khác đi kèm">
  <data key="d0">phát hiện các thương tổn khác đi kèm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu được quan sát khi thực hiện thủ thuật phổi áp lực hoặc chẩn đoán các tổn thương liên quan.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="hội chẩn chuyên khoa ngoại">
  <data key="d0">hội chẩn chuyên khoa ngoại</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thủ thuật chuyên khoa được thực hiện để đánh giá và xử trí các trường hợp tràn máu màng phổi hoặc mảng sườn di động.&lt;SEP&gt;Việc hội chẩn chuyên khoa ngoại được thực hiện để xử trí vỡ cơ hoành và các tổn thương liên quan.&lt;SEP&gt;Quy trình chuyên môn được thực hiện để đánh giá và điều trị gãy xương.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-006&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-002</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
</node>
<node id="tràn máu màng phổi nhiều">
  <data key="d0">tràn máu màng phổi nhiều</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý xảy ra khi có sự tích tụ máu trong màng phổi với mức độ nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="giảm độ bão hòa oxy máu">
  <data key="d0">giảm độ bão hòa oxy máu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng liên quan đến tình trạng tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="di động lồng ngực giảm">
  <data key="d0">di động lồng ngực giảm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng xảy ra khi có tổn thương ở vùng ngực, đặc biệt trong trường hợp tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="rì rào phế nang giảm hoặc mất">
  <data key="d0">rì rào phế nang giảm hoặc mất</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng được phát hiện ở vùng tổn thương khi bệnh nhân bị tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="gõ đục">
  <data key="d0">gõ đục</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng khi gõ vùng xương sườn bị tổn thương trong bệnh tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="bầm tím">
  <data key="d0">bầm tím</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu tổn thương ngực xuất hiện khi có chấn thương ngực trong bệnh tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="gãy xương sườn">
  <data key="d0">gãy xương sườn</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là dấu hiệu tổn thương ngực xảy ra khi có chấn thương ngực trong bệnh tràn máu màng phổi nhiều.&lt;SEP&gt;Một tổn thương xương do chấn thương, thường được phát hiện qua chụp x-quang.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-002</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1792919571</data>
  <data key="d6"></data>
</node>
<node id="tụt huyết áp do sốc mất máu">
  <data key="d0">tụt huyết áp do sốc mất máu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng do mất máu nghiêm trọng trong bệnh tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="da xanh niêm mạc nhợt">
  <data key="d0">da xanh niêm mạc nhợt</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu thiếu máu xuất hiện khi bệnh nhân bị tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="thở nông">
  <data key="d0">thở nông</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là hiện tượng thở yếu do đau khi bệnh nhân bị mảng sườn di động.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="tiếng lạo xạo">
  <data key="d0">tiếng lạo xạo</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là âm thanh được nghe khi sờ nắn vùng xương sườn gãy trong bệnh mảng sườn di động.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="dấu hiệu gãy nhiều xương sườn trên XQ">
  <data key="d0">dấu hiệu gãy nhiều xương sườn trên XQ</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu được phát hiện qua chụp X-quang khi có mảng sườn di động.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="chụp CT">
  <data key="d0">chụp CT</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm hình ảnh được thực hiện khi tình trạng bệnh nhân cho phép trong xử trí tràn máu màng phổi nhiều.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="XQ">
  <data key="d0">XQ</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm hình ảnh được dùng để phát hiện dấu hiệu gãy xương sườn trong bệnh mảng sườn di động.&lt;SEP&gt;X-quang ngực được dùng để phát hiện bóng hơi dạ dày lên khoang màng phổi và vị trí ống thông dạ dày.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="thở CPAP không xâm nhập">
  <data key="d0">thở CPAP không xâm nhập</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật thở được sử dụng để cải thiện tình trạng oxy hóa máu ở bệnh nhân bị mảng sườn di động.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="đặt túi cát">
  <data key="d0">đặt túi cát</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được sử dụng để xử trí mảng sườn di động, giúp giảm di động của vùng tổn thương.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="ô hấp gây ra do mảng">
  <data key="d0">ô hấp gây ra do mảng</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng hô hấp bị ảnh hưởng do mảng sườn di động.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="sườn di động">
  <data key="d0">sườn di động</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng di chuyển bất thường của sườn do tổn thương trong lồng ngực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="thở CPAP">
  <data key="d0">thở CPAP</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật hỗ trợ hô hấp bằng thiết bị CPAP để cải thiện tình trạng oxy hóa máu.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="túi cát">
  <data key="d0">túi cát</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thiết bị dùng để cố định hoặc hỗ trợ lồng ngực trong tình trạng mảng sườn di động.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="nằm nghiêng sang bên tổn thương">
  <data key="d0">nằm nghiêng sang bên tổn thương</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là vị trí nằm của bệnh nhân để hỗ trợ phục hồi chức năng hô hấp khi có tổn thương sườn.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="huyết áp tụt">
  <data key="d0">huyết áp tụt</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng về sự giảm huyết áp do tổn thương hoặc sốc.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1792919420</data>
  <data key="d6"></data>
</node>
<node id="vết thương hở hoặc vết thương xuyên thấu vùng ngực, bụng">
  <data key="d0">vết thương hở hoặc vết thương xuyên thấu vùng ngực, bụng</data>
  <data key="d1">nguyen_nhan</data>
