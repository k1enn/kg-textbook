  <data key="d1">thu_thuat</data>
  <data key="d2">Hành động thực hiện giữa các lần vỗ lưng - ép ngực để loại bỏ dị vật nếu thấy.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
