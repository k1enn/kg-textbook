  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d2">Dobutamin được dùng để điều trị tụt huyết áp do viêm cơ tim nhiễm độc.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="do butamin">
  <data key="d0">do butamin</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d2">Dobutamin có thể được phối hợp với dopamin để tăng hiệu quả điều trị.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
