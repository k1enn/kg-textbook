  <data key="d1">doi_tuong</data>
  <data key="d2">Là điều kiện cần thiết để phát hiện sớm các dấu hiệu của sốc</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
