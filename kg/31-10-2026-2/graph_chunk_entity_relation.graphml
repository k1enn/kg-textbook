  <data key="d0">nằm nghiêng an toàn</data>
  <data key="d1">khac</data>
  <data key="d2">Tư thế nằm nghiêng an toàn được sử dụng để điều trị rối loạn ý thức khi không có vấn đề hô hấp hoặc tuần hoàn.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="giải phóng đường thở">
  <data key="d0">giải phóng đường thở</data>
  <data key="d1">khac</data>
  <data key="d2">Tư thế nằm nghiêng an toàn giúp giải phóng đường thở cho bệnh nhân có rối loạn ý thức.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
