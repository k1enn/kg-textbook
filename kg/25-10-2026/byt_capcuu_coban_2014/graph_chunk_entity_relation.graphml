</node>
<node id="ngộ độc các loại độc chất">
  <data key="d0">ngộ độc các loại độc chất</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra tình trạng cần dùng lợi tiểu tích cực để thải độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-006</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
