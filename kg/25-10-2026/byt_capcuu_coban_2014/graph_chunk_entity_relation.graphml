  <data key="d0">Giữ chi ở ngang mức tim</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật duy trì vị trí chi ở ngang mức tim nhằm đảm bảo dòng máu đến và từ cơ thể ổn định.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
</node>
<node id="Kháng sinh dự phòng">
  <data key="d0">Kháng sinh dự phòng</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là việc sử dụng thuốc kháng sinh nhằm phòng ngừa nhiễm trùng trong quá trình điều trị.&lt;SEP&gt;Là thuốc không nên dùng nhất loạt để tránh tạo dòng vi khuẩn kháng thuốc.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Điều trị và theo dõi hội chứng tiêu cơ vân cấp">
