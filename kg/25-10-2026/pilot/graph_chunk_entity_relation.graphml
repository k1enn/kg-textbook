<graph edgedefault="undirected"><node id="Nguy kịch (khẩn cấp)">
  <data key="d0">Nguy kịch (khẩn cấp)</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương, rối loạn đe dọa tính mạng, có nguy cơ tử vong nhanh chóng nếu không được can thiệp cấp cứu ngay&lt;SEP&gt;Bệnh nhân có bệnh lý, tổn thương, rối loạn đe dọa tính mạng với nguy cơ tử vong nhanh nếu không can thiệp cấp cứu ngay.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Cấp cứu (emergency)">
  <data key="d0">Cấp cứu (emergency)</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương, rối loạn có thể tiến triển nặng lên nếu không được can thiệp điều trị nhanh chóng&lt;SEP&gt;Bệnh nhân có bệnh lý, tổn thương, rối loạn có thể tiến triển nặng nếu không được can thiệp điều trị nhanh chóng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Công tác thực hành cấp cứu">
  <data key="d0">Công tác thực hành cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là nhiệm vụ đánh giá, xử trí và điều trị cho các bệnh nhân có bệnh lý, tổn thương, rối loạn cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Thời gian">
  <data key="d0">Thời gian</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là yếu tố làm hạn chế thời gian trong việc thu thập thông tin, đánh giá và đưa ra chẩn đoán, xử trí khi cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Thông tin hạn chế">
  <data key="d0">Thông tin hạn chế</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tình trạng thiếu thông tin đầy đủ khi đưa ra chẩn đoán và quyết định xử trí trong cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Môi trường làm việc">
  <data key="d0">Môi trường làm việc</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là không gian làm việc tại khoa cấp cứu luôn có áp lực, gần cổng bệnh viện, đông bệnh nhân và mở thông thường với bên ngoài</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Đánh giá nhanh">
  <data key="d0">Đánh giá nhanh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động đánh giá bệnh nhân và đưa ra quyết định trong thời gian ngắn khi thông tin chưa đầy đủ</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Ra quyết định">
  <data key="d0">Ra quyết định</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động đưa ra chẩn đoán và xử trí dựa trên thông tin sơ bộ, chưa đầy đủ trong tình huống cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Tác phong khẩn trương">
  <data key="d0">Tác phong khẩn trương</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là thái độ phản ứng nhanh và theo trình tự khi xử lý bệnh nhân cấp cứu</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Primary">
  <data key="d0">Primary</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước đầu tiên trong quá trình thăm khám và cấp cứu bệnh nhân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="Secondary">
  <data key="d0">Secondary</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước thứ hai trong quá trình thăm khám và cấp cứu bệnh nhân</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="thời gian">
  <data key="d0">thời gian</data>
  <data key="d1">khac</data>
  <data key="d2">Là yếu tố ảnh hưởng đến môi trường làm việc tại khoa cấp cứu, tạo ra áp lực về thời gian và không gian.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="không gian và môi trường làm việc">
  <data key="d0">không gian và môi trường làm việc</data>
  <data key="d1">khac</data>
  <data key="d2">Môi trường làm việc tại khoa cấp cứu nằm gần cổng bệnh viện, có không gian mở, đông bệnh nhân và người thân, dòng người di chuyển nhanh và ồn ào.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="môi trường làm việc tại khoa cấp cứu">
  <data key="d0">môi trường làm việc tại khoa cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Là môi trường có áp lực cao do không gian mở, đông người, dòng người di chuyển nhanh và nhiều tiếng ồn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="nhân viên y tế">
  <data key="d0">nhân viên y tế</data>
  <data key="d1">khac</data>
  <data key="d2">Người làm việc tại khoa cấp cứu phải xử lý nhiều nhiệm vụ và chịu áp lực từ bệnh nhân và người thân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="trường hợp yêu cầu cấp thiết">
  <data key="d0">trường hợp yêu cầu cấp thiết</data>
  <data key="d1">khac</data>
  <data key="d2">Đa phần trường hợp cấp cứu không chỉ nhằm tìm chẩn đoán mà là xác nhận hoặc loại trừ bệnh lý nặng đe dọa tính mạng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="phương pháp thăm khám và đánh giá tuần tự">
  <data key="d0">phương pháp thăm khám và đánh giá tuần tự</data>
  <data key="d1">khac</data>
  <data key="d2">Phương pháp đánh giá từng bước theo thứ tự có thể không phù hợp và chậm trễ trong tình huống cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="quá tải">
  <data key="d0">quá tải</data>
  <data key="d1">khac</data>
  <data key="d2">Tình trạng khoa cấp cứu bị quá tải công việc và bệnh nhân, dẫn đến nguy cơ bệnh nhân bị bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="lượng bệnh nhân đến cấp cứu">
  <data key="d0">lượng bệnh nhân đến cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Số lượng bệnh nhân đến cấp cứu thay đổi theo thời gian và rất khó dự đoán chính xác.&lt;SEP&gt;số lượng bệnh nhân đến khoa cấp cứu, không thể dự đoán chính xác do biến động theo thời gian.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="công suất">
  <data key="d0">công suất</data>
  <data key="d1">khac</data>
  <data key="d2">Mức độ hoạt động tối đa của khoa cấp cứu, khi đạt 140% sẽ có nguy cơ quá tải và bệnh nhân bị bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="giữa các ngày trong tuần">
  <data key="d0">giữa các ngày trong tuần</data>
  <data key="d1">khac</data>
  <data key="d2">một khoảng thời gian trong tuần, không phải là thời điểm cụ thể, được dùng để mô tả sự biến động trong lượng bệnh nhân đến cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="giữa các mùa">
  <data key="d0">giữa các mùa</data>
  <data key="d1">khac</data>
  <data key="d2">một khoảng thời gian trong năm, được dùng để mô tả sự biến động trong lượng bệnh nhân đến cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="thời điểm các khoa cấp cứu bị quá tải bệnh nhân">
  <data key="d0">thời điểm các khoa cấp cứu bị quá tải bệnh nhân</data>
  <data key="d1">khac</data>
  <data key="d2">các thời điểm cụ thể khi khoa cấp cứu có quá nhiều bệnh nhân so với công suất hoạt động.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="khoa cấp cứu bị quá tải lên đến 140% công suất">
  <data key="d0">khoa cấp cứu bị quá tải lên đến 140% công suất</data>
  <data key="d1">khac</data>
  <data key="d2">trạng thái khi khoa cấp cứu hoạt động vượt quá công suất thiết kế, dẫn đến rủi ro bỏ sót bệnh nhân và sai sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="nguy cơ bỏ sót bệnh nhân">
  <data key="d0">nguy cơ bỏ sót bệnh nhân</data>
  <data key="d1">khac</data>
  <data key="d2">rủi ro xảy ra khi khoa cấp cứu quá tải, dẫn đến bệnh nhân không được cấp cứu kịp thời.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="tính ưu tiên cấp cứu">
  <data key="d0">tính ưu tiên cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">nguyên tắc phân loại bệnh nhân và can thiệp theo mức độ cấp thiết, không theo thứ tự thông thường.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="quy trình phân loại bệnh nhân">
  <data key="d0">quy trình phân loại bệnh nhân</data>
  <data key="d1">khac</data>
  <data key="d2">dãy bước được triển khai để phân loại bệnh nhân theo mức độ cấp cứu trong tình huống quá tải.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="kỹ năng phân loại bệnh nhân">
