  <data key="d12">1792918589</data>
  <data key="d13"></data>
</edge>
<edge source="phân ly điện cơ" target="dùng ngay thuốc chống loạn nhịp thich hợp">
  <data key="d7">1.0</data>
  <data key="d8">Việc sử dụng thuốc chống loạn nhịp là một biện pháp điều trị khi có loạn nhịp trong tình trạng phân ly điện cơ.</data>
