  <data key="d0">tràn khí màng phổi áp lực</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là biến chứng xảy ra do khí tích tụ trong màng phổi gây áp lực lên các cơ quan lồng ngực.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="vết thương mạch máu">
  <data key="d0">vết thương mạch máu</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là tổn thương ở mạch máu gây ra bởi chấn thương hoặc tổn thương cơ thể.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
