  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật lật đồng thời đầu, thân và chân tay để đưa bệnh nhân về tư thế nằm ngửa</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
