</node>
<node id="giữ huyết áp tối đa &lt;100 mmhg">
  <data key="d0">giữ huyết áp tối đa &lt;100 mmhg</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là biện pháp điều trị nhằm duy trì huyết áp dưới 100 mmHg khi bệnh nhân bị tổn thương cơ hoành.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-008</data>
