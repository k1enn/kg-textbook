  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật đặt ống nội khí quản để đảm bảo hô hấp cho bệnh nhân bị bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
