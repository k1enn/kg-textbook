  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc dùng để điều trị các tình trạng loạn nhịp tim trong quá trình cấp cứu.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-003</data>
