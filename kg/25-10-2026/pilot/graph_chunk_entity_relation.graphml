  <data key="d1">khac</data>
  <data key="d2">Là giai đoạn đầu tiên trong quá trình thăm khám bệnh nhân cấp cứu, tập trung vào việc đánh giá và kiểm soát các chức năng sống.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="bước 2 (secondary survey)">
  <data key="d0">bước 2 (secondary survey)</data>
  <data key="d1">khac</data>
  <data key="d2">Là giai đoạn thứ hai trong quá trình thăm khám bệnh nhân cấp cứu, nhằm đánh giá đầy đủ các tổn thương và rối loạn để lập kế hoạch điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="nhận định và kiểm soát ổn định các chức năng sống">
  <data key="d0">nhận định và kiểm soát ổn định các chức năng sống</data>
  <data key="d1">khac</data>
  <data key="d2">Là mục tiêu chính của bước 1 trong quá trình thăm khám bệnh nhân cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="đánh giá và kiểm soát tuần tự ABCD">
  <data key="d0">đánh giá và kiểm soát tuần tự ABCD</data>
  <data key="d1">khac</data>
  <data key="d2">Là phương pháp đánh giá chức năng sống theo trình tự gồm đường thở, hô hấp, tuần hoàn và thần kinh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="xác định các tổn thương/rối loạn quan trọng">
  <data key="d0">xác định các tổn thương/rối loạn quan trọng</data>
  <data key="d1">khac</data>
  <data key="d2">Là hoạt động xác định các tổn thương hoặc rối loạn có ảnh hưởng trực tiếp đến chức năng sống và có thể xử trí ngay.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="thực hiện ngay các điều trị, thủ thuật và can thiệp cấp cứu">
  <data key="d0">thực hiện ngay các điều trị, thủ thuật và can thiệp cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Là các hành động được thực hiện ngay lập tức nhằm ổn định các chức năng sống của bệnh nhân cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="khai thông đường thở">
  <data key="d0">khai thông đường thở</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được thực hiện để đảm bảo đường thở của bệnh nhân được mở rộng và thông suốt.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="đặt NKQ">
  <data key="d0">đặt NKQ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật đặt thiết bị hỗ trợ hô hấp để duy trì chức năng hô hấp của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="bóp bóng">
  <data key="d0">bóp bóng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật dùng để nén và giảm áp lực trong các vùng tổn thương nhằm ổn định bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="thở ô xy">
  <data key="d0">thở ô xy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động cung cấp oxy cho bệnh nhân để hỗ trợ chức năng hô hấp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="đặt đường truyền tĩnh mạch">
  <data key="d0">đặt đường truyền tĩnh mạch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật thiết lập đường truyền tĩnh mạch để truyền dịch hoặc thuốc vào cơ thể.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="bồi phụ thể tích">
  <data key="d0">bồi phụ thể tích</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động bổ sung thể tích máu hoặc dịch để duy trì tuần hoàn ổn định.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
<node id="cầm máu">
  <data key="d0">cầm máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật kiểm soát chảy máu tại chỗ để tránh mất máu nặng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917261</data>
  <data key="d6"></data>
</node>
