  <data key="d0">đợt cấp của hen phế quản</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d2">Corticoid được chỉ định trong đợt cấp của hen phế quản.</data>
