  <data key="d1">thu_thuat</data>
  <data key="d2">Một mục tiêu trong việc duy trì sự thông khí hiệu quả cho bệnh nhân trong tình trạng phân ly điện cơ.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
