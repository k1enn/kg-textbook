<node id="rung thất">
  <data key="d0">rung thất</data>
  <data key="d1">benh</data>
  <data key="d2">Triệu chứng điện tim biểu hiện bằng sóng rung thất trên điện tâm đồ.&lt;SEP&gt;Một dạng loạn nhịp tim xảy ra ở thất tim.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
