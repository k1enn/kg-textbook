  <data key="d0">tăm bông</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một dụng cụ được dùng để hỗ trợ việc gây nôn bằng cách đưa vào họng nạn nhân.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
