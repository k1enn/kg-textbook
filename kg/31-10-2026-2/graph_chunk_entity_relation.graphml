  <data key="d0">niêm mạc</data>
  <data key="d1">khac</data>
  <data key="d2">Xà phòng được dùng để rửa niêm mạc khi bị hóa chất độc gây hại.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
