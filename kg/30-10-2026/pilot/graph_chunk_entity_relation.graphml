<edge source="ho" target="thủ thuật Heimlich">
  <data key="d7">1.0</data>
  <data key="d8">Ho là một triệu chứng tự nhiên tương tự như thủ thuật Heimlich trong việc tống dị vật ra khỏi đường thở.</data>
  <data key="d9">cơ chế hoạt động,trieu_chung_cua</data>
