  <data key="d0">dopamine</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc được dùng trong điều trị các loại sốc khác nhau&lt;SEP&gt;thuốc được dùng trong liều 5-20 mcg/kg/phút để hỗ trợ tim và mạch</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-004&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-005</data>
