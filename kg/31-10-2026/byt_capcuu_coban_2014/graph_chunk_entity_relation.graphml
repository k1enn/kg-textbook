  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật sử dụng điện để phục hồi nhịp tim trong giai đoạn đầu sau ngừng tuần hoàn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
