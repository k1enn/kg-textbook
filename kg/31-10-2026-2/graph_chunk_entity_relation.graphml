  <data key="d0">dãn đồng tử một bên</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng gợi ý tăng áp lực nội sọ trong chấn thương sọ não</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
