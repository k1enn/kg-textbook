  <data key="d1">thu_thuat</data>
  <data key="d2">Một hành động giám sát hoạt động điện tâm đồ của bệnh nhân thông qua thiết bị máy monitor.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
