  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="nối tiếp bằng ép ngực" target="lật trẻ nằm ngửa và ép ngực 5 cái">
  <data key="d7">1.0</data>
  <data key="d8">Khi vỗ lưng không hiệu quả, kỹ thuật ép ngực được thực hiện bằng cách lật trẻ nằm ngửa và ép 5 lần.</data>
  <data key="d9">dieu_tri,ép ngực</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="dùng phần phẳng của bàn tay vỗ nhẹ và nhanh 5 cái lên vùng giữa hai xương bả vai" target="chỉ động tác vỗ lưng đã có thể tống được dị vật">
  <data key="d7">1.0</data>
  <data key="d8">Động tác vỗ lưng được thực hiện bằng cách dùng phần phẳng của bàn tay để vỗ nhẹ và nhanh 5 lần lên vùng giữa hai xương bả vai.</data>
  <data key="d9">dieu_tri,vỗ lưng</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="làm sạch đường thở" target="quan sát khoang miệng dùng tay lấy bất cứ dị vật nào nếu nhìn thấy">
  <data key="d7">1.0</data>
  <data key="d8">Sau mỗi động tác làm sạch đường thở, cần quan sát khoang miệng để lấy dị vật nếu thấy.</data>
  <data key="d9">dieu_tri,làm sạch đường thở</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="đánh giá hiệu quả" target="xác định theo dị vật đã được tống ra chưa và đường thở đã được giải phóng chưa">
  <data key="d7">1.0</data>
  <data key="d8">Việc đánh giá hiệu quả bao gồm việc xác định xem dị vật đã được tống ra và đường thở đã được giải phóng chưa.</data>
  <data key="d9">dieu_tri,đánh giá hiệu quả</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="loại trừ dị vật thành công khi thấy" target="thấy chắc chắn dị vật được tống ra">
  <data key="d7">1.0</data>
  <data key="d8">Khi thấy chắc chắn dị vật đã được tống ra, thì cho rằng đã loại trừ thành công.</data>
  <data key="d9">dieu_tri,loại trừ dị vật</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
