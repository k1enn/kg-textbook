  <data key="d1">khac</data>
  <data key="d2">Trường hợp không thể thực hiện cấp cứu do vị trí hoặc tư thế của bệnh nhân không phù hợp.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
