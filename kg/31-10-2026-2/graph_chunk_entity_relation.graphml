  <data key="d1">khac</data>
  <data key="d2">Là trạng thái thay đổi của bệnh nhân sau khi được can thiệp hoặc theo dõi.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
