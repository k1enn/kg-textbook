</edge>
<edge source="đặt Canuyn hầu" target="giúp duy trì sự thông thoáng của đường thở và thông khí đầy đủ">
  <data key="d7">1.0</data>
  <data key="d8">Việc đặt Canuyn hầu giúp duy trì thông thoáng đường thở và thông khí đầy đủ khi sử dụng bóng Ambu và mask.</data>
  <data key="d9">dieu_tri,đặt Canuyn</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="đặt Canuyn hầu" target="dụng cụ này làm thông thoáng đường thở bằng cách tách lưỡi ra khỏi thành họng">
  <data key="d7">1.0</data>
  <data key="d8">Khi đặt Canuyn hầu, dụng cụ này hoạt động bằng cách tách lưỡi ra khỏi thành họng để thông thoáng đường thở.</data>
  <data key="d9">dieu_tri,đặt Canuyn</data>
  <data key="d10">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d11">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
