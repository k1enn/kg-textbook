<node id="tháo bỏ quần áo bị dính hóa chất">
  <data key="d0">tháo bỏ quần áo bị dính hóa chất</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật cần thực hiện để loại bỏ quần áo bị dính hóa chất gây tổn thương.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="xử trí như vết thương chảy máu">
  <data key="d0">xử trí như vết thương chảy máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được áp dụng khi có hiện tượng chảy máu nhiều do bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="hội chẩn">
  <data key="d0">hội chẩn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được thực hiện giữa bác sĩ cấp cứu và bác sĩ chuyên khoa sâu về bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="hồi sức">
  <data key="d0">hồi sức</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được thực hiện để phục hồi chức năng cho bệnh nhân sau khi bỏng nặng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="điều trị theo chuyên khoa sâu về bỏng">
  <data key="d0">điều trị theo chuyên khoa sâu về bỏng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được thực hiện để điều trị bệnh nhân bỏng nặng theo chuyên khoa sâu về bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="chẩn đoán độ sâu">
  <data key="d0">chẩn đoán độ sâu</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là phương pháp chẩn đoán dùng để xác định mức độ sâu của vùng bỏng, nhưng thường không chắc chắn.&lt;SEP&gt;Là xét nghiệm được dùng để đánh giá độ sâu của vết bỏng, nhưng thường không chắc chắn.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng nặng">
  <data key="d0">bỏng nặng</data>
  <data key="d1">khac</data>
  <data key="d2">Nhiễm khuẩn là biến chứng thường gặp ở bệnh nhân bị bỏng nặng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng hóa chất ở mắt">
  <data key="d0">bỏng hóa chất ở mắt</data>
  <data key="d1">khac</data>
  <data key="d2">Thủ thuật rửa bằng nước sạch được thực hiện để xử lý bỏng hóa chất ở mắt.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bác sỹ khoa cấp cứu">
  <data key="d0">bác sỹ khoa cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Hội chẩn được thực hiện giữa bác sĩ cấp cứu và bác sĩ chuyên khoa sâu về bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="khuẩn">
  <data key="d0">khuẩn</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ra bệnh ở bệnh nhân bỏng nặng và bỏng sâu.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân bỏng nặng">
  <data key="d0">bệnh nhân bỏng nặng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có tình trạng bỏng nặng, dễ bị ảnh hưởng bởi các yếu tố nguy cơ và cần can thiệp đặc biệt.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="eosine">
  <data key="d0">eosine</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc được dùng tại chỗ để điều trị vùng bỏng, nhưng cần tránh vì có thể làm thay đổi vùng bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="thuốc mỡ">
  <data key="d0">thuốc mỡ</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là loại thuốc được dùng tại chỗ để điều trị vùng bỏng, nhưng cần tránh vì có thể làm thay đổi vùng bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="vật liệu thấm hút">
  <data key="d0">vật liệu thấm hút</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là vật liệu được đặt lên vùng bỏng để hấp thu dịch, nhưng cần tránh vì có thể làm thay đổi vùng bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="uốn ván">
  <data key="d0">uốn ván</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý cần được tiêm phòng để phòng ngừa ở bệnh nhân bị bỏng.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bỏng hít">
  <data key="d0">bỏng hít</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý xảy ra khi hít phải khí độc như CO hoặc CN trong môi trường kín có nhiều chất dẻo cháy.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="khí độc co">
  <data key="d0">khí độc co</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ra bệnh bỏng hít khi người bệnh bị bỏng lửa trong môi trường kín có nhiều chất dẻo cháy.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="bảo đảm thông khí">
  <data key="d0">bảo đảm thông khí</data>
  <data key="d1">khac</data>
  <data key="d2">Một biện pháp can thiệp nhằm duy trì sự thông khí trong cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="bổ xung oxy">
  <data key="d0">bổ xung oxy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Các biện pháp nhằm cung cấp oxy vào hệ hô hấp để duy trì trạng thái oxy hóa máu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="ngửa cổ">
  <data key="d0">ngửa cổ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một kỹ thuật can thiệp nhằm mở rộng đường thở trong quá trình điều trị.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="đặt canun">
  <data key="d0">đặt canun</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một biện pháp can thiệp nhằm hỗ trợ thông khí bằng thiết bị canun.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="thổi ngạt">
  <data key="d0">thổi ngạt</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một biện pháp can thiệp nhằm cung cấp không khí vào phổi khi không thể thở tự nhiên.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="dùng các thuốc giãn phế quản">
  <data key="d0">dùng các thuốc giãn phế quản</data>
  <data key="d1">thuoc</data>
  <data key="d2">Sử dụng thuốc để giãn phế quản nhằm cải thiện thông khí phổi.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nhịp chậm">
  <data key="d0">nhịp chậm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng của nhịp tim chậm dưới 60 lần/phút trong tình trạng loạn nhịp.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nhịp nhanh">
  <data key="d0">nhịp nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng của nhịp tim nhanh trong tình trạng loạn nhịp.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="truỵ mach">
  <data key="d0">truỵ mach</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Một biến chứng nghiêm trọng do suy giảm chức năng tuần hoàn.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="atropine">
  <data key="d0">atropine</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc được dùng để điều trị nhịp chậm dưới 60 lần/phút.&lt;SEP&gt;Là nguyên nhân gây ra hội chứng anticholinergic như mạch nhanh, huyết áp tăng, nhiệt thân tăng, đồng tử giãn, da nóng đỏ, khô, giảm co bóp, vật vã, kích thích phản xạ gân xương tăng.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-006</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="dopamin">
  <data key="d0">dopamin</data>
  <data key="d1">thuoc</data>
  <data key="d2">là thuốc phối hợp sử dụng với liều dưới 5 μg/kg/phút trong điều trị&lt;SEP&gt;Một loại thuốc được dùng để tăng huyết áp khi có tụt huyết áp do giảm thể tích tuần hoàn.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="digoxin">
  <data key="d0">digoxin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc được dùng để điều trị loạn nhịp nhanh xoang và nhanh trên thất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="prostigmin">
  <data key="d0">prostigmin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc được dùng để điều trị loạn nhịp nhanh xoang và nhanh trên thất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="đầu 0,2 μg/kg/phút">
  <data key="d0">đầu 0,2 μg/kg/phút</data>
  <data key="d1">thuoc</data>
  <data key="d2">là liều lượng thuốc được điều chỉnh theo đáp ứng của bệnh nhân trong điều trị</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="seduxen">
  <data key="d0">seduxen</data>
  <data key="d1">thuoc</data>
  <data key="d2">là thuốc dùng để cắt cơn co giật trong trẻ em và duy trì sau đó&lt;SEP&gt;Là loại độc chất được đào thải qua đường tiết niệu, gây ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="thiopental">
  <data key="d0">thiopental</data>
  <data key="d1">thuoc</data>
  <data key="d2">là thuốc dùng để cắt cơn co giật với liều tiêm 2-4 mg/kg và duy trì 2mg/kg/giờ</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="gacdenal">
  <data key="d0">gacdenal</data>
  <data key="d1">thuoc</data>
  <data key="d2">là thuốc dùng để duy trì kiểm soát cơn co giật hoặc điều trị co giật do ngộ độc</data>
