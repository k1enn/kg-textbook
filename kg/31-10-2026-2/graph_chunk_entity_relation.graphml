  <data key="d2">Bệnh tổn thương màng phế nang mao mạch, thường đi kèm với suy hô hấp nặng</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-006</data>
