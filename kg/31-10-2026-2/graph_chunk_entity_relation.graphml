<node id="chăm sóc hồi sức tích cực">
  <data key="d0">chăm sóc hồi sức tích cực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một loại điều trị y tế chuyên sâu nhằm duy trì chức năng sống của bệnh nhân trong tình trạng nguy kịch.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
