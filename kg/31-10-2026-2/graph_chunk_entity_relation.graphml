  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu mất rì rào phế nang khi có tổn thương cơ hoành.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-008</data>
