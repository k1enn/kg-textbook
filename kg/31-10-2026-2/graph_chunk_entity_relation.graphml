</node>
<node id="tai mũi họng">
  <data key="d0">tai mũi họng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có các vấn đề liên quan đến hệ tai mũi họng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="mắt">
  <data key="d0">mắt</data>
  <data key="d1">khac</data>
  <data key="d2">Là nhóm người bệnh có các vấn đề liên quan đến mắt.&lt;SEP&gt;Rửa mắt liên tục bằng nước muối 0,9% là thủ thuật được thực hiện khi chất độc bắn vào mắt.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
