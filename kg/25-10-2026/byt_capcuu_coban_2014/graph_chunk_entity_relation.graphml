  <data key="d0">khám lâm sàng chi tiết</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một bước đánh giá toàn diện các tổn thương cơ thể trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="hội chẩn chuyên khoa phẫu thuật thần kinh">
  <data key="d0">hội chẩn chuyên khoa phẫu thuật thần kinh</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một bước đánh giá chuyên sâu về chấn thương thần kinh do các chuyên gia phẫu thuật thần kinh thực hiện.&lt;SEP&gt;Là hình thức hội chẩn chuyên khoa được thực hiện để đánh giá tổn thương cột sống cổ.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1792919162</data>
  <data key="d6"></data>
</node>
