  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d2">N Acetylcystein được dùng để điều trị ngộ độc paracetamol bằng cách trung hòa độc chất.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="quá liều thuốc phiện">
  <data key="d0">quá liều thuốc phiện</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d2">Naloxon được dùng để điều trị quá liều thuốc phiện bằng cách đối kháng tác dụng độc hại.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="ngộ độc chì">
  <data key="d0">ngộ độc chì</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d2">D penicilamin được dùng để điều trị ngộ độc chì bằng cách đối kháng tác dụng độc hại.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="giáo dục phòng chống tái phát">
  <data key="d0">giáo dục phòng chống tái phát</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d2">Gan là một cơ quan cần được hỗ trợ trong điều trị triệu chứng và hồi sức, góp phần phòng chống tái phát.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="Vận chuyển bệnh nhân cấp cứu">
  <data key="d0">Vận chuyển bệnh nhân cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hoạt động di chuyển bệnh nhân trong các tình huống khẩn cấp nhằm đảm bảo an toàn cho bệnh nhân và nhân viên cứu hộ.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Phân loại">
  <data key="d0">Phân loại</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là hệ thống phân chia các phương pháp vận chuyển bệnh nhân theo bối cảnh và môi trường thực hiện.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Di dời bệnh nhân khỏi hiện trường">
  <data key="d0">Di dời bệnh nhân khỏi hiện trường</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật đưa bệnh nhân ra khỏi khu vực nguy hiểm hoặc hiện trường xảy ra sự cố.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Vận chuyển từ hiện trường về bệnh viện">
  <data key="d0">Vận chuyển từ hiện trường về bệnh viện</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là quy trình di chuyển bệnh nhân từ nơi xảy ra tai nạn hoặc hiện trường đến bệnh viện.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Vận chuyển trong bệnh viện">
  <data key="d0">Vận chuyển trong bệnh viện</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hoạt động vận chuyển bệnh nhân trong nội bộ bệnh viện giữa các khoa hoặc phòng khác nhau.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Vận chuyển giữa các bệnh viện">
  <data key="d0">Vận chuyển giữa các bệnh viện</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là quy trình chuyển bệnh nhân từ một bệnh viện sang bệnh viện khác để tiếp tục điều trị.&lt;SEP&gt;Là quá trình vận chuyển bệnh nhân giữa các cơ sở y tế khác nhau</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Nâng và di dời bệnh nhân cấp cứu tại hiện trường">
  <data key="d0">Nâng và di dời bệnh nhân cấp cứu tại hiện trường</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật nâng và di chuyển bệnh nhân ở hiện trường nhằm đảm bảo an toàn cho cả bệnh nhân và nhân viên.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Môi trường xung quanh">
  <data key="d0">Môi trường xung quanh</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là điều kiện môi trường xung quanh nơi bệnh nhân đang ở, có thể ảnh hưởng đến an toàn cho bệnh nhân và nhân viên.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Tư thế thích hợp">
  <data key="d0">Tư thế thích hợp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là vị trí cơ thể mà bệnh nhân được đặt để đảm bảo an toàn và tránh tổn thương khi vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Phủ kín, phủ ấm">
  <data key="d0">Phủ kín, phủ ấm</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hành động che phủ bệnh nhân để giữ ấm và tránh tổn thương do nhiệt độ thấp.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Đảm bảo an toàn">
  <data key="d0">Đảm bảo an toàn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các biện pháp thực hiện để bảo vệ bệnh nhân và nhân viên khỏi rủi ro trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Nguyên tắc nâng - khiêng">
  <data key="d0">Nguyên tắc nâng - khiêng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hai nguyên tắc cơ bản về cách nâng và khiêng bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="nguyên tắc cơ bản">
