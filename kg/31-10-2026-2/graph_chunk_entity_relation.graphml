  <data key="d0">mất phản xạ hai chi dưới</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Dấu hiệu lâm sàng cho thấy mất phản xạ ở hai chi dưới trong hội chứng đuôi ngựa.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="hội chứng sốc tủy (spinal shock)">
  <data key="d0">hội chứng sốc tủy (spinal shock)</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng xuất hiện sau tổn thương tủy sống 24 giờ, do tổn thương tủy sống hoàn toàn.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="không liên quan đến giảm thể tích">
  <data key="d0">không liên quan đến giảm thể tích</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số cho thấy hội chứng sốc tủy không liên quan đến giảm thể tích máu.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="có thể phục hồi hoặc không phục hồi">
  <data key="d0">có thể phục hồi hoặc không phục hồi</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số về khả năng phục hồi sau hội chứng sốc tủy, tùy thuộc vào tình trạng tổn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="hội chứng sốc thần kinh (neurogenic shock)">
  <data key="d0">hội chứng sốc thần kinh (neurogenic shock)</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng tổn thương tủy sống từ đốt ng, gây mất chức năng thần kinh dưới tổn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="tổn thương tủy sống từ đốt ng">
  <data key="d0">tổn thương tủy sống từ đốt ng</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng sốc thần kinh do tổn thương tủy sống từ đốt ng.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="hội chứng sốc thần kinh">
  <data key="d0">hội chứng sốc thần kinh</data>
  <data key="d1">benh</data>
  <data key="d2">Một bệnh lý xảy ra do tổn thương tủy sống từ đốt ngực 6 trở lên, gây mất trương lực giao cảm và tụt huyết áp.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="tổn thương tủy sống">
  <data key="d0">tổn thương tủy sống</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng sốc thần kinh, xảy ra từ đốt ngực 6 trở lên.&lt;SEP&gt;Bệnh lý xảy ra do chấn thương cột sống, không có thuốc điều trị cải thiện tiên lượng hiện nay.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="tụt huyết áp">
  <data key="d0">tụt huyết áp</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Dấu hiệu lâm sàng xuất hiện do tổn thương tủy sống, dẫn đến mất trương lực giao cảm.&lt;SEP&gt;Một triệu chứng lâm sàng thể hiện sự giảm áp lực máu trong mạch máu, thường xảy ra trong rối loạn huyết động.&lt;SEP&gt;Một triệu chứng lâm sàng do mất máu dẫn đến suy giảm huyết áp.&lt;SEP&gt;Là dấu hiệu lâm sàng cho thấy huyết áp giảm đột ngột, thường xảy ra khi mất tưới máu.&lt;SEP&gt;Là một triệu chứng lâm sàng do suy hô hấp hoặc chấn thương.&lt;SEP&gt;Một tình trạng giảm áp lực máu do suy giảm chức năng tuần hoàn.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nhịp tim bình thường hoặc chậm">
  <data key="d0">nhịp tim bình thường hoặc chậm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Dấu hiệu lâm sàng trong hội chứng sốc thần kinh, nhịp tim không tăng nhanh.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="dãn mạch ngoại biên">
  <data key="d0">dãn mạch ngoại biên</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Dấu hiệu lâm sàng do tổn thương tủy sống, biểu hiện mạch máu giãn ra ở ngoại biên.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="chụp xq thường 3 tư thế">
  <data key="d0">chụp xq thường 3 tư thế</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Một phương pháp chẩn đoán hình ảnh được sử dụng trong chấn thương cột sống, thực hiện ở 3 tư thế: thẳng, nghiêng, há mồm.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="chụp cắt lớp vi tính cột sống">
  <data key="d0">chụp cắt lớp vi tính cột sống</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Một phương pháp chẩn đoán hình ảnh được sử dụng để đánh giá tổn thương cột sống.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="chụp cộng hưởng từ cột sống">
  <data key="d0">chụp cộng hưởng từ cột sống</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Một phương pháp chẩn đoán hình ảnh được sử dụng để phát hiện tổn thương cột sống.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
