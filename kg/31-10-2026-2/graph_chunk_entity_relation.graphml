  <data key="d1">doi_tuong</data>
  <data key="d2">Là tài liệu hướng dẫn xử trí các tình trạng cấp cứu cơ bản, bao gồm NTH.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-003</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1793454119</data>
