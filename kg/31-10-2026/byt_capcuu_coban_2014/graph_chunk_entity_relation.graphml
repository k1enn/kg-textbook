</node>
<node id="điện tim">
  <data key="d0">điện tim</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một xét nghiệm dùng để chẩn đoán bệnh tim và các rối loạn nhịp tim do suy hô hấp.&lt;SEP&gt;Dùng để phát hiện các thay đổi của ST, sóng T hoặc bloc nhánh trái trong bệnh nhân nghi ngờ có nhồi máu cơ tim cấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793018209</data>
  <data key="d6"></data>
</node>
<node id="dị vật đường thở">
  <data key="d0">dị vật đường thở</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân gây suy hô hấp thường gặp, xuất hiện đột ngột với các triệu chứng khó thở và thở có tiếng rít.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="tràn khí màng phổi">
  <data key="d0">tràn khí màng phổi</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một tình trạng bệnh lý gây khó thở đột ngột, có thể xuất hiện sau gắng sức hoặc tự phát.&lt;SEP&gt;Là một biến chứng xảy ra khi có tổn thương ngực do chấn thương.&lt;SEP&gt;Là biến chứng xảy ra kèm theo mất máu nặng trong chấn thương</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="hô hấp hỗn hợp">
  <data key="d0">hô hấp hỗn hợp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng có cả giảm oxy máu và tăng CO2 trong máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="viêm phổi">
  <data key="d0">viêm phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý gây suy hô hấp do giảm oxy máu, có triệu chứng sốt, ho khạc đờm đục, khó thở.&lt;SEP&gt;Là bệnh lý gây suy hô hấp nặng, cần dùng mặt nạ không thở lại.&lt;SEP&gt;Một bệnh lý có thể là nguyên nhân gây ra sốc nhiễm khuẩn.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793017635</data>
  <data key="d6"></data>
</node>
<node id="hội chứng suy hô hấp tiến triển">
  <data key="d0">hội chứng suy hô hấp tiến triển</data>
  <data key="d1">benh</data>
  <data key="d2">Là biểu hiện của đáp ứng viêm hệ thống do tổn thương phổi hoặc nguyên nhân ngoài phổi, có tăng shunt và giảm oxy máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="tổn thương não do chấn thương">
  <data key="d0">tổn thương não do chấn thương</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng gây suy hô hấp tăng CO2 máu, có thể biến chứng suy hô hấp giảm oxy máu khi có sặc phổi hoặc bệnh phổi mạn.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="suy tim ứ huyết mất bù">
  <data key="d0">suy tim ứ huyết mất bù</data>
  <data key="d1">benh</data>
  <data key="d2">Là dạng suy hô hấp giảm oxy máu, có thể gặp thể tăng CO2 ở bệnh nhân có bệnh phổi mạn tính.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="x quang phổi">
  <data key="d0">x quang phổi</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm hình ảnh dùng để khẳng định chẩn đoán và đánh giá mức độ tổn thương phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="tắc nghẽn đường hô hấp trên">
  <data key="d0">tắc nghẽn đường hô hấp trên</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến cần đặt nội khí quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="mất phản xạ bảo vệ đường thở">
  <data key="d0">mất phản xạ bảo vệ đường thở</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến cần đặt nội khí quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="khả năng khạc đờm giảm nhiều hoặc mất">
  <data key="d0">khả năng khạc đờm giảm nhiều hoặc mất</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến cần đặt nội khí quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="toan hô hấp">
  <data key="d0">toan hô hấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý khi pH máu thấp dưới 7,25.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="paCO2 tăng dần">
  <data key="d0">paCO2 tăng dần</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số thể hiện sự gia tăng CO2 trong máu khi có nguy cơ giảm thông khí.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="thở nhanh và có cảm giác thiếu khí">
  <data key="d0">thở nhanh và có cảm giác thiếu khí</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng khi có nguy cơ giảm thông khí.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="liệt hoặc mệt cơ hoành">
  <data key="d0">liệt hoặc mệt cơ hoành</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng khi cơ hoành yếu, dẫn đến thở nghịch hoặc dung tích sống thấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="canuyn mũi">
  <data key="d0">canuyn mũi</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là dụng cụ thở oxy với dòng thấp 1-5 l/phút, nồng độ 24%-48%.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="mặt nạ ô xy">
  <data key="d0">mặt nạ ô xy</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là dụng cụ thở oxy với dòng 5-10 l/phút, nồng độ 35%-60%.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="mặt nạ không thở lại">
  <data key="d0">mặt nạ không thở lại</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là dụng cụ thở oxy với dòng 8-15 l/phút, nồng độ 60%-100%.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="mặt nạ venturi">
  <data key="d0">mặt nạ venturi</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là dụng cụ thở oxy có dòng cao, nồng độ 24%-50%, phù hợp cho COPD.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="copd">
  <data key="d0">copd</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Bệnh lý gây suy hô hấp do co thắt phế quản, được chỉ định dùng thuốc giãn phế quản và thông khí nhân tạo.&lt;SEP&gt;Là yếu tố nguy cơ làm tăng nguy cơ suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="ali">
  <data key="d0">ali</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý tổn thương màng phế nang mao mạch, gây suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="ards">
  <data key="d0">ards</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý tổn thương màng phế nang mao mạch, gây suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="phù phổi">
  <data key="d0">phù phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý gây suy hô hấp nặng do tổn thương màng phế nang mao mạch.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793017374</data>
  <data key="d6"></data>
</node>
<node id="corticoid">
  <data key="d0">corticoid</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc chỉ định cho các đợt cấp của hen phế quản và COPD.&lt;SEP&gt;là thuốc được dùng để hỗ trợ điều trị sốc phản vệ khi có rối loạn huyết động&lt;SEP&gt;Là loại thuốc được đề cập có thể giúp giảm phù nề tủy sống nếu dùng đúng liều và thời gian</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-004&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793019047</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp">
  <data key="d0">suy hô hấp</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d2">Khí máu động mạch được sử dụng để chẩn đoán và phân loại suy hô hấp.&lt;SEP&gt;Là biến chứng xảy ra do mất máu hoặc chấn thương, biểu hiện bằng thở nhanh và khó thở.&lt;SEP&gt;Một tình trạng bệnh lý khi chức năng hô hấp của cơ thể bị suy giảm nghiêm trọng.</data>
  <data key="d1">benh</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="khó thở">
  <data key="d0">khó thở</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-002&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-003</data>
  <data key="d2">Tràn khí màng phổi gây ra triệu chứng khó thở đột ngột.&lt;SEP&gt;Là một triệu chứng lâm sàng phổ biến xuất hiện khi có suy hô hấp hoặc rối loạn tuần hoàn.</data>
  <data key="d1">trieu_chung</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793017635</data>
  <data key="d6"></data>
</node>
<node id="tràn khí màng phổi áp lực">
  <data key="d0">tràn khí màng phổi áp lực</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-000&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-000&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-002</data>
  <data key="d2">Công đoạn cấp cứu được sử dụng để phòng ngừa biến chứng tràn khí màng phổi áp lực.&lt;SEP&gt;Nguyên nhân gây ngừng tuần hoàn do khí tích tụ trong màng phổi gây áp lực lên phổi.&lt;SEP&gt;Biến chứng do khí tích tụ trong màng phổi gây áp lực, đe dọa tính mạng trong chấn thương ngực.&lt;SEP&gt;Là biến chứng xảy ra do chấn thương ngực, gây áp lực lên màng phổi.&lt;SEP&gt;Một yếu tố tham gia thúc đẩy quá trình mất máu trong chấn thương&lt;SEP&gt;Là tình trạng xảy ra do chấn thương, có biểu hiện suy hô hấp và khí quản bị đẩy lệch.</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793020178</data>
  <data key="d6"></data>
</node>
<node id="sốc tim">
  <data key="d0">sốc tim</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Một dạng sốc do giảm cung lượng tim gây ra, biểu hiện bằng gan to, tĩnh mạch cổ nổi, phù phổi và đau ngực.&lt;SEP&gt;Là một biến chứng nghiêm trọng xảy ra do rối loạn chức năng tim mạch trong quá trình điều trị.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-003&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-004&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-005</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793018209</data>
  <data key="d6"></data>
</node>
<node id="sốc nhiễm khuẩn">
  <data key="d0">sốc nhiễm khuẩn</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Một dạng sốc do nhiễm trùng gây ra, biểu hiện bằng sốt, thể trạng nhiễm độc và viêm phổi.&lt;SEP&gt;Là biến chứng nặng xảy ra do nhiễm khuẩn sau viêm phúc mạc cấp do chấn thương bụng.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-000</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1793019879</data>
