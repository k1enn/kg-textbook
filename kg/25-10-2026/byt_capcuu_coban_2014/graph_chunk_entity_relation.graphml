  <data key="d12">1792918124</data>
  <data key="d13"></data>
</edge>
<edge source="phù phổi cấp" target="ngồi - chân thõng">
  <data key="d7">1.0</data>
  <data key="d8">Tư thế này được dùng để điều trị phù phổi cấp bằng cách giảm tuần hoàn tĩnh mạch trở về tim.</data>
  <data key="d9">dieu_tri,giảm tuần hoàn tĩnh mạch</data>
