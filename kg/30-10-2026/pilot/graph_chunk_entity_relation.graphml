  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="đáp ứng với điều trị">
  <data key="d0">đáp ứng với điều trị</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu cho thấy bệnh nhân phản ứng tích cực hoặc tiêu cực với việc điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="thăm dò">
  <data key="d0">thăm dò</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các xét nghiệm hoặc thăm dò được thực hiện để loại trừ hoặc khẳng định chẩn đoán.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="định hướng chuyển">
  <data key="d0">định hướng chuyển</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là quyết định về việc bệnh nhân được nhập viện, ra viện hoặc lưu theo dõi tại khoa cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="ngừng tuần hoàn">
  <data key="d0">ngừng tuần hoàn</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh nhân ngừng hoạt động tim mạch, cần can thiệp cấp cứu ngay lập tức.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="sốc điện">
  <data key="d0">sốc điện</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng rối loạn điện tim dẫn đến ngừng tuần hoàn, cần can thiệp bằng sốc điện cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="hội chứng động mạch vành cấp">
  <data key="d0">hội chứng động mạch vành cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý mạch máu tim cấp tính, cần can thiệp sớm trong thời gian cửa sổ điều trị.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="thời gian vàng">
  <data key="d0">thời gian vàng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian nhất định trong đó can thiệp sớm có thể cải thiện tiên lượng bệnh nhân cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793015500</data>
  <data key="d6"></data>
</node>
<node id="thượng vị nhanh">
  <data key="d0">thượng vị nhanh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một động tác dùng để đẩy cơ hoành lên trên, tăng áp lực lồng ngực và tạo luồng khí mạnh tống dị vật ra khỏi đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="ho">
  <data key="d0">ho</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một phản xạ tự nhiên khi có dị vật trong đường thở, tạo ra luồng khí mạnh để loại bỏ dị vật.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân đang ngồi hoặc đứng">
  <data key="d0">bệnh nhân đang ngồi hoặc đứng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh đang ở tư thế ngồi hoặc đứng khi thực hiện thủ thuật Heimlich.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân hôn mê">
  <data key="d0">bệnh nhân hôn mê</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh đang trong trạng thái hôn mê khi thực hiện thủ thuật Heimlich.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="thủ thuật Heimlich">
  <data key="d0">thủ thuật Heimlich</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật ép bụng để loại bỏ dị vật trong đường thở, thực hiện khi bệnh nhân tỉnh hoặc hôn mê.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="ép bụng">
  <data key="d0">ép bụng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật dùng tay để ép lên bụng bệnh nhân để tạo áp lực đẩy dị vật ra khỏi đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="vỗ lưng">
  <data key="d0">vỗ lưng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là động tác dùng để vỗ nhẹ lưng trẻ nhỏ để tống dị vật ra khỏi đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="ép ngực">
  <data key="d0">ép ngực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật dùng để ép ngực trẻ nhỏ khi vỗ lưng không hiệu quả để loại bỏ dị vật.&lt;SEP&gt;Động tác được thực hiện sau khi vỗ lưng không hiệu quả để đẩy dị vật ra khỏi trẻ.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="kỹ thuật lấy bỏ dị vật">
  <data key="d0">kỹ thuật lấy bỏ dị vật</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật thực hiện sau khi ép bụng để kiểm tra và lấy dị vật ra khỏi đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="dị vật">
  <data key="d0">dị vật</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là vật thể bị mắc kẹt trong đường thở, gây tắc nghẽn hô hấp và cần được loại bỏ bằng thủ thuật.&lt;SEP&gt;Vật thể lạ nằm trong đường thở của trẻ nhỏ cần được loại bỏ.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
</node>
<node id="đường thở">
  <data key="d0">đường thở</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là hệ thống đường dẫn khí từ mũi và miệng đến phổi, cần được đảm bảo không bị tắc nghẽn.&lt;SEP&gt;Khu vực cần được kiểm tra và làm sạch để đảm bảo thông thoáng khi thực hiện các động tác xử lý dị vật.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793015799</data>
  <data key="d6"></data>
