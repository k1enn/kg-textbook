  <data key="d0">phát hiện tràn khí màng phổi</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng lâm sàng cho thấy có tràn khí màng phổi trong bệnh nhân chấn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
