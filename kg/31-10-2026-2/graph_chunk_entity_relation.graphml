<node id="ấn giữ hàm">
  <data key="d0">ấn giữ hàm</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một kỹ thuật đơn giản để khai thông đường thở bằng cách ấn giữ hàm.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-000</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
