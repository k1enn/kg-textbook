  <data key="d2">Một xét nghiệm được thực hiện để hỗ trợ chẩn đoán tình trạng bệnh nhân</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-005</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="lồng ngực mất vững nặng">
  <data key="d0">lồng ngực mất vững nặng</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng mất vững cấu trúc lồng ngực do chấn thương, dẫn đến suy hô hấp và tổn thương cơ quan nội tạng.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="khó thở dữ dội">
  <data key="d0">khó thở dữ dội</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng nghiêm trọng, biểu hiện sự suy giảm chức năng hô hấp do tổn thương phổi hoặc lồng ngực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="huyết áp tụt">
  <data key="d0">huyết áp tụt</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu suy giảm tuần hoàn, thường xuất hiện trong tình trạng sốc hoặc chấn thương nặng.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="tiếng tim nghe mờ, nhịp tim nhanh">
  <data key="d0">tiếng tim nghe mờ, nhịp tim nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng cho thấy tổn thương tim hoặc rối loạn chức năng tim do chấn thương.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="điện tim: giảm điện thế ngoại biên">
  <data key="d0">điện tim: giảm điện thế ngoại biên</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là kết quả xét nghiệm điện tim cho thấy suy giảm hoạt động của tim do chấn thương.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="siêu âm: dịch màng ngoài tim">
  <data key="d0">siêu âm: dịch màng ngoài tim</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là kết quả chẩn đoán hình ảnh cho thấy có dịch tích tụ trong màng ngoài tim, gây ép tim.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="thở máy">
  <data key="d0">thở máy</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật hỗ trợ hô hấp bằng việc dùng máy thở để duy trì chức năng hô hấp cho bệnh nhân nặng.&lt;SEP&gt;Thở máy được chỉ định để hỗ trợ hô hấp khi bệnh nhân có suy hô hấp nặng.&lt;SEP&gt;Một thủ thuật can thiệp nhằm hỗ trợ hô hấp bằng máy thở.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-009&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="đặt hai đường truyền cỡ lớn">
  <data key="d0">đặt hai đường truyền cỡ lớn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật đặt đường truyền tĩnh mạch lớn để truyền dịch và thuốc trong tình trạng suy tuần hoàn.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="đụng dập tim">
  <data key="d0">đụng dập tim</data>
  <data key="d1">benh</data>
  <data key="d2">Là tổn thương tim do chấn thương, gây rối loạn chức năng tim và có thể dẫn đến suy tim cấp.&lt;SEP&gt;Tổn thương tim do va đập trực tiếp hoặc vỡ xương ức, thường dễ bị bỏ sót trong chấn thương ngực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="theo dõi áp lực tĩnh mạch trung tâm">
  <data key="d0">theo dõi áp lực tĩnh mạch trung tâm</data>
  <data key="d1">khac</data>
  <data key="d2">Đặt đường truyền trung tâm giúp phòng ngừa biến chứng do suy tuần hoàn trong ép tim cấp.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-006</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="va đập trực tiếp vào vùng tim">
  <data key="d0">va đập trực tiếp vào vùng tim</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra tổn thương tim do va đập trực tiếp vào vùng tim.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="vỡ xương ức">
  <data key="d0">vỡ xương ức</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra tổn thương tim do vỡ xương ức.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="đau ngực vùng trước tim">
  <data key="d0">đau ngực vùng trước tim</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng đau ngực ở vùng trước tim, dễ nhầm với đau do gẫy xương ức hoặc xương sườn.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="men tim tăng">
  <data key="d0">men tim tăng</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Xét nghiệm cho thấy mức độ tăng của các men tim như CPK, CPK-MB, SGOT, SGPT, Troponin I, T.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="ecg">
  <data key="d0">ecg</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Xét nghiệm điện tim cho thấy loạn nhịp tim, ST chênh lên và sóng T âm, ít khi có hình ảnh điển hình như nhồi máu cơ tim.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="đặt catheter tmtt">
  <data key="d0">đặt catheter tmtt</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật đặt catheter TMTT để xử trí sốc tim trong bệnh nhân đụng dập tim.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="dobutamin">
  <data key="d0">dobutamin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc vận mạch được sử dụng để xử trí sốc tim trong bệnh nhân đụng dập tim.&lt;SEP&gt;Một loại thuốc được dùng để điều trị tụt huyết áp do viêm cơ tim nhiễm độc.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nhồi máu cơ tim">
  <data key="d0">nhồi máu cơ tim</data>
  <data key="d1">benh</data>
  <data key="d2">Trường hợp nghiêm trọng có thể nhầm với đụng dập tim do triệu chứng tương tự.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="dập vỡ động mạch chủ do chấn thương">
  <data key="d0">dập vỡ động mạch chủ do chấn thương</data>
  <data key="d1">benh</data>
  <data key="d2">Tổn thương động mạch chủ do chấn thương, có tỷ lệ tử vong cao đến 90%.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
