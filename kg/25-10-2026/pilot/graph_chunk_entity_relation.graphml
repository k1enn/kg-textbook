  <data key="d7">1.0</data>
  <data key="d8">Ức chế hô hấp hoặc liệt hô hấp là nguyên nhân gây bệnh lý hô hấp có thể không có triệu chứng X quang rõ.</data>
  <data key="d9">nguyen_nhan_cua</data>
