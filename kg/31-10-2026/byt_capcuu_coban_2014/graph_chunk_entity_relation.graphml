  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ra bỏng rất sâu và có thể dẫn đến ngừng tim.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
