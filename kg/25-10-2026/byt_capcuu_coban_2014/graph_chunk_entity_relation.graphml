  <data key="d0">khám chấn thương nhanh</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một phương pháp đánh giá nhanh các tổn thương trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
