</node>
<node id="đồng tử không đều hai bên">
  <data key="d0">đồng tử không đều hai bên</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu máu tụ nội sọ do tổn thương não gây ra.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
