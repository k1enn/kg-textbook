  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật dùng để đánh giá áp lực mao mạch phổi và đo cung lượng tim.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-003</data>
