  <data key="d0">đè lưỡi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Dụng cụ dùng để ấn lưỡi khi đặt canuyn, giúp tạo không gian mở cho đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="chất bôi trơn canuyn">
  <data key="d0">chất bôi trơn canuyn</data>
  <data key="d1">khac</data>
  <data key="d2">Chất được dùng để bôi trơn bề mặt canuyn nhằm giảm ma sát khi đặt vào đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="guedel">
  <data key="d0">guedel</data>
  <data key="d1">khac</data>
  <data key="d2">Loại canuyn miệng hầu có các cỡ khác nhau, được sử dụng trong kỹ thuật đặt canuyn hầu.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="berman">
  <data key="d0">berman</data>
  <data key="d1">khac</data>
  <data key="d2">Loại canuyn miệng hầu có các cỡ khác nhau, được sử dụng trong kỹ thuật đặt canuyn hầu.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="đầu trong canuyn">
  <data key="d0">đầu trong canuyn</data>
  <data key="d1">khac</data>
  <data key="d2">Phần đầu trong của canuyn được đặt ở góc lưỡi và trên nắp thanh môn khi đặt đúng vị trí.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="đầu ngoài của canuyn">
  <data key="d0">đầu ngoài của canuyn</data>
  <data key="d1">khac</data>
  <data key="d2">Phần đầu ngoài của canuyn được đặt ở bên ngoài cung răng khi đặt đúng vị trí.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="lưỡi">
  <data key="d0">lưỡi</data>
  <data key="d1">khac</data>
  <data key="d2">Cơ quan sinh lý được dùng để ấn khi đặt canuyn, nếu không được kiểm soát có thể gây tắc nghẽn đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="thành họng">
  <data key="d0">thành họng</data>
  <data key="d1">khac</data>
  <data key="d2">Bề mặt bên trong của họng, khi đặt canuyn cần tách lưỡi ra khỏi thành họng để mở đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="thanh môn">
  <data key="d0">thanh môn</data>
  <data key="d1">khac</data>
  <data key="d2">Cơ cấu ở đầu họng, khi đặt canuyn đúng vị trí thì đầu trong canuyn nằm trên nắp thanh môn.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="cung răng">
  <data key="d0">cung răng</data>
  <data key="d1">khac</data>
  <data key="d2">Đường viền của răng, phần đầu ngoài của canuyn được đặt ở bên ngoài cung răng khi đặt đúng vị trí.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="đặt canuyn sai vị trí">
  <data key="d0">đặt canuyn sai vị trí</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Khi đặt canuyn không đúng vị trí, sẽ đẩy lưỡi ra sau gây tắc nghẽn thêm đường thở.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="cơ bản hỗ trợ các chức năng sống">
  <data key="d0">cơ bản hỗ trợ các chức năng sống</data>
  <data key="d1">khac</data>
  <data key="d2">Biện pháp được thực hiện trước khi thực hiện kỹ thuật đặt canuyn hầu để đảm bảo an toàn cho bệnh nhân.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-005</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân tỉnh hoặc bán mê">
  <data key="d0">bệnh nhân tỉnh hoặc bán mê</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhóm bệnh nhân có trạng thái ý thức tỉnh hoặc bán mê, có nguy cơ gây khạc, nôn hoặc co thắt thanh quản khi sử dụng canuyn</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453031</data>
  <data key="d6"></data>
</node>
<node id="chấn thương khoang miệng">
  <data key="d0">chấn thương khoang miệng</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Một tình trạng tổn thương vùng khoang miệng làm cản trở việc sử dụng canuyn miệng họng</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="chấn thương xương hàm dưới">
  <data key="d0">chấn thương xương hàm dưới</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Một tình trạng tổn thương xương hàm dưới làm cản trở việc sử dụng canuyn miệng họng</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="tổn thương choán chỗ">
  <data key="d0">tổn thương choán chỗ</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Một tình trạng tổn thương tại vị trí choán chỗ làm cản trở việc sử dụng canuyn miệng họng hoặc mũi hầu</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="dị vật ở miệng họng">
  <data key="d0">dị vật ở miệng họng</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Một tình trạng có vật lạ ở miệng họng làm cản trở việc đặt canuyn</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="chiều dài thích hợp">
  <data key="d0">chiều dài thích hợp</data>
  <data key="d1">chi_so</data>
  <data key="d2">Giá trị chiều dài canuyn tương xứng với khoảng cách từ dái tai đến chân cánh mũi</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="dị vật ở vùng mũi">
  <data key="d0">dị vật ở vùng mũi</data>
  <data key="d1">khac</data>
  <data key="d2">Không nên sử dụng canuyn mũi hầu khi có dị vật ở vùng mũi</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-006</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="canun">
  <data key="d0">canun</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">là một thiết bị dùng để tạo đường thở qua mũi-họng, được đặt bằng cách dùng đè lưỡi để kiểm tra vị trí</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="mặt nạ thanh quản">
  <data key="d0">mặt nạ thanh quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">là một loại đường thở cố định, được sản xuất dưới dạng ống silicon hoặc nhựa, dùng để tạo đường thở cho bệnh nhân hôn mê&lt;SEP&gt;Là thiết bị hỗ trợ để kiểm soát đường thở bằng mặt nạ thanh quản.&lt;SEP&gt;Là thiết bị hỗ trợ thông khí bằng cách che phủ thanh quản của bệnh nhân.&lt;SEP&gt;Là thiết bị hỗ trợ đường thở được đặt vào thanh quản để duy trì thông khí.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-002&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1793457333</data>
  <data key="d6"></data>
</node>
<node id="cuff">
  <data key="d0">cuff</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">là phần nối của mặt nạ thanh quản với bóng cuff, được đặt để ép sát vào vòm họng</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="hình 12">
  <data key="d0">hình 12</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">là hình ảnh minh họa các cỡ khác nhau của canuyn mũi-họng và vị trí đặt</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="hình 13">
  <data key="d0">hình 13</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">là hình ảnh minh họa mặt nạ thanh quản được sử dụng trong thực tiễn</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="hình 14">
  <data key="d0">hình 14</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">là hình ảnh minh họa vị trí đặt mặt nạ thanh quản</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="cỡ số 4">
  <data key="d0">cỡ số 4</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">là cỡ mặt nạ thanh quản thường dùng cho người lớn</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="chọc">
  <data key="d0">chọc</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Hành động chọc kim hoặc dụng cụ để lấy mẫu hoặc xâm nhập vào cơ thể.&lt;SEP&gt;là một thủ thuật dùng để tạo đường thở bằng cách chọc vào màng nhẫn giáp</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-008</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="mở màng nhẫn giáp">
  <data key="d0">mở màng nhẫn giáp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">là một thủ thuật mở đường thở bằng cách tạo khe hở tại màng nhẫn giáp&lt;SEP&gt;Là kỹ thuật mở màng nhẫn giáp để giải phóng nghẽn đường thở trong cấp cứu.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-007&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="quản">
  <data key="d0">quản</data>
  <data key="d1">khac</data>
  <data key="d2">Thao tác y khoa liên quan đến việc mở đường thở bằng cách mở khí quản.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-008</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="mở màng">
  <data key="d0">mở màng</data>
  <data key="d1">khac</data>
  <data key="d2">Thao tác mở màng phổi hoặc màng bao quanh cơ quan nội tạng.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-008</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1793453032</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp cấp">
  <data key="d0">suy hô hấp cấp</data>
  <data key="d1">khac</data>
  <data key="d2">một cấp cứu nội khoa xảy ra khi hệ thống hô hấp không thể đáp ứng được nhu cầu chuyển hóa của cơ thể&lt;SEP&gt;Là tình trạng suy giảm chức năng hô hấp cấp tính do chấn thương ngực hoặc tổn thương đường thở.&lt;SEP&gt;Breathing được sử dụng để phát hiện và xử trí các dấu hiệu gây suy hô hấp cấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-001&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1793457333</data>
  <data key="d6"></data>
</node>
<node id="thiếu ô xy máu">
  <data key="d0">thiếu ô xy máu</data>
  <data key="d1">benh</data>
  <data key="d2">dạng suy hô hấp khi PaO2 ≤ 50-60mmHg</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="tăng co2 máu">
  <data key="d0">tăng co2 máu</data>
  <data key="d1">benh</data>
  <data key="d2">dạng suy hô hấp khi PaCO2 ≥ 50 mmHg kèm theo tình trạng toan máu pH &lt; 7,36&lt;SEP&gt;Là một dấu hiệu lâm sàng xuất hiện trong tổn thương não do chấn thương, dẫn đến suy hô hấp có tăng CO2 máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="thể hỗn hợp">
  <data key="d0">thể hỗn hợp</data>
  <data key="d1">benh</data>
  <data key="d2">dạng suy hô hấp vừa có giảm ô xy hóa máu và tăng CO2 máu, hay gặp trên bệnh nhân nặng</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="khó thở">
  <data key="d0">khó thở</data>
  <data key="d1">khac</data>
  <data key="d2">triệu chứng báo hiệu quan trọng và nhạy, biểu hiện bằng nhịp thở nhanh, chậm hoặc loạn nhịp&lt;SEP&gt;Là một triệu chứng lâm sàng thường xuất hiện trong các bệnh lý về phổi như COPD, viêm phổi và ARDS.&lt;SEP&gt;Khó thở là triệu chứng chủ yếu do ứ trệ tuần hoàn tim khi có sốc tắc nghẽn.&lt;SEP&gt;Một triệu chứng lâm sàng xuất hiện khi có tràn máu màng phổi nhiều.&lt;SEP&gt;Là triệu chứng khó thở có thể dữ dội do tổn thương thanh-khí-phế quản.&lt;SEP&gt;Là một triệu chứng lâm sàng do suy hô hấp hoặc chấn thương.&lt;SEP&gt;Tư thế nửa ngồi - chân thẳng được áp dụng khi bệnh nhân khó thở và còn tỉnh, giúp cơ hoành dễ di động hơn</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-002&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-008&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-010</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tím">
  <data key="d0">tím</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">biểu hiện của suy hô hấp nặng khi Hb khử &gt; 5g/dL, xuất hiện từ môi đến toàn thân&lt;SEP&gt;Là dấu hiệu lâm sàng xuất hiện khi PaO2 &lt; 45 mmHg, đặc biệt khi bệnh nhân bị thiếu máu.&lt;SEP&gt;Là một dấu hiệu lâm sàng xuất hiện khi bệnh nhân có tình trạng thiếu oxy trong máu</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="vã mồ hôi">
  <data key="d0">vã mồ hôi</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">dấu hiệu lâm sàng xuất hiện khi bệnh nhân có suy hô hấp cấp&lt;SEP&gt;Là một triệu chứng lâm sàng xuất hiện khi bệnh nhân bị suy hô hấp nặng do ngộ độc khí CO.&lt;SEP&gt;Là một dấu hiệu lâm sàng phản ánh tình trạng cơ thể đang cố gắng điều hòa nhiệt độ và phản ứng với tình trạng thiếu oxy</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="mạch nhanh">
  <data key="d0">mạch nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">rối loạn tim mạch biểu hiện bằng nhịp tim nhanh, có thể kèm theo rối loạn nhịp&lt;SEP&gt;Là một dấu hiệu lâm sàng trong rối loạn tim mạch do ngộ độc khí CO, có thể kèm theo rối loạn nhịp tim.&lt;SEP&gt;Một dấu hiệu thiếu máu do hệ thống tuần hoàn phản ứng với tình trạng mất máu.&lt;SEP&gt;Một triệu chứng lâm sàng biểu hiện bằng nhịp tim nhanh, thường thấy trong hội chứng thần kinh giao cảm.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="pao2">
  <data key="d0">pao2</data>
  <data key="d1">chi_so</data>
  <data key="d2">chỉ số đo nồng độ oxy trong máu, dưới 50-60mmHg cho thấy thiếu ô xy máu</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paco2">
  <data key="d0">paco2</data>
  <data key="d1">chi_so</data>
  <data key="d2">chỉ số đo nồng độ CO2 trong máu, trên 50 mmHg cho thấy tăng CO2 máu&lt;SEP&gt;Chỉ số đo nồng độ CO2 trong máu, tăng dần khi có nguy cơ giảm thông khí.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="ph">
  <data key="d0">ph</data>
  <data key="d1">chi_so</data>
  <data key="d2">chỉ số đo độ acid-base, dưới 7,36 cho thấy tình trạng toan máu&lt;SEP&gt;Là chỉ số pH máu, với giá trị từ 7,35 đến 7,45 cho mức bình thường, giảm xuống dưới 7,25 khi suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="kussmaul">
  <data key="d0">kussmaul</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">loạn nhịp thở là một dạng của khó thở</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
