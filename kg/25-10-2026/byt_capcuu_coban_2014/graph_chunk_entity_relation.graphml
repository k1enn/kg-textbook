  <data key="d0">dấu hiện thần kinh khu trú</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một dấu hiệu lâm sàng cho thấy tổn thương thần kinh ở một vùng cụ thể trong bệnh nhân chấn thương.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
