  <data key="d0">tưới máu mô</data>
  <data key="d1">khac</data>
  <data key="d2">Acid lactic được dùng để đánh giá tình trạng tưới máu mô trong cơ thể.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
