  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật được thực hiện sớm ngay khi có thể để theo dõi hoạt động điện tim.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
