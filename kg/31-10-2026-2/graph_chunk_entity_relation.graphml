  <data key="d0">gẫy chân</data>
  <data key="d1">benh</data>
  <data key="d2">Một tình trạng chấn thương xương do va chạm hoặc tác động mạnh.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
