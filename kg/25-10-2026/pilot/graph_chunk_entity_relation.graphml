  <data key="d2">Dấu hiệu lâm sàng cho thấy bệnh nhân có thể làm sạch đường thở bằng cách ho.&lt;SEP&gt;Là hiện tượng sinh lý khi có sự tống dị vật ra khỏi đường thở tương tự như động tác thượng vị nhanh.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001&lt;SEP&gt;02-cac-ky-thuat-kiem-soat-duong-tho-chunk-002</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1792917436</data>
  <data key="d6"></data>
</node>
<node id="khó thở">
  <data key="d0">khó thở</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng lâm sàng khi bệnh nhân không thể thở bình thường.&lt;SEP&gt;Là triệu chứng báo hiệu quan trọng và nhạy, thể hiện bằng nhịp thở nhanh, chậm hoặc loạn nhịp.&lt;SEP&gt;Là triệu chứng lâm sàng xuất hiện trong bệnh phổi tắc nghẽn mạn tính và viêm phổi.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="tím thì">
  <data key="d0">tím thì</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Dấu hiệu lâm sàng cho thấy thiếu oxy trong cơ thể.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1792917436</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp">
  <data key="d0">suy hô hấp</data>
  <data key="d1">benh</data>
  <data key="d2">Bệnh lý xảy ra khi chức năng hô hấp của cơ thể bị suy giảm.&lt;SEP&gt;Là tình trạng bệnh lý liên quan đến suy giảm chức năng hô hấp.&lt;SEP&gt;Là tình trạng suy giảm chức năng hô hấp, thể hiện qua các dấu hiệu lâm sàng như thở nhanh, mạch nhanh, tăng huyết áp và tím.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792917620</data>
  <data key="d6"></data>
</node>
<node id="phù não">
  <data key="d0">phù não</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng bệnh lý khi não bị tích nước do lý do sinh học.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
  <data key="d5">1792917436</data>
  <data key="d6"></data>
</node>
<node id="TBMN">
  <data key="d0">TBMN</data>
  <data key="d1">benh</data>
  <data key="d2">Một dạng bệnh lý về hệ thần kinh do tổn thương trong não.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-001</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
