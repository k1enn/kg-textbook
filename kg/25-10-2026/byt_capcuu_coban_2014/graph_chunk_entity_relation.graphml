<node id="SpO2 &gt; 90%">
  <data key="d0">SpO2 &gt; 90%</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là ngưỡng đảm bảo ô xy hóa máu trong điều trị suy hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="ALI">
  <data key="d0">ALI</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh tổn thương màng phế nang mao mạch, cần dùng mặt nạ ô xy hoặc mặt nạ không thở lại.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="ARDS">
  <data key="d0">ARDS</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh tổn thương màng phế nang mao mạch, cần dùng mặt nạ không thở lại hoặc mặt nạ venturi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="Viêm phổi">
  <data key="d0">Viêm phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh nặng cần dùng mặt nạ không thở lại.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="Phù phổi">
  <data key="d0">Phù phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh nặng cần dùng mặt nạ không thở lại.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="Tổn thương màng phế nang mao mạch">
  <data key="d0">Tổn thương màng phế nang mao mạch</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây suy hô hấp mức độ nặng, cần dùng thiết bị thở phù hợp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân">
  <data key="d0">bệnh nhân</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhóm người bệnh cần được hỗ trợ thông khí và điều trị theo các chỉ định lâm sàng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="nồng độ ô xy từ 24%- 50%">
  <data key="d0">nồng độ ô xy từ 24%- 50%</data>
  <data key="d1">chi_so</data>
  <data key="d2">Giá trị nồng độ oxy được sử dụng trong điều trị cho bệnh nhân COPD với yêu cầu chính xác.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="thông khí nhân tạo">
  <data key="d0">thông khí nhân tạo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật hỗ trợ hô hấp cho bệnh nhân suy hô hấp do phù phổi cấp huyết động hoặc đợt cấp COPD.&lt;SEP&gt;Là thủ thuật hỗ trợ hô hấp bằng cách cung cấp khí nhân tạo cho bệnh nhân.&lt;SEP&gt;Một thủ thuật được sử dụng để cung cấp oxy cho bệnh nhân khi có suy hô hấp hoặc rối loạn ý thức.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-003&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="thông khí nhân tạo không xâm nhập áp lực dương">
  <data key="d0">thông khí nhân tạo không xâm nhập áp lực dương</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật hỗ trợ thông khí qua mặt nạ mũi, miệng hoặc toàn bộ mặt cho bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp do phù phổi cấp huyết động">
  <data key="d0">suy hô hấp do phù phổi cấp huyết động</data>
  <data key="d1">benh</data>
  <data key="d2">Bệnh lý hô hấp nặng do phù phổi cấp huyết động, được chỉ định thông khí nhân tạo.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="đợt cấp của COPD">
  <data key="d0">đợt cấp của COPD</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng cấp tính của bệnh COPD, cần điều trị bằng thuốc giãn phế quản và corticoid.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="HFQ">
  <data key="d0">HFQ</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng suy hô hấp được chỉ định khi kết hợp với thông khí nhân tạo trong điều trị.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp nặng có dấu hiệu mệt cơ">
  <data key="d0">suy hô hấp nặng có dấu hiệu mệt cơ</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng mệt cơ khi bệnh nhân thở gắng sức và tần số thở vượt quá 30 lần/phút.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="TS thở &gt; 30/min">
  <data key="d0">TS thở &gt; 30/min</data>
  <data key="d1">chi_so</data>
  <data key="d2">Giá trị tần số thở trên 30 lần mỗi phút, là dấu hiệu của suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="toan hô hấp cấp">
  <data key="d0">toan hô hấp cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Trạng thái rối loạn pH máu do mất cân bằng oxy hóa, với giá trị pH dưới 7,25-7,30.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="tình trạng oxy hoá máu tồi đi">
  <data key="d0">tình trạng oxy hoá máu tồi đi</data>
  <data key="d1">chi_so</data>
  <data key="d2">Tỷ lệ PaO2/FiO2 dưới 200, cho thấy tình trạng oxy hóa máu kém.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="thuốc giãn phế quản">
  <data key="d0">thuốc giãn phế quản</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc chủ yếu dùng để giãn phế quản trong COPD và hen phế quản, ưu tiên đường khí dung.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="chất chủ vận β2">
  <data key="d0">chất chủ vận β2</data>
  <data key="d1">thuoc</data>
  <data key="d2">Loại thuốc kháng cholinergic được dùng trong điều trị suy hô hấp do co thắt phế quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="thuốc kháng cholinergic">
  <data key="d0">thuốc kháng cholinergic</data>
  <data key="d1">thuoc</data>
  <data key="d2">Loại thuốc hỗ trợ giãn phế quản trong COPD và hen phế quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="corticoid">
  <data key="d0">corticoid</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc chỉ định trong đợt cấp của hen phế quản và COPD.&lt;SEP&gt;Là một loại thuốc dùng để điều trị sốc phản vệ, giúp giảm phản ứng dị ứng</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-004&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1792918441</data>
  <data key="d6"></data>
</node>
<node id="kháng sinh">
  <data key="d0">kháng sinh</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng khi có dấu hiệu viêm phổi hoặc nhiễm khuẩn trong đợt cấp COPD.&lt;SEP&gt;Thuốc dùng để điều trị sốc nhiễm trùng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1792918441</data>
  <data key="d6"></data>
</node>
<node id="lợi tiểu">
  <data key="d0">lợi tiểu</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng để điều trị suy tim, phù phổi cấp huyết động và quá tải thể tích.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="phù phổi cấp huyết động">
  <data key="d0">phù phổi cấp huyết động</data>
  <data key="d1">benh</data>
  <data key="d2">Bệnh lý do huyết động bất thường gây phù phổi, được chỉ định thông khí nhân tạo và lợi tiểu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="suy tim ứ huyết">
  <data key="d0">suy tim ứ huyết</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Bệnh lý tim do tích tụ máu, được điều trị bằng thuốc lợi tiểu.&lt;SEP&gt;Là một biến chứng nghiêm trọng xảy ra khi tim không thể bơm máu hiệu quả, dẫn đến ứ huyết trong các mạch máu.&lt;SEP&gt;Là biến chứng cần được theo dõi và điều trị kịp thời sau khi điều trị tiêu sợi huyết.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="thăm khám kỹ phổi">
  <data key="d0">thăm khám kỹ phổi</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d2">Là triệu chứng được ghi nhận trong thăm khám kỹ phổi</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="PaCO2">
  <data key="d0">PaCO2</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d2">Khi PaCO2 &gt; 60 mmHg, bệnh nhân có thể có tình trạng suy hô hấp nặng hoặc nguy hiểm.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
