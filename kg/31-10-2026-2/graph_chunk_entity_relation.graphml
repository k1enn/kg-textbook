  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật dùng để loại trừ dị vật ở trẻ nhỏ khi nghiệm pháp Heimlich có thể gây chấn thương bụng.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
