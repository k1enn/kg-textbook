  <data key="d0">xương cánh tay</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại gãy xương ở cánh tay, có thể mất lượng máu từ 500 đến 750 ml.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xương chày, mác">
  <data key="d0">xương chày, mác</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại gãy xương ở vùng chày hoặc mác, có thể mất lượng máu từ 500 đến 1000 ml.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xương đùi">
  <data key="d0">xương đùi</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại gãy xương ở đùi, có thể mất lượng máu từ 1000 đến 2000 ml.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xương chậu">
  <data key="d0">xương chậu</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại gãy xương ở xương chậu, có thể mất lượng máu từ 1500 đến 3000 ml.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="vết thương đứt rời">
  <data key="d0">vết thương đứt rời</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng tổn thương mô mềm và cơ thể do đứt rời, có thể dẫn đến tổn thương khoang.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="hội chứng chèn ép khoang">
  <data key="d0">hội chứng chèn ép khoang</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng do các mô mềm hoặc xương bị chèn ép trong khoang, gây ảnh hưởng đến chức năng.&lt;SEP&gt;Là tình trạng xảy ra khi có sự chèn ép vào khoang cơ, dẫn đến tổn thương cơ và các chức năng liên quan.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="một tấm vải">
  <data key="d0">một tấm vải</data>
  <data key="d1">khac</data>
  <data key="d2">Là vật liệu dùng để quấn quanh khung chậu và buộc chặt khi trải giường.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="gai chậu trước trên">
  <data key="d0">gai chậu trước trên</data>
  <data key="d1">khac</data>
  <data key="d2">Điểm tham chiếu trên xương chậu dùng để xác định bề rộng khi trải giường.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="xương mu">
  <data key="d0">xương mu</data>
  <data key="d1">khac</data>
  <data key="d2">Cấu trúc xương ở vùng bụng dùng làm điểm tham chiếu khi đo bề rộng để trải giường.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="hội chứng khoang">
  <data key="d0">hội chứng khoang</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng tăng áp lực trong khoang giải phẫu dẫn đến suy giảm tuần hoàn và thiếu máu cục bộ.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="chèn ép khoang">
  <data key="d0">chèn ép khoang</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng khoang do chèn ép giữa các lớp cân mạc.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="băng">
  <data key="d0">băng</data>
  <data key="d1">khac</data>
  <data key="d2">Vật liệu dùng để cố định, có thể gây chèn ép nếu quá chặt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="nẹp">
  <data key="d0">nẹp</data>
  <data key="d1">khac</data>
  <data key="d2">Vật liệu cố định dùng để bảo vệ chi sau chấn thương, có thể gây chèn ép nếu quá chặt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="bó bột">
  <data key="d0">bó bột</data>
  <data key="d1">khac</data>
  <data key="d2">Vật liệu cố định dùng để bảo vệ chi sau chấn thương, có thể gây chèn ép nếu quá chặt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="chảy máu trong khoang">
  <data key="d0">chảy máu trong khoang</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng khoang do vết thương mạch máu trong khoang.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="viêm sưng tấy các bó cơ">
  <data key="d0">viêm sưng tấy các bó cơ</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng khoang do viêm sưng ở các bó cơ.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="tổn thương phối hợp gãy xương">
  <data key="d0">tổn thương phối hợp gãy xương</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng khoang do tổn thương kết hợp gãy xương và chấn thương rách cơ.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="trật khớp">
  <data key="d0">trật khớp</data>
  <data key="d1">benh</data>
  <data key="d2">Là chấn thương xảy ra khi khớp bị tổn thương, mất vận động và có dấu hiệu lò xo và biến dạng.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="vết thương đứt rời hoàn toàn">
  <data key="d0">vết thương đứt rời hoàn toàn</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng phần chi đứt rời và mỏm cụt không có cấu trúc giải phẫu nào nối kết với nhau.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="vết thương đứt rời không hoàn toàn">
  <data key="d0">vết thương đứt rời không hoàn toàn</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng phần chi đứt rời và mỏm cụt còn có cấu trúc giải phẫu nối với nhau như xương, cân cơ.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="chẩn đoán sớm hội chứng khoang">
  <data key="d0">chẩn đoán sớm hội chứng khoang</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Xét nghiệm nhằm phát hiện sớm hội chứng khoang trong tình trạng chèn ép khoang.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="tháo hoặc nới băng">
  <data key="d0">tháo hoặc nới băng</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật thực hiện để giảm chèn ép bằng cách tháo hoặc nới băng nẹp hoặc băng quá chặt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="giữ chi ở ngang mức tim">
  <data key="d0">giữ chi ở ngang mức tim</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật giữ chi ở mức ngang tim để duy trì tuần hoàn và giảm chèn ép.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="kháng sinh dự phòng">
  <data key="d0">kháng sinh dự phòng</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng để phòng ngừa nhiễm trùng trong các tình trạng chấn thương hoặc vết thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="hội chẩn chuyên khoa ngoại">
  <data key="d0">hội chẩn chuyên khoa ngoại</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhóm người bệnh được hội chẩn chuyên khoa ngoại để xử trí các trường hợp chấn thương hoặc vết thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793020612</data>
  <data key="d6"></data>
</node>
<node id="đầu 9%">
  <data key="d0">đầu 9%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có vùng bỏng ở đầu với tỷ lệ 9% diện tích cơ thể.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="chi trên 9%">
  <data key="d0">chi trên 9%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có vùng bỏng ở chi trên với tỷ lệ 9% diện tích cơ thể.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="chi dưới 18%">
  <data key="d0">chi dưới 18%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có vùng bỏng ở chi dưới với tỷ lệ 18% diện tích cơ thể.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="bộ phận sinh dục ngoài 1%">
  <data key="d0">bộ phận sinh dục ngoài 1%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có vùng bỏng ở bộ phận sinh dục ngoài với tỷ lệ 1% diện tích cơ thể.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="độ 1">
  <data key="d0">độ 1</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại bỏng có biểu hiện da đỏ, đau do kích thích đầu mút dây thần kinh, thường lành sau 3 ngày.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="độ 2a">
  <data key="d0">độ 2a</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại bỏng nông, lan rộng, đau nhiều, rỉ nước, tổn thương bề mặt da.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="độ 2b">
  <data key="d0">độ 2b</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại bỏng sâu, đau ít hơn, có vùng tê, da dính chặt, ấn kính dương, sẹo hình thành trong 3 tuần có thể xấu.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="độ 3">
  <data key="d0">độ 3</data>
  <data key="d1">benh</data>
  <data key="d2">Là loại bỏng có vùng da trắng bóng, đỏ tươi hoặc nâu, không đau, da bám chặt, cần ghép da.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="bỏng điện">
  <data key="d0">bỏng điện</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng do tiếp xúc với dòng điện.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="bỏng hóa chất">
  <data key="d0">bỏng hóa chất</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây bỏng do tiếp xúc với hóa chất, cần rửa sớm và chuyển mắt đến chuyên khoa mắt.&lt;SEP&gt;Là loại bỏng gây tổn thương nặng và đau đớn do tiếp xúc với các hóa chất như acid, kiềm, vôi nước tôi, phospho.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="đặt ống nội khí quản">
  <data key="d0">đặt ống nội khí quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật can thiệp để đảm bảo đường thở khi có suy hô hấp nặng hoặc rối loạn ý thức.&lt;SEP&gt;Một thủ thuật được thực hiện để duy trì đường thở trong tình trạng suy hô hấp hoặc rối loạn ý thức.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="thông khí nhân tạo">
  <data key="d0">thông khí nhân tạo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật hỗ trợ hô hấp bằng cách cung cấp khí nhân tạo khi có suy hô hấp nặng.&lt;SEP&gt;Một thủ thuật được sử dụng để cung cấp oxy và thay thế hô hấp tự nhiên khi bệnh nhân không thể thở được.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="rối loạn ý thức">
  <data key="d0">rối loạn ý thức</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Một triệu chứng lâm sàng thể hiện sự mất kiểm soát trong trạng thái nhận thức của bệnh nhân.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="natri clorua 0,9%">
  <data key="d0">natri clorua 0,9%</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại dịch truyền được sử dụng để bù thể tích tuần hoàn trong bệnh nhân.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="theo dõi mạch">
  <data key="d0">theo dõi mạch</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Một hoạt động theo dõi để đánh giá tình trạng tuần hoàn của bệnh nhân.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
