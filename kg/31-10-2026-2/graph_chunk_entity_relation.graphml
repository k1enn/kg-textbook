  <data key="d0">hội chứng brown-sequard</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng tổn thương một nửa tủy sống, thường gặp do vết thương xuyên thấu hoặc u chèn ép.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
