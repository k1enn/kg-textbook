<node id="duy trì huyết áp">
  <data key="d0">duy trì huyết áp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật duy trì huyết áp bằng cách đặt đường truyền và truyền dịch tinh thể hoặc dịch cao phân tử.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-008</data>
