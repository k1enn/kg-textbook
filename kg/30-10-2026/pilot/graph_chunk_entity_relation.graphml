  <data key="d1">khac</data>
  <data key="d2">Vị trí cụ thể trên cơ thể trẻ nhỏ để thực hiện động tác vỗ lưng.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
