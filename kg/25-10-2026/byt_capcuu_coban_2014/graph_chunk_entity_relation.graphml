<edge source="chẩn đoán" target="đáp ứng với điều trị">
  <data key="d7">2.0</data>
  <data key="d8">Triệu chứng đáp ứng với điều trị giúp định hướng chẩn đoán bệnh lý một cách chính xác hơn.&lt;SEP&gt;Đáp ứng với điều trị được dùng để hỗ trợ phòng ngừa các bệnh lý trong chẩn đoán.</data>
  <data key="d9">phong_ngua,phản ứng với điều trị,trieu_chung_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
