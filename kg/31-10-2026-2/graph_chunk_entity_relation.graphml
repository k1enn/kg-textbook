  <data key="d0">tổn thương sừng trước tủy sống</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ra hội chứng sừng trước do tổn thương sừng trước tủy sống.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
