  <data key="d6"></data>
</node>
<node id="thông báo cho bác sỹ chính">
  <data key="d0">thông báo cho bác sỹ chính</data>
  <data key="d1">khac</data>
  <data key="d2">Là việc thông báo cho bác sĩ chính về việc chuyển bệnh nhân, ai sẽ thực hiện và các nguy cơ khi rời khoa</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="hồ sơ bệnh án">
  <data key="d0">hồ sơ bệnh án</data>
  <data key="d1">khac</data>
  <data key="d2">Là tài liệu ghi chép chỉ định vận chuyển và diễn biến trong quá trình vận chuyển&lt;SEP&gt;Tài liệu tổng hợp tình trạng bệnh nhân, điều trị và theo dõi y tế trong quá trình điều trị.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="y tá hồi sức cấp cứu">
  <data key="d0">y tá hồi sức cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhân viên y tá được đào tạo để hỗ trợ trong quá trình vận chuyển bệnh nhân</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="bác sỹ">
  <data key="d0">bác sỹ</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Người có trách nhiệm giám sát và can thiệp trong trường hợp bệnh nhân có nguy cơ rối loạn chức năng sống hoặc cần can thiệp cấp cứu.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="máy theo dõi điện tim">
  <data key="d0">máy theo dõi điện tim</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật dùng để theo dõi hoạt động điện tim của bệnh nhân trong quá trình vận chuyển.&lt;SEP&gt;Dùng để theo dõi hoạt động điện tim của bệnh nhân liên tục&lt;SEP&gt;Thiết bị theo dõi hoạt động điện tim của bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-008</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="máy phá rung">
  <data key="d0">máy phá rung</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật được sử dụng để can thiệp trong trường hợp rối loạn nhịp tim nặng.&lt;SEP&gt;Thiết bị dùng để can thiệp vào hoạt động điện tim của bệnh nhân&lt;SEP&gt;Thiết bị can thiệp để phục hồi nhịp tim bất thường trong bệnh nhân nguy kịch.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-008</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="phương tiện can thiệp hô hấp">
  <data key="d0">phương tiện can thiệp hô hấp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thiết bị hỗ trợ hô hấp được mang theo trong quá trình vận chuyển bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="bóng mặt nạ">
  <data key="d0">bóng mặt nạ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thiết bị dùng để cung cấp oxy cho bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="lidocain">
  <data key="d0">lidocain</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc được dùng để điều trị các rối loạn nhịp tim do điện thế bất thường.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="vận mạch">
  <data key="d0">vận mạch</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng để cải thiện tuần hoàn và duy trì huyết áp trong bệnh nhân suy tuần hoàn.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="máy truyền dịch">
  <data key="d0">máy truyền dịch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thiết bị dùng để truyền dịch vào cơ thể bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="máy thở khi vận chuyển">
  <data key="d0">máy thở khi vận chuyển</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thiết bị dùng để duy trì hô hấp cho bệnh nhân trong quá trình vận chuyển, đảm bảo các chức năng cơ bản như máy thở tại khoa hồi sức cấp cứu.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nồng độ oxy máu">
  <data key="d0">nồng độ oxy máu</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số được theo dõi để đảm bảo lượng oxy trong máu đủ để duy trì chức năng sinh lý của bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="etco2">
  <data key="d0">etco2</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số đo nồng độ CO2 trong khí thở, được theo dõi đặc biệt trong bệnh nhân có rối loạn hô hấp.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="áp lực động mạch phổi">
  <data key="d0">áp lực động mạch phổi</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số đo áp lực trong động mạch phổi, được theo dõi để đánh giá chức năng phổi của bệnh nhân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="áp lực nội sọ">
  <data key="d0">áp lực nội sọ</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số đo áp lực trong não, được theo dõi để phát hiện tình trạng suy giảm chức năng não.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="vận chuyển giữa các bệnh viện">
  <data key="d0">vận chuyển giữa các bệnh viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Hoạt động di chuyển bệnh nhân từ một bệnh viện sang bệnh viện khác để tiếp nhận chăm sóc hồi sức tích cực hơn.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="chăm sóc hồi sức tích cực hơn">
