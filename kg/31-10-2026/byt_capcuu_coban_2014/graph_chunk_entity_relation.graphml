  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật can thiệp để loại bỏ khí tích tụ trong màng phổi khi nghi ngờ có chấn thương ngực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-000</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793019575</data>
