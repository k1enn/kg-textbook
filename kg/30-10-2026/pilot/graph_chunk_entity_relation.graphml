  <data key="d12">1793015500</data>
  <data key="d13"></data>
</edge>
<edge source="ngừng tuần hoàn" target="thời gian vàng">
  <data key="d7">1.0</data>
  <data key="d8">Thời gian vàng bắt đầu từ 5 phút đầu sau khi ngừng tuần hoàn, là khoảng thời gian tối ưu để can thiệp.</data>
  <data key="d9">can thiệp,nguong_cua</data>
  <data key="d10">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d11">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d12">1793015500</data>
  <data key="d13"></data>
</edge>
<edge source="sốc điện" target="thời gian vàng">
  <data key="d7">1.0</data>
  <data key="d8">Sốc điện cấp cứu cần được thực hiện trong vòng 5 phút đầu sau ngừng tuần hoàn để đạt hiệu quả cao nhất.</data>
  <data key="d9">can thiệp,nguong_cua</data>
