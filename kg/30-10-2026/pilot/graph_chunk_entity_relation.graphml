  <data key="d1">khac</data>
  <data key="d2">Quy trình xác định xem các động tác đã thành công trong việc loại bỏ dị vật hay chưa.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-003</data>
