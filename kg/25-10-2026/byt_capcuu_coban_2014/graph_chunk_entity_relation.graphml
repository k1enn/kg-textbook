  <data key="d1">thuoc</data>
  <data key="d2">Một thuốc được truyền tĩnh mạch khi có tình trạng toan hóa máu trong xử trí phân ly điện cơ.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
