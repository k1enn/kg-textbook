  <data key="d0">toan hô hấp cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Trạng thái hô hấp cấp với pH dưới 7,25-7,30</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-007</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="thuốc giãn phế quản">
  <data key="d0">thuốc giãn phế quản</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc giãn phế quản có tác dụng chủ vận β2 và kháng cholinergic</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-007</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="corticoid">
  <data key="d0">corticoid</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc chỉ định trong các đợt cấp của hen phế quản và COPD&lt;SEP&gt;Thuốc được sử dụng để giảm tình trạng phù tủy sống trong chấn thương cột sống.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-007&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="lợi tiểu">
  <data key="d0">lợi tiểu</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc dùng để giảm phù phổi cấp huyết động và quá tải thể tích trong suy tim</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-007</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="sốc">
  <data key="d0">sốc</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là bệnh cảnh thường gặp trong khoa Cấp cứu và Hồi sức, đặc trưng bởi giảm tưới máu toàn cơ thể dẫn đến thiếu oxy tế bào và tổn thương cơ quan.&lt;SEP&gt;Một tình trạng lâm sàng nghiêm trọng liên quan đến suy giảm chức năng tuần hoàn và các biến chứng liên quan.&lt;SEP&gt;Phenylephrine được dùng để điều trị các loại sốc&lt;SEP&gt;Trạng thái bệnh nền có thể làm trầm trọng thêm tình trạng chấn thương và cần xử trí kịp thời.&lt;SEP&gt;Là tình trạng mất máu dẫn đến giảm lưu lượng máu đến các tạng quan trọng và rối loạn chức năng cơ quan.&lt;SEP&gt;Bệnh nhân có tình trạng sốc là nhóm có nguy cơ cao khi di dời</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-003&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-005&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-001&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-004</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="thiểu niệu">
  <data key="d0">thiểu niệu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng của sốc, do giảm lưu lượng máu đến thận gây giảm lọc cầu thận và có thể dẫn đến suy thận.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="thay đổi về ý thức">
  <data key="d0">thay đổi về ý thức</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu của sốc, thể hiện bằng sự thay đổi về ý thức như hốt hoảng, lơ mơ hoặc hôn mê ở giai đoạn muộn.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="da lạnh">
  <data key="d0">da lạnh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng của sốc, thể hiện bằng da lạnh và xuất hiện vã mồ hôi.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="suy đa tạng">
  <data key="d0">suy đa tạng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là biến chứng nghiêm trọng của sốc, dẫn đến tổn thương cơ quan đích và suy đa tạng nếu không được điều trị kịp thời.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="toan chuyển hóa">
  <data key="d0">toan chuyển hóa</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Toan chuyển hóa là một hậu quả nghiêm trọng xảy ra khi sốc tiến triển đến giai đoạn muộn.&lt;SEP&gt;Là triệu chứng của sốc, do thiếu oxy tế bào gây ra, dẫn đến tăng chuyển hóa và giải phóng chất độc tố.&lt;SEP&gt;Do chuyển hóa yếm khí sinh lactic và mất khả năng thanh lọc lactate của gan, thận, cơ.&lt;SEP&gt;Biến chứng xảy ra do tăng lactat máu và thiếu oxy trong cơ thể khi sốc tiến triển nặng.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-002&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-001</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="da lạnh, ẩm">
  <data key="d0">da lạnh, ẩm</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng do co mạch trong tình trạng sốc nhiễm khuẩn, có thể kèm theo nổi vân tím.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="bụng chướng">
  <data key="d0">bụng chướng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Xuất hiện do giảm tưới máu tạng trong ổ bụng và thiếu máu mạc treo.&lt;SEP&gt;Là một triệu chứng lâm sàng xuất hiện khi có chấn thương bụng.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-001</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1793457333</data>
  <data key="d6"></data>
</node>
<node id="sốc giảm thể tích">
  <data key="d0">sốc giảm thể tích</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Gây ra do ỉa chảy, mất máu, chấn thương làm giảm thể tích tuần hoàn.&lt;SEP&gt;Dopamine được dùng để điều trị sốc giảm thể tích bằng cách bù đủ khối lượng tuần hoàn</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-005</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="sốc tim">
  <data key="d0">sốc tim</data>
  <data key="d1">benh</data>
  <data key="d2">Loại sốc do giảm cung lượng tim, gây tụt huyết áp và cơ thể phản ứng bằng cách co mạch máu.&lt;SEP&gt;Gây ra do đau ngực, gan to, tĩnh mạch cổ nổi, phù chi dưới và rale phổi.&lt;SEP&gt;Dobutamine được dùng để điều trị sốc tim bằng cách trợ tim và bơm bóng ngược&lt;SEP&gt;Là một biến chứng xảy ra sau khi điều trị tiêu sợi huyết, biểu hiện bằng tình trạng suy giảm chức năng tim.&lt;SEP&gt;Một tình trạng nguy hiểm do rối loạn hoạt động của tim.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-002&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-005&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-004&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-005</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="sốc phản vệ">
  <data key="d0">sốc phản vệ</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Gây ra do các biểu hiện dị ứng và tiền sử dùng thuốc.&lt;SEP&gt;Adrenaline được dùng để điều trị sốc phản vệ khi có rối loạn huyết động</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-005</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="sốc tắc nghẽn">
  <data key="d0">sốc tắc nghẽn</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Loại sốc do nhồi máu phổi hoặc ép tim cấp làm tim không thể tống máu vào đại tuần hoàn.&lt;SEP&gt;Gây ra do nhồi máu phổi lớn hoặc huyết khối tĩnh mạch sâu.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-002</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="khí máu">
  <data key="d0">khí máu</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Dùng để đánh giá tình trạng toan máu trong cơ thể.&lt;SEP&gt;Là xét nghiệm dùng để đo nồng độ oxy và carbon dioxide trong máu sau chấn thương.&lt;SEP&gt;Là một xét nghiệm để đánh giá tình trạng oxy hóa và carbon dioxide trong máu.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-005&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-003</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md</data>
  <data key="d5">1793457333</data>
  <data key="d6"></data>
</node>
<node id="acid lactic">
  <data key="d0">acid lactic</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Dùng để đánh giá tình trạng tưới máu mô trong cơ thể.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="chức năng gan thận">
  <data key="d0">chức năng gan thận</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Được đánh giá để xác định tổn thương cơ quan đích trong sốc.&lt;SEP&gt;xét nghiệm chức năng gan thận để đánh giá tình trạng cơ quan nội tạng</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-004</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="đông máu">
  <data key="d0">đông máu</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Được đánh giá trong quá trình kiểm tra tổn thương cơ quan đích trong sốc.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1793453785</data>
  <data key="d6"></data>
</node>
<node id="hô hấp">
  <data key="d0">hô hấp</data>
  <data key="d1">khac</data>
  <data key="d2">Được đánh giá trong quá trình kiểm tra tổn thương cơ quan đích trong sốc.&lt;SEP&gt;Hô hấp là triệu chứng được đánh giá trong bước đánh giá ban đầu của bệnh nhân chấn thương.&lt;SEP&gt;Oxy liệu pháp được sử dụng để hỗ trợ hô hấp trong tình trạng suy hô hấp cấp.&lt;SEP&gt;Là chức năng sinh lý liên quan đến việc trao đổi khí giữa cơ thể và môi trường.&lt;SEP&gt;Thở oxy mũi mask được dùng để điều trị suy hô hấp ở bệnh nhân bị bỏng.&lt;SEP&gt;Chức năng hô hấp bị ảnh hưởng khi nạn nhân bị bỏng vùng mặt, cổ, đặc biệt khi bị kẹt trong nhà cháy, dẫn đến phù mặt cổ và các biến chứng đường hô hấp.&lt;SEP&gt;Là dấu hiệu lâm sàng thể hiện khi bệnh nhân có suy hô hấp, thở nhanh, xanh tím, vã mồ hôi, co kéo cơ hô hấp.&lt;SEP&gt;Phương tiện can thiệp hô hấp được dùng để bảo vệ chức năng hô hấp của bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-005&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-000&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">04-xu-tri-cap-cuu-soc.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="suy thận">
  <data key="d0">suy thận</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tình trạng chức năng thận bị suy giảm do tổn thương ống thận và chức năng thận.&lt;SEP&gt;Là một bệnh lý kèm theo trong bệnh NMCT cấp, làm tăng nguy cơ diễn tiến nặng.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-001&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
