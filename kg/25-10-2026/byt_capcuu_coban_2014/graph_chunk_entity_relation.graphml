  <data key="d0">đường huyết</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
  <data key="d2">Điều chỉnh đường huyết nhằm duy trì mức</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="cân nhắc đặt nội khí quản sớm">
  <data key="d0">cân nhắc đặt nội khí quản sớm</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-004</data>
  <data key="d2">Bệnh nhân có Glasgow ≤ 8 hoặc suy giảm ý thức nhanh cần được cân nhắc đặt nội khí quản sớm để bảo vệ đường thở.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="kích thích dãy dụa">
  <data key="d0">kích thích dãy dụa</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-004</data>
  <data key="d2">Việc kích thích dãy dụa có thể làm tăng áp lực nội sọ và làm trầm trọng tổn thương não.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="chấn thương sọ não nhẹ">
  <data key="d0">chấn thương sọ não nhẹ</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-004</data>
  <data key="d2">Các nguyên nhân gây hôn mê như hạ đường huyết và ngộ độc cần được loại trừ trong chấn thương sọ não nhẹ.</data>
