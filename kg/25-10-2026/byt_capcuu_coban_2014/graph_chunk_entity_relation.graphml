  <data key="d1">khac</data>
  <data key="d2">Phân loại các tình huống di dời bệnh nhân theo mức độ cấp thiết.&lt;SEP&gt;Việc chia nhóm các tình huống di dời bệnh nhân theo mức độ khẩn cấp và điều kiện cụ thể.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
