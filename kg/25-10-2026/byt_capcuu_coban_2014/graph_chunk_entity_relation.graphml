  <data key="d0">tụt hạ đường huyết</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ngừng tuần hoàn do nồng độ đường huyết giảm thấp.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="thương tích">
  <data key="d0">thương tích</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây ngừng tuần hoàn do tổn thương cơ thể do chấn thương.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="khả năng cứu sống">
  <data key="d0">khả năng cứu sống</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số đánh giá khả năng sống sót của bệnh nhân sau khi ngừng tuần hoàn, phụ thuộc vào kỹ năng cấp cứu tại chỗ.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="khoảng thời gian từ khi gọi cấp cứu đến khi kíp cấp cứu có mặt">
  <data key="d0">khoảng thời gian từ khi gọi cấp cứu đến khi kíp cấp cứu có mặt</data>
  <data key="d1">chi_so</data>
  <data key="d2">Thời gian trung bình từ khi gọi cấp cứu đến khi đội cấp cứu đến hiện trường, thường trên 5 phút.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="nguyên nhân gây ngừng tuần hoàn">
  <data key="d0">nguyên nhân gây ngừng tuần hoàn</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Tác nhân dẫn đến tình trạng ngừng tuần hoàn, cần được xác định để điều trị kịp thời.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="điều trị nhanh chóng">
  <data key="d0">điều trị nhanh chóng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Điều kiện cho phép điều trị các nguyên nhân gây ngừng tuần hoàn trong thời gian ngắn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-000</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Tension pneumothorax">
  <data key="d0">Tension pneumothorax</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một biến chứng nghiêm trọng do áp lực trong khoang ngực tăng cao, gây giảm chức năng phổi và có thể dẫn đến tử vong nếu không xử trí kịp thời.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Tăng / Tụt kali">
  <data key="d0">Tăng / Tụt kali</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là hiện tượng thay đổi nồng độ kali trong máu, biểu hiện qua các triệu chứng như rối loạn nhịp tim, yếu cơ, hoặc mất ý thức.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Hyper-/">
  <data key="d0">Hyper-/</data>
  <data key="d1">khac</data>
  <data key="d2">Là một cụm từ không hoàn chỉnh, không thể xác định rõ nội dung hoặc loại thực thể.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Hypokalemi a">
  <data key="d0">Hypokalemi a</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng thiếu hụt kali trong máu, gây ảnh hưởng đến chức năng cơ và tim.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Tụt hạ đường huyết">
  <data key="d0">Tụt hạ đường huyết</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng giảm nồng độ đường huyết, gây ra các triệu chứng như chóng mặt, ngất xỉu, hoặc mất ý thức.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Hypoglycem ia">
  <data key="d0">Hypoglycem ia</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng giảm đường huyết nghiêm trọng, có thể gây nguy hiểm đến tính mạng nếu không điều trị kịp thời.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Thương tích">
  <data key="d0">Thương tích</data>
  <data key="d1">benh</data>
  <data key="d2">Là tổn thương cơ thể do chấn thương, có thể ảnh hưởng đến nhiều hệ cơ quan.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Trauma">
  <data key="d0">Trauma</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ra các tổn thương cơ thể, đặc biệt là do va chạm hoặc tai nạn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Thân nhiệt thấp">
  <data key="d0">Thân nhiệt thấp</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng khi nhiệt độ cơ thể giảm xuống dưới mức bình thường.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Hypothermi a">
  <data key="d0">Hypothermi a</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng suy giảm nhiệt độ cơ thể, có thể dẫn đến rối loạn chức năng sinh lý và nguy cơ tử vong.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="5T 6H">
  <data key="d0">5T 6H</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một khung chẩn đoán được sử dụng để phân loại các tình trạng cấp cứu trong bệnh nhân có dấu hiệu nguy kịch.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="11 T">
  <data key="d0">11 T</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là phiên bản tiếng Việt của khung 5T 6H, dùng để dễ nhớ trong thực hành cấp cứu.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="đặt ngửa đầu, cổ ưỡn, thủ thuật kéo hàm dưới/nâng cằm">
  <data key="d0">đặt ngửa đầu, cổ ưỡn, thủ thuật kéo hàm dưới/nâng cằm</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các bước thực hiện để kiểm soát đường thở trong cấp cứu, giúp mở rộng đường thở cho bệnh nhân.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="ép tim ngoài lồng ngực">
  <data key="d0">ép tim ngoài lồng ngực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật hồi sinh tim phổi cơ bản nhằm duy trì tuần hoàn khi bệnh nhân không còn mạch.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="kiểm tra mạch cảnh (hoặc mạch bẹn)">
  <data key="d0">kiểm tra mạch cảnh (hoặc mạch bẹn)</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một xét nghiệm lâm sàng để đánh giá tuần hoàn của bệnh nhân trong cấp cứu.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Khoa cấp cứu">
  <data key="d0">Khoa cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một đơn vị y tế chuyên xử trí các trường hợp cấp cứu ngay tại bệnh viện.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="cái thối ngạt 1 cái">
  <data key="d0">cái thối ngạt 1 cái</data>
  <data key="d1">khac</data>
  <data key="d2">Một tình trạng không rõ ràng được đề cập trong văn bản, có thể là một sai sót hoặc cách diễn đạt không chuẩn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Ngừng 5 giây sau phút đầu để kiểm tra mạch">
  <data key="d0">Ngừng 5 giây sau phút đầu để kiểm tra mạch</data>
  <data key="d1">khac</data>
  <data key="d2">Một quy trình kiểm tra mạch sau phút đầu tiên trong cấp cứu, nhằm xác định tình trạng tuần hoàn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Ép tim trẻ em 100 - 120 nhịp/phút, người lớn">
  <data key="d0">Ép tim trẻ em 100 - 120 nhịp/phút, người lớn</data>
  <data key="d1">khac</data>
  <data key="d2">Tốc độ ép tim được quy định theo độ tuổi, với trẻ em từ 100 đến 120 nhịp/phút và người lớn được chỉ định tốc độ tương ứng.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Sốc điện là phương pháp hiệu quả nhất">
  <data key="d0">Sốc điện là phương pháp hiệu quả nhất</data>
  <data key="d1">khac</data>
  <data key="d2">Sốc điện được coi là phương pháp điều trị hiệu quả nhất trong các tình huống cấp cứu.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Nhanh chóng ghi điện tim và theo dõi điện tim trên máy theo dõi">
  <data key="d0">Nhanh chóng ghi điện tim và theo dõi điện tim trên máy theo dõi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một thủ thuật được thực hiện ngay lập tức để ghi và theo dõi điện tim trong quá trình cấp cứu.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Phân loại 3 loại điện tim: rung thất/nhịp nhanh thất, vô tâm thu, phân ly điện cơ">
  <data key="d0">Phân loại 3 loại điện tim: rung thất/nhịp nhanh thất, vô tâm thu, phân ly điện cơ</data>
  <data key="d1">khac</data>
  <data key="d2">Quy trình phân loại ba loại điện tim khác nhau để đánh giá tình trạng nhịp tim trong cấp cứu.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Tiến hành sốc điện ngay nếu là rung thất">
  <data key="d0">Tiến hành sốc điện ngay nếu là rung thất</data>
  <data key="d1">khac</data>
  <data key="d2">Các bước hành động được thực hiện ngay khi phát hiện tình trạng rung thất trong điện tim.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Máy sốc điện 1 pha: số 360 J; Máy sốc điện 2 pha: 120-200 J, sốc điện không đồng bộ">
  <data key="d0">Máy sốc điện 1 pha: số 360 J; Máy sốc điện 2 pha: 120-200 J, sốc điện không đồng bộ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Các thông số kỹ thuật của máy sốc điện được nêu ra, bao gồm mức năng lượng và kiểu sốc điện.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Tiến hành ngay 5 chu kỳ ép tim/thổi ngạt sau mỗi lần sốc điện">
  <data key="d0">Tiến hành ngay 5 chu kỳ ép tim/thổi ngạt sau mỗi lần sốc điện</data>
  <data key="d1">khac</data>
  <data key="d2">Một quy trình được thực hiện ngay sau mỗi lần sốc điện, bao gồm 5 chu kỳ ép tim và thổi ngạt.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Ngừng tuần hoàn thường xảy ra đột ngột, không dự đoán trước được">
  <data key="d0">Ngừng tuần hoàn thường xảy ra đột ngột, không dự đoán trước được</data>
  <data key="d1">khac</data>
  <data key="d2">Tình trạng ngừng tuần hoàn xảy ra đột ngột và không thể dự đoán trước.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Tất cả các nhân viên cấp cứu, nhân viên y tế cứu hộ phải được tập luyện và chẩn bị sẵn sàng cấp cứu ngừng tuần hoàn">
  <data key="d0">Tất cả các nhân viên cấp cứu, nhân viên y tế cứu hộ phải được tập luyện và chẩn bị sẵn sàng cấp cứu ngừng tuần hoàn</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Nhân viên cấp cứu và y tế cứu hộ cần được tập luyện và sẵn sàng để xử lý tình trạng ngừng tuần hoàn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="Các xe cấp cứu, các cơ sở cấp cứu cần có các phương tiện và thuốc cấp cứu cần thiết cho cấp cứu ngừng tuần hoàn">
  <data key="d0">Các xe cấp cứu, các cơ sở cấp cứu cần có các phương tiện và thuốc cấp cứu cần thiết cho cấp cứu ngừng tuần hoàn</data>
  <data key="d1">khac</data>
  <data key="d2">Các xe và cơ sở cấp cứu cần được trang bị đầy đủ phương tiện và thuốc để xử lý tình trạng ngừng tuần hoàn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-002</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="thân nhiệt thấp">
  <data key="d0">thân nhiệt thấp</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001</data>
  <data key="d2">Phiên bản 11 T giúp nhận diện các triệu chứng như thân nhiệt thấp trong bệnh nhân bị chấn thương.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1792918516</data>
  <data key="d6"></data>
</node>
<node id="hồi sinh tim phổi nâng cao">
  <data key="d0">hồi sinh tim phổi nâng cao</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Kỹ thuật hồi sinh tim phổi nâng cao nhằm kiểm soát tưới máu não và tim tốt hơn và nhanh chóng tái lập tuần hoàn.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1792918589</data>
  <data key="d6"></data>
</node>
<node id="rung thất sóng nhỏ">
  <data key="d0">rung thất sóng nhỏ</data>
  <data key="d1">benh</data>
  <data key="d2">Loại rối loạn điện tim cần phân biệt với vô tâm thu khi xét điện tâm đồ.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1792918589</data>
  <data key="d6"></data>
</node>
<node id="phân ly điện cơ">
  <data key="d0">phân ly điện cơ</data>
  <data key="d1">benh</data>
  <data key="d2">Trạng thái bệnh lý cần phân biệt với sốc và trụy mạch khi có dấu hiệu mất mạch.&lt;SEP&gt;Tình trạng có sóng điện tâm đồ nhưng không bắt được mạch tim.&lt;SEP&gt;Một tình trạng y học có hình ảnh sóng điện tâm đồ nhưng không có mạch cảnh.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-002</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1792918589</data>
  <data key="d6"></data>
</node>
<node id="tắc mạch">
  <data key="d0">tắc mạch</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây mất mạch cảnh do tắc mạch, cần phân biệt với các tình trạng khác.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-000</data>
  <data key="d4">06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1792918589</data>
  <data key="d6"></data>
</node>
<node id="phác đồ cấp cứu nâng cao ngừng tuần hoàn">
