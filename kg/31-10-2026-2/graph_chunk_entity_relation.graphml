  <data key="d0">bóp bóng qua nội khí quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật hỗ trợ hô hấp bằng cách bóp bóng qua nội khí quản.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="đặt catheter tm trung tâm">
  <data key="d0">đặt catheter tm trung tâm</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật đặt catheter trung tâm để theo dõi và hỗ trợ tuần hoàn trong bệnh nhân nặng.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="truyền dịch tinh thể">
  <data key="d0">truyền dịch tinh thể</data>
  <data key="d1">thuoc</data>
  <data key="d2">Việc truyền dịch tinh thể để bù khối lượng tuần hoàn trong trường hợp sốc.&lt;SEP&gt;Một phương pháp truyền dịch để bù nước và điện giải trong tình trạng mất máu.&lt;SEP&gt;Việc truyền dịch tinh thể để bù dịch trong chấn thương.&lt;SEP&gt;Việc truyền dịch tinh thể để bù nước và điện giải trong điều trị chấn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-004&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-001</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="truyền máu">
  <data key="d0">truyền máu</data>
  <data key="d1">thuoc</data>
  <data key="d2">Việc truyền máu để xử trí khi có mất máu nặng.&lt;SEP&gt;Một phương pháp truyền máu để bù máu khi có mất máu nặng.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="các chế phẩm máu">
  <data key="d0">các chế phẩm máu</data>
  <data key="d1">thuoc</data>
  <data key="d2">Các sản phẩm máu được sử dụng trong trường hợp mất máu nặng.&lt;SEP&gt;Các sản phẩm từ máu được sử dụng trong điều trị chấn thương nặng.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-001</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="khám chi tiết">
  <data key="d0">khám chi tiết</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Quá trình khám toàn diện từ đầu đến chân để phát hiện tổn thương chấn thương.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-005</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="chiếu chụp">
