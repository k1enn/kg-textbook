  <data key="d1">bien_chung</data>
  <data key="d2">Là một tình trạng kéo dài 6 giờ có thể gây hoại tử cơ.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="thời gian giải ép">
  <data key="d0">thời gian giải ép</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là khoảng thời gian từ 6 đến 13 giờ mà vẫn giữ được chi an toàn sau chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="phẫu thuật giải chèn ép">
  <data key="d0">phẫu thuật giải chèn ép</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật thực hiện sau 15-36 giờ, nhưng thường dễ gây biến chứng.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
