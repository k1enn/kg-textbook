  <data key="d6"></data>
</node>
<node id="khám đồng tử">
  <data key="d0">khám đồng tử</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật đánh giá tình trạng thần kinh bằng việc quan sát đồng tử.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-003</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1793455017</data>
