</node>
<node id="Naloxon">
  <data key="d0">Naloxon</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong điều trị quá liều thuốc phiện.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
