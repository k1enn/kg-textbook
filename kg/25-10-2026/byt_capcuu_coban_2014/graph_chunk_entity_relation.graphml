<graph edgedefault="undirected"><node id="Nguy kịch (khẩn cấp)">
  <data key="d0">Nguy kịch (khẩn cấp)</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương, rối loạn đe dọa tính mạng với nguy cơ tử vong nhanh chóng nếu không được can thiệp cấp cứu ngay.&lt;SEP&gt;Bệnh nhân có bệnh lý, tổn thương, rối loạn đe dọa tính mạng, nguy cơ tử vong nhanh nếu không được can thiệp cấp cứu ngay.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Cấp cứu (emergency)">
  <data key="d0">Cấp cứu (emergency)</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý, tổn thương, rối loạn có thể tiến triển nặng nếu không được can thiệp điều trị nhanh chóng.&lt;SEP&gt;Bệnh nhân có bệnh lý, tổn thương, rối loạn có thể tiến triển nặng nếu không được can thiệp điều trị nhanh chóng.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Công tác thực hành cấp cứu">
  <data key="d0">Công tác thực hành cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là nhiệm vụ đánh giá, xử trí và điều trị cho các bệnh nhân có bệnh lý, tổn thương hoặc rối loạn cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Hạn chế về thời gian">
  <data key="d0">Hạn chế về thời gian</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là yếu tố làm cho việc thu thập thông tin, đánh giá và đưa ra chẩn đoán, xử trí phải diễn ra rất khẩn trương trong tình trạng bệnh lý cấp tính tiến triển nhanh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Cần đánh giá nhanh và ra quyết định với lượng thông tin hạn chế, chưa đầy đủ">
  <data key="d0">Cần đánh giá nhanh và ra quyết định với lượng thông tin hạn chế, chưa đầy đủ</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là thách thức trong việc đưa ra chẩn đoán và xử trí dựa vào thông tin sơ bộ, chưa đầy đủ khi tiếp cận bệnh nhân trong thời gian ngắn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Không gian và môi trường làm việc">
  <data key="d0">Không gian và môi trường làm việc</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là điều kiện làm việc tại khoa cấp cứu với áp lực cao do không gian mở, đông bệnh nhân và tiếp xúc với bên ngoài.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Rèn luyện kỹ năng thăm khám và cấp cứu bệnh nhân theo 2 bước (primary và secondary)">
  <data key="d0">Rèn luyện kỹ năng thăm khám và cấp cứu bệnh nhân theo 2 bước (primary và secondary)</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là phương pháp rèn luyện kỹ năng thăm khám và cấp cứu bệnh nhân theo hai bước: primary và secondary.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="Tác phong khẩn trương và phản ứng theo trình tự">
  <data key="d0">Tác phong khẩn trương và phản ứng theo trình tự</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thái độ và hành vi phản ứng theo trình tự khi xử trí bệnh nhân cấp cứu trong tình huống khẩn cấp.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-000</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="thời gian">
  <data key="d0">thời gian</data>
  <data key="d1">khac</data>
  <data key="d2">Là yếu tố ảnh hưởng đến môi trường làm việc tại khoa cấp cứu, tạo ra áp lực do thiếu thông tin đầy đủ và không ổn định.&lt;SEP&gt;Một yếu tố ảnh hưởng đến việc đưa ra quyết định trong cấp cứu.&lt;SEP&gt;Khái niệm thời gian được dùng để mô tả giai đoạn phát triển của sốc.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-005&lt;SEP&gt;04-xu-tri-cap-cuu-soc-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;04-xu-tri-cap-cuu-soc.md</data>
  <data key="d5">1792918441</data>
  <data key="d6"></data>
</node>
<node id="không gian và môi trường làm việc">
  <data key="d0">không gian và môi trường làm việc</data>
  <data key="d1">khac</data>
  <data key="d2">Là điều kiện làm việc tại khoa cấp cứu, nằm gần cổng bệnh viện, có không gian mở, đông bệnh nhân và người thân, dòng người di chuyển nhanh, gây lộn xộn và khó kiểm soát.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="môi trường làm việc tại khoa cấp cứu">
  <data key="d0">môi trường làm việc tại khoa cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Là không gian làm việc có áp lực cao do đông bệnh nhân, đông người thân, dòng người di chuyển nhanh và nhiều tiếng ồn, khó kiểm soát trật tự và vệ sinh.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="trong cấp cứu trước khi đến viện">
  <data key="d0">trong cấp cứu trước khi đến viện</data>
  <data key="d1">khac</data>
  <data key="d2">Là tình huống nhân viên y tế làm việc ngoài trời, trong môi trường không có hỗ trợ y tế, thời tiết không thuận lợi và có nguy cơ nguy hiểm cho nhân viên.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nhiều lo lắng và dễ bị phân tâm">
  <data key="d0">nhiều lo lắng và dễ bị phân tâm</data>
  <data key="d1">khac</data>
  <data key="d2">Là hiện tượng nhân viên y tế bị phân tâm do phải xử lý nhiều việc như tiếp nhận giấy tờ, thủ tục hành chính, trật tự, phân luồng bệnh nhân, ảnh hưởng đến tập trung chuyên môn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nguy cơ bị đe dọa về tinh thần và bạo lực">
  <data key="d0">nguy cơ bị đe dọa về tinh thần và bạo lực</data>
  <data key="d1">khac</data>
  <data key="d2">Là rủi ro nhân viên y tế gặp phải do bệnh nhân, gia đình hoặc người thân mất bình tĩnh và có hành vi kích động, hung hãn.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="suy nghĩ để xác nhận hoặc loại trừ các bệnh lý/rối loạn nặng đe dọa tính mạng">
  <data key="d0">suy nghĩ để xác nhận hoặc loại trừ các bệnh lý/rối loạn nặng đe dọa tính mạng</data>
  <data key="d1">khac</data>
  <data key="d2">Là mục tiêu chính trong cấp cứu, không chỉ nhằm tìm chẩn đoán mà còn để xác nhận hoặc loại trừ các bệnh lý nặng đe dọa tính mạng hoặc bộ phận của bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nguy cơ bị quá tải">
  <data key="d0">nguy cơ bị quá tải</data>
  <data key="d1">khac</data>
  <data key="d2">Là tình trạng khoa cấp cứu nhận nhiều bệnh nhân hơn công suất, dẫn đến nguy cơ bệnh nhân bị bỏ sót khi ra viện mà chưa được xem.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="lượng bệnh nhân đến cấp cứu">
  <data key="d0">lượng bệnh nhân đến cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Là chỉ số thay đổi theo thời gian trong ngày, tuần, mùa, và rất khó dự đoán, dẫn đến tình trạng quá tải công việc và bệnh nhân.&lt;SEP&gt;Số lượng bệnh nhân đến khoa cấp cứu, được mô tả là khó dự đoán chính xác.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="công suất">
  <data key="d0">công suất</data>
  <data key="d1">khac</data>
  <data key="d2">Là mức độ hoạt động tối đa của khoa cấp cứu, khi đạt đến 140% sẽ có nguy cơ quá tải và bệnh nhân bị bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-001</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="giữa các ngày trong tuần">
  <data key="d0">giữa các ngày trong tuần</data>
  <data key="d1">khac</data>
  <data key="d2">Một khoảng thời gian trong tuần được nhắc đến như một yếu tố ảnh hưởng đến lượng bệnh nhân đến cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="giữa các mùa">
  <data key="d0">giữa các mùa</data>
  <data key="d1">khac</data>
  <data key="d2">Một khoảng thời gian trong năm được nhắc đến như một yếu tố ảnh hưởng đến lượng bệnh nhân đến cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="thời điểm các khoa cấp cứu bị quá tải bệnh nhân">
  <data key="d0">thời điểm các khoa cấp cứu bị quá tải bệnh nhân</data>
  <data key="d1">khac</data>
  <data key="d2">Một tình trạng xảy ra khi số bệnh nhân vượt quá công suất hoạt động của khoa cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="khoa cấp cứu bị quá tải lên đến 140% công suất">
  <data key="d0">khoa cấp cứu bị quá tải lên đến 140% công suất</data>
  <data key="d1">khac</data>
  <data key="d2">Một tình trạng cực đoan khi công suất hoạt động của khoa cấp cứu vượt quá 140%.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="nguy cơ bỏ sót bệnh nhân">
  <data key="d0">nguy cơ bỏ sót bệnh nhân</data>
  <data key="d1">khac</data>
  <data key="d2">Một rủi ro xảy ra khi khoa cấp cứu bị quá tải, dẫn đến bệnh nhân không được cấp cứu kịp thời.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="tính ưu tiên cấp cứu">
  <data key="d0">tính ưu tiên cấp cứu</data>
  <data key="d1">khac</data>
  <data key="d2">Một nguyên tắc được áp dụng để phân loại bệnh nhân và can thiệp theo mức độ cấp thiết.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-002</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792917938</data>
  <data key="d6"></data>
</node>
<node id="quy trình phân loại bệnh nhân">
  <data key="d0">quy trình phân loại bệnh nhân</data>
