  <data key="d0">tăng tuần hoàn tĩnh mạch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một cơ chế cải thiện tuần hoàn máu trong bệnh nhân chấn thương sọ não.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="giảm phù não">
  <data key="d0">giảm phù não</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Một hiệu quả của tư thế nằm nghiêng đầu cao trong chấn thương sọ não.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
