  <data key="d1">trieu_chung</data>
  <data key="d2">Dấu hiệu cho thấy chức năng vận động không bị ảnh hưởng nhiều trong hội chứng sừng sau.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="hội chứng chóp tủy">
  <data key="d0">hội chứng chóp tủy</data>
  <data key="d1">benh</data>
  <data key="d2">Là hội chứng tổn thương tủy sống vùng cùng cụt, dẫn đến bí đái do mất phản xạ bàng quang.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-003</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
