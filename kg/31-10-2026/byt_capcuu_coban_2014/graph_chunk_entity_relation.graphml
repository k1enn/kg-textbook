<node id="suy hô hấp cấp">
  <data key="d0">suy hô hấp cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng tiến triển trong những ngày đầu sau bỏng rộng, bỏng hóa chất hoặc bỏng đường hô hấp.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793020888</data>
  <data key="d6"></data>
</node>
<node id="gardenal">
  <data key="d0">gardenal</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc được sử dụng trong điều trị ngộ độc hóa chất, dùng với liều cao và kéo dài thời gian.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="glucose 10%">
  <data key="d0">glucose 10%</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại glucose được truyền duy trì để nuôi dưỡng bệnh nhân trong tình trạng hôn mê.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="naloxol">
  <data key="d0">naloxol</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc được dùng để loại trừ quá liều heroin trong bệnh nhân hôn mê.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="vitamin b1">
  <data key="d0">vitamin b1</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại vitamin được tiêm bắp hoặc tĩnh mạch để hỗ trợ điều trị hôn mê.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="hỏi bệnh">
  <data key="d0">hỏi bệnh</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một phương pháp thu thập thông tin từ người bệnh hoặc người nhà để xác định nguyên nhân ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="nguyên nhân ngộ độc">
  <data key="d0">nguyên nhân ngộ độc</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là yếu tố gây ra tình trạng ngộ độc, được xác định thông qua việc hỏi bệnh.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="độc chất">
  <data key="d0">độc chất</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là các chất gây ngộ độc được xác định qua việc hỏi bệnh và thu thập vật chứng.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="hội chứng thần kinh giao cảm">
  <data key="d0">hội chứng thần kinh giao cảm</data>
  <data key="d1">benh</data>
  <data key="d2">Là một hội chứng xuất hiện do kích thích hệ thần kinh giao cảm, biểu hiện bằng mạch nhanh, huyết áp tăng, thở nhanh, nhiệt độ tăng, đồng tử dãn, da ướt, niêm mạc khô, kích thích vật vã, hoang tưởng.&lt;SEP&gt;Là hội chứng xuất hiện do kích thích adrenergic, biểu hiện bằng mạch nhanh, huyết áp tăng, thở nhanh, nhiệt độ tăng, đồng tử dãn, da ướt, niêm mạc khô, kích thích vật vã, hoang tưởng.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-003&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-004</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
  <data key="d6"></data>
</node>
<node id="mạch nhanh">
  <data key="d0">mạch nhanh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng được quan sát khi hệ thần kinh giao cảm bị kích thích.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-003</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793021410</data>
