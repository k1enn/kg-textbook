<node id="Bộ phận sinh dục ngoài">
  <data key="d0">Bộ phận sinh dục ngoài</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phần cơ thể bị bỏng với diện tích chiếm 1% theo phương pháp đánh giá của Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Độ 1">
  <data key="d0">Độ 1</data>
  <data key="d1">chi_so</data>
  <data key="d2">Độ sâu của bỏng được xác định là độ 1 khi da chỉ đỏ.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Wallace">
  <data key="d0">Wallace</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Phương pháp đánh giá độ nặng của vùng bỏng theo diện tích cơ thể, với các tỷ lệ cụ thể cho từng phần cơ thể.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="SpO2">
  <data key="d0">SpO2</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số oxy hóa trong máu được sử dụng để đánh giá tình trạng hô hấp của bệnh nhân bị bỏng.&lt;SEP&gt;Là chỉ số đo mức độ oxy hóa trong máu, được sử dụng để theo dõi tình trạng hô hấp của bệnh nhân.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="Đánh giá tình trạng nguy kịch">
  <data key="d0">Đánh giá tình trạng nguy kịch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Quy trình đánh giá nguy kịch của bệnh nhân bị bỏng bao gồm việc đánh giá dấu hiệu ý thức, thần kinh, hô hấp, tuần hoàn.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Đầu 9%">
  <data key="d0">Đầu 9%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phạm vi vùng bỏng trên đầu chiếm 9% tổng diện tích cơ thể theo tiêu chuẩn Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Thân mình: trước 18%; thân minh sau 18%">
  <data key="d0">Thân mình: trước 18%; thân minh sau 18%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phạm vi vùng bỏng trên thân mình được chia thành trước và sau, mỗi phần chiếm 18% tổng diện tích cơ thể theo tiêu chuẩn Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Chi trên 9%; chi dưới 18%">
  <data key="d0">Chi trên 9%; chi dưới 18%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phạm vi vùng bỏng trên chi trên chiếm 9% và chi dưới chiếm 18% tổng diện tích cơ thể theo tiêu chuẩn Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Bộ phận sinh dục ngoài 1%">
  <data key="d0">Bộ phận sinh dục ngoài 1%</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Phạm vi vùng bỏng trên bộ phận sinh dục ngoài chiếm 1% tổng diện tích cơ thể theo tiêu chuẩn Wallace.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Độ 1: đỏ da, đau (như cháy nắng) rát do đầu mút dây thần kinh bị kích thích, loại bỏng này thường lành hẳn sau 3 ngày">
  <data key="d0">Độ 1: đỏ da, đau (như cháy nắng) rát do đầu mút dây thần kinh bị kích thích, loại bỏng này thường lành hẳn sau 3 ngày</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng độ 1 có biểu hiện da đỏ, đau nhẹ, giống như bị cháy nắng, thường lành sau 3 ngày.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Độ 2a (nông) phỏng nước lan rộng khắp bề mặt vết bỏng, đau nhiều, rỉ nước">
  <data key="d0">Độ 2a (nông) phỏng nước lan rộng khắp bề mặt vết bỏng, đau nhiều, rỉ nước</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng độ 2a có hiện tượng tổn thương lan rộng, đau nhiều, có hiện tượng rỉ nước trên bề mặt vết thương.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Độ 2b (sâu): đau ít hơn độ 2a, có vùng tê, tổn thương da dính chặt bề mặt, ấn kính (+). Sẹo hình thành trong 3 tuần, có thể sẹo sâu, hoặc sẹo lồi xấu">
  <data key="d0">Độ 2b (sâu): đau ít hơn độ 2a, có vùng tê, tổn thương da dính chặt bề mặt, ấn kính (+). Sẹo hình thành trong 3 tuần, có thể sẹo sâu, hoặc sẹo lồi xấu</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng độ 2b có mức độ đau nhẹ hơn độ 2a, có vùng tê, da dính chặt, ấn kính dương tính, sẹo hình thành trong 3 tuần và có thể hình thành sẹo sâu hoặc sẹo lồi xấu.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Độ 3: vùng bỏng trắng bóng, đỏ tươi hoặc nâu không đau, vùng tổn thương bám chặt, cần phải ghép da">
  <data key="d0">Độ 3: vùng bỏng trắng bóng, đỏ tươi hoặc nâu không đau, vùng tổn thương bám chặt, cần phải ghép da</data>
  <data key="d1">benh</data>
  <data key="d2">Loại bỏng độ 3 có đặc điểm da trắng bóng, đỏ tươi hoặc nâu, không đau, tổn thương bám chặt và cần phải ghép da để điều trị.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Bỏng hóa chất: tiên lượng phụ thuộc vào việc rửa sớm, bỏng mắt phải được chuyển ngay cho chuyên ngành mắt">
  <data key="d0">Bỏng hóa chất: tiên lượng phụ thuộc vào việc rửa sớm, bỏng mắt phải được chuyển ngay cho chuyên ngành mắt</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Tiên lượng của bỏng hóa chất phụ thuộc vào việc rửa sớm, và bỏng mắt cần được chuyển ngay đến chuyên khoa mắt.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-001</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1792920079</data>
  <data key="d6"></data>
</node>
<node id="Đảm bảo hô hấp: đảm bảo sự thông thoáng đường thở tùy theo tình trạng suy hô hấp có thể phải: thở oxy mũi mask, đặt ống nội khí quản, nếu suy hô hấp nặng hơn hoặc rối loạn ý thức, thông khí nhân tạo…">
  <data key="d0">Đảm bảo hô hấp: đảm bảo sự thông thoáng đường thở tùy theo tình trạng suy hô hấp có thể phải: thở oxy mũi mask, đặt ống nội khí quản, nếu suy hô hấp nặng hơn hoặc rối loạn ý thức, thông khí nhân tạo…</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Các biện pháp hỗ trợ hô hấp bao gồm thở oxy mũi mask, đặt ống nội khí quản hoặc thông khí nhân tạo tùy theo mức độ suy hô hấp và rối loạn ý thức.</data>
