  <data key="d2">Là xét nghiệm khẳng định chẩn đoán và đánh giá mức độ tổn thương phổi trong viêm phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
