  <data key="d1">bien_chung</data>
  <data key="d2">Là biện pháp cuối cùng phải thực hiện sau 36 giờ khi chèn ép không thể xử trí được.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1792919929</data>
  <data key="d6"></data>
