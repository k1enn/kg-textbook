  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân phổ biến gây ra hội chứng chèn ép khoang do chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="bỏng">
  <data key="d0">bỏng</data>
  <data key="d1">khac</data>
  <data key="d2">Là một nguyên nhân gây ra hội chứng chèn ép khoang do chấn thương.&lt;SEP&gt;Thủ thuật xử trí như vết thương chảy máu được áp dụng khi có chảy máu nhiều do bỏng.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-006&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-004</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
