  <data key="d1">khac</data>
  <data key="d2">Loại di dời bệnh nhân trong tình huống cấp cứu cần xử lý nhanh.&lt;SEP&gt;Loại hình di dời thực hiện khi bệnh nhân cần được xử lý cấp cứu nhưng không phải khẩn cấp tuyệt đối.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
