  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật cần thực hiện khi quần áo bị dính hóa chất để tránh tổn thương thêm.</data>
  <data key="d3">14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003</data>
  <data key="d4">14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
