  <data key="d0">sốc giãn mạch</data>
  <data key="d1">benh</data>
  <data key="d2">Loại sốc do giãn mạch hệ thống do các yếu tố trung gian hoạt mạch hoặc độc tố như sốc nhiễm khuẩn, sốc phản vệ.</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-002</data>
