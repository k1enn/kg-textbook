  <data key="d1">khac</data>
  <data key="d2">Là một quá trình được thực hiện nhằm hỗ trợ bệnh nhân trong tình trạng khẩn cấp.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
