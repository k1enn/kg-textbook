  <data key="d1">doi_tuong</data>
  <data key="d2">Mức độ chăm sóc y tế cao hơn được cung cấp cho bệnh nhân khi cần thiết trong quá trình chuyển viện.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
