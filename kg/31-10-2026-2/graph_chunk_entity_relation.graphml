  <data key="d0">cheyne - stockes</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">loạn nhịp thở là một dạng của khó thở</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="hệ thống hô hấp">
  <data key="d0">hệ thống hô hấp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">hệ thống chức năng đáp ứng nhu cầu chuyển hóa của cơ thể</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân chưa có bệnh phổi từ trước">
  <data key="d0">bệnh nhân chưa có bệnh phổi từ trước</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">nhóm bệnh nhân có thể bị suy hô hấp cấp mà không có bệnh phổi trước đó</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân có suy hô hấp mạn tính">
  <data key="d0">bệnh nhân có suy hô hấp mạn tính</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">nhóm bệnh nhân có bệnh suy hô hấp mạn tính có thể phát triển suy hô hấp cấp</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-000</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="ngộ độc khí co">
  <data key="d0">ngộ độc khí co</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ra các triệu chứng lâm sàng như vã mồ hôi, rối loạn tim mạch và rối loạn thần kinh.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="rối loạn tim mạch">
  <data key="d0">rối loạn tim mạch</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Gồm các hiện tượng như mạch nhanh, rối loạn nhịp tim và huyết áp thay đổi, thường đi kèm với suy hô hấp và suy tuần hoàn.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="huyết áp tăng">
  <data key="d0">huyết áp tăng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng trong rối loạn tim mạch, có thể tiến triển thành tụt huyết áp khi nặng.&lt;SEP&gt;Một triệu chứng lâm sàng biểu hiện bằng huyết áp cao, thường thấy trong hội chứng thần kinh giao cảm.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-005</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="suy hô hấp">
  <data key="d0">suy hô hấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng suy giảm chức năng hô hấp, có thể là nguyên nhân hoặc hậu quả của các rối loạn khác.&lt;SEP&gt;Dị vật đường thở là một nguyên nhân gây suy hô hấp thường gặp.&lt;SEP&gt;Suy tim ứ huyết mất bù là nguyên nhân dẫn đến suy hô hấp trong các trường hợp bệnh lý.&lt;SEP&gt;Tình trạng giảm chức năng hô hấp dẫn đến thiếu oxy máu.&lt;SEP&gt;Là tình trạng suy hô hấp xảy ra do tổn thương cơ hoành và thoát vị tạng bụng lên phổi.&lt;SEP&gt;Là một tình trạng bệnh lý do chấn thương hoặc mất máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-005&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-008&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="suy tuần hoàn">
  <data key="d0">suy tuần hoàn</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một biến chứng xảy ra khi có rối loạn tuần hoàn do suy hô hấp nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="rối loạn thần kinh và ý thức">
  <data key="d0">rối loạn thần kinh và ý thức</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng nặng của suy hô hấp, biểu hiện từ lo lắng đến hôn mê và co giật.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="lo lắng">
  <data key="d0">lo lắng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng nhẹ của rối loạn thần kinh và ý thức trong ngộ độc khí CO.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="hốt hoảng">
  <data key="d0">hốt hoảng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng nhẹ của rối loạn thần kinh và ý thức khi bệnh nhân bị ngộ độc khí CO.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="thất điều">
  <data key="d0">thất điều</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng nhẹ của rối loạn thần kinh và ý thức trong ngộ độc khí CO.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="vật vã hoặc ngủ gà">
  <data key="d0">vật vã hoặc ngủ gà</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng trung bình của rối loạn thần kinh và ý thức khi bệnh nhân bị ngộ độc khí CO.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="lờ đờ">
  <data key="d0">lờ đờ</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng nặng của rối loạn thần kinh và ý thức khi bệnh nhân bị suy hô hấp nặng.&lt;SEP&gt;Là một triệu chứng lâm sàng thể hiện sự suy giảm chức năng thần kinh do chấn thương hoặc sốc.&lt;SEP&gt;Là một triệu chứng lâm sàng cho thấy nạn nhân có sự suy giảm ý thức và phản xạ.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="hôn mê">
  <data key="d0">hôn mê</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng nặng của rối loạn thần kinh và ý thức khi bệnh nhân bị suy hô hấp nặng.&lt;SEP&gt;Là trạng thái mất ý thức nghiêm trọng do sốc, say rượu hoặc chấn thương sọ não.&lt;SEP&gt;là trạng thái thần kinh nghiêm trọng cần điều trị bằng thuốc và dinh dưỡng&lt;SEP&gt;Một trạng thái lâm sàng nghiêm trọng biểu hiện bằng mất ý thức hoàn toàn, thường thấy trong hội chứng thần kinh phó giao cảm.&lt;SEP&gt;Là một trạng thái mất ý thức hoàn toàn, không phản xạ với kích thích bên ngoài.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-005&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="co giật">
  <data key="d0">co giật</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng nặng của rối loạn thần kinh và ý thức khi bệnh nhân bị ngộ độc khí CO.&lt;SEP&gt;Là một hiện tượng lâm sàng xảy ra sau chấn thương sọ não, đi kèm với các dấu hiệu khác như co cứng mất vỏ và duỗi cứng mất não.&lt;SEP&gt;Là hiện tượng co rút bất thường của cơ do tổn thương thần kinh.&lt;SEP&gt;Là biến chứng có thể xảy ra sau chấn thương sọ não do tổn thương não hoặc hệ thần kinh.&lt;SEP&gt;là hiện tượng thần kinh xảy ra khi cần dùng thuốc để cắt cơn&lt;SEP&gt;Là biến chứng gây ra co giật toàn thân, các cơn ngày càng mau và mạnh do ngộ độc nhiều loại thuốc hoặc chất độc như thuốc diệt chuột, mã tiền, INH, phenothiazines, theophylline, thuốc chống trầm cảm vòng, phencyclidine, strychnine.&lt;SEP&gt;Là một hiện tượng cơ thể co rút bất thường, thường xảy ra khi có rối loạn thần kinh do ngộ độc.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-003&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-004&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-005&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-006&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="mạch">
  <data key="d0">mạch</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số mạch máu, được dùng để đánh giá mức độ suy hô hấp, với giá trị từ 100-120 đến hơn 140.&lt;SEP&gt;Là chỉ số được theo dõi để đánh giá tình trạng tuần hoàn của bệnh nhân bị bỏng.&lt;SEP&gt;Là chỉ số sinh học được theo dõi để đánh giá tình trạng tuần hoàn của bệnh nhân.&lt;SEP&gt;Một chỉ số dùng để đánh giá nhịp tim trong tình trạng loạn nhịp.&lt;SEP&gt;Chỉ số đo nhịp tim và huyết áp, được theo dõi để đánh giá tình trạng sinh lý của bệnh nhân.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-002&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-003&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nhịp thở">
  <data key="d0">nhịp thở</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số nhịp thở, được dùng để đánh giá mức độ suy hô hấp, với giá trị từ 25-30 đến hơn 40 hoặc dưới 10.&lt;SEP&gt;Số lần hít thở mỗi phút trong tình trạng sốc, phản ánh tình trạng hô hấp.&lt;SEP&gt;Chỉ số đo tốc độ thở của bệnh nhân, được theo dõi để phát hiện bất thường trong hô hấp.&lt;SEP&gt;Chỉ số đo lường tần số thở của bệnh nhân</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-001&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-008</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nói">
  <data key="d0">nói</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số về khả năng nói, với câu dài ở mức trung bình và câu ngắn ở mức nặng.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="huyết áp">
  <data key="d0">huyết áp</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số huyết áp, có thể bình thường, tăng hoặc giảm tùy mức độ suy hô hấp.&lt;SEP&gt;Giá trị áp lực máu trong mạch máu, được dùng để đánh giá mức độ sốc.&lt;SEP&gt;Là chỉ số được theo dõi trong chấn thương hở và chấn thương kín, với ngưỡng cụ thể.&lt;SEP&gt;là chỉ số được nâng bằng thuốc vận mạch để đạt mục tiêu điều trị&lt;SEP&gt;Một chỉ số dùng để đo áp lực máu trong mạch máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="ha bình thường">
  <data key="d0">ha bình thường</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị bình thường của huyết áp trong cơ thể người bệnh</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="ha tăng">
  <data key="d0">ha tăng</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là tình trạng huyết áp tăng cao so với giá trị bình thường</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="ha giảm">
  <data key="d0">ha giảm</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là tình trạng huyết áp giảm thấp so với giá trị bình thường</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="pH 7,35">
  <data key="d0">pH 7,35</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị pH bình thường trong máu, phản ánh trạng thái cân bằng acid-base</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="pH 7,45">
  <data key="d0">pH 7,45</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị pH cao nhất trong máu, phản ánh trạng thái cân bằng acid-base bình thường</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="pH 7,25">
  <data key="d0">pH 7,25</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị pH thấp, phản ánh tình trạng acidosis máu</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paO2 &gt; 60">
  <data key="d0">paO2 &gt; 60</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số oxy máu trong phổi đạt mức trên 60 mmHg, phản ánh khả năng trao đổi khí tốt</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paO2 55 - 60">
  <data key="d0">paO2 55 - 60</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số oxy máu trong phổi ở mức trung bình, phản ánh tình trạng trao đổi khí vừa phải</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paO2 &lt; 55">
  <data key="d0">paO2 &lt; 55</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số oxy máu trong phổi giảm dưới 55 mmHg, phản ánh tình trạng thiếu oxy nghiêm trọng</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paCO2 45 - 55">
  <data key="d0">paCO2 45 - 55</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị bình thường của CO2 trong máu, phản ánh chức năng hô hấp bình thường</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paCO2 55 - 60">
  <data key="d0">paCO2 55 - 60</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị CO2 trong máu cao hơn bình thường, phản ánh tình trạng hô hấp kém</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="paCO2 &gt; 60">
  <data key="d0">paCO2 &gt; 60</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là giá trị CO2 trong máu cao, phản ánh tình trạng hô hấp không hiệu quả</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="hen phế quản">
  <data key="d0">hen phế quản</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một nguyên nhân gây ra các triệu chứng hô hấp bất thường trong bệnh nhân&lt;SEP&gt;Một bệnh lý có thể không thể hiện triệu chứng rõ trên X quang phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793453504</data>
  <data key="d6"></data>
</node>
<node id="copd">
  <data key="d0">copd</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là một bệnh nền làm tăng nguy cơ mắc các bệnh lý hô hấp&lt;SEP&gt;Là một bệnh lý mãn tính về phổi, đặc trưng bởi tăng tiết đờm và co thắt phế quản, dẫn đến suy hô hấp hỗn hợp.&lt;SEP&gt;Yếu tố nguy cơ gây suy hô hấp, thường gặp ở bệnh nhân có tổn thương phổi mao mạch&lt;SEP&gt;Bệnh lý phổi do co thắt phế quản gây suy hô hấp</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-006&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-007</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
