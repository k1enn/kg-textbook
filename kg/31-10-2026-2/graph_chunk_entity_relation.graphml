  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng cho thấy tình trạng ý thức của bệnh nhân được cải thiện sau khi loại trừ dị vật.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
