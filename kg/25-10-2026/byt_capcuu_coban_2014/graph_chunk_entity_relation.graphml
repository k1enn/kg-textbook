  <data key="d0">Thở oxy 2 – 4 lít/phút</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật hỗ trợ hô hấp bằng cách cung cấp oxy qua ống thở.&lt;SEP&gt;Là thủ thuật hỗ trợ hô hấp trong điều trị cấp cứu nhồi máu cơ tim.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
