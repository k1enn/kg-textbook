  <data key="d0">ép ngực</data>
  <data key="d1">khac</data>
  <data key="d2">Lật trẻ nằm ngửa để thực hiện động tác ép ngực sau khi vỗ lưng không hiệu quả.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-004</data>
  <data key="d4">02-cac-ky-thuat-kiem-soat-duong-tho.md</data>
