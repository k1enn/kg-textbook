</node>
<node id="bệnh nhân dưới 75 tuổi">
  <data key="d0">bệnh nhân dưới 75 tuổi</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh được dùng liều heparin 30 mg tiêm tĩnh mạch và 1 mg/kg mỗi 12 giờ.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="bệnh nhân 75 tuổi trở lên">
  <data key="d0">bệnh nhân 75 tuổi trở lên</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh được dùng liều heparin 0,75 mg/kg mỗi 12 giờ dưới da.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="tenecteplase">
  <data key="d0">tenecteplase</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc tiêm tĩnh mạch 1 liều tùy theo cân nặng bệnh nhân với các liều lượng cụ thể theo khối lượng.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="alteplase">
  <data key="d0">alteplase</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc truyền tĩnh mạch với liều bolus 15 mg và tiếp theo là liều truyền kéo dài trong 30 và 60 phút với tổng liều không quá 100 mg.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="streptokinase">
  <data key="d0">streptokinase</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc truyền tĩnh mạch 1.5 triệu đơn vị trong khoảng 30 – 60 phút.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="can thiệp mạch vành">
  <data key="d0">can thiệp mạch vành</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là can thiệp được ưu tiên áp dụng hơn điều trị tiêu sợi huyết trong một số trường hợp như suy tim ứ huyết nặng, có sốc tim, loạn nhịp thất không ổn định, bệnh nhân đến viện muộn hoặc chẩn đoán NMCT không thật chắc chắn.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="INR &gt; 2">
  <data key="d0">INR &gt; 2</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số được coi là chống chỉ định tương đối khi dùng thuốc tiêu sợi huyết.&lt;SEP&gt;Ngưỡng chỉ số cần đạt để truyền huyết tương tươi động lạnh</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1792919723</data>
  <data key="d6"></data>
</node>
<node id="loạn nhịp thất không ổn định">
  <data key="d0">loạn nhịp thất không ổn định</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng bệnh lý được coi là lý do ưu tiên can thiệp mạch vành hơn điều trị tiêu sợi huyết.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="điều trị tiêu sợi huyết">
  <data key="d0">điều trị tiêu sợi huyết</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một thủ thuật được thực hiện khi điều kiện cho phép để điều trị tình trạng thiếu hụt sợi huyết trong cơ thể.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-004</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="rối loạn nhịp tim, rối loạn dẫn truyền">
  <data key="d0">rối loạn nhịp tim, rối loạn dẫn truyền</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là các rối loạn chức năng điện sinh lý của tim, có thể ảnh hưởng đến khả năng đập tim ổn định và hiệu quả.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-004</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="tình trạng đau ngực">
  <data key="d0">tình trạng đau ngực</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d2">Thuốc này được dùng để điều trị tình trạng đau ngực khi không đáp ứng với nitrat.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="chụp mạch vành">
  <data key="d0">chụp mạch vành</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d2">Xét nghiệm chụp mạch vành được dùng để chẩn đoán và đánh giá trước khi can thiệp mạch vành.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="tái tưới máu bằng thuốc tiêu sợi huyết">
  <data key="d0">tái tưới máu bằng thuốc tiêu sợi huyết</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d2">Phương pháp này được chỉ định khi bệnh nhân đến sớm nhưng không thể can thiệp mạch vành trong vòng 120 phút.</data>
  <data key="d1">UNKNOWN</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1792918739</data>
  <data key="d6"></data>
</node>
<node id="chấn thương sọ não">
  <data key="d0">chấn thương sọ não</data>
  <data key="d1">benh</data>
  <data key="d2">Một trong những chấn thương hay gặp hàng đầu trên thế giới cũng như tại Việt Nam&lt;SEP&gt;Là một tình trạng bệnh lý xảy ra do tổn thương sọ não do chấn thương.&lt;SEP&gt;Nguyên nhân gây ra tình trạng cần điều trị cấp cứu&lt;SEP&gt;Là tình trạng chấn thương xảy ra ở vùng sọ não, cần điều trị kịp thời trong quá trình vận chuyển.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000&lt;SEP&gt;08-cap-cuu-chan-thuong-so-nao-chunk-001&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-006&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1792920595</data>
  <data key="d6"></data>
</node>
<node id="điểm GLASGOW">
  <data key="d0">điểm GLASGOW</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Bảng điểm được dùng để đánh giá mức độ tổn thương thần kinh ở bệnh nhân chấn thương sọ não</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md</data>
  <data key="d5">1792918962</data>
  <data key="d6"></data>
</node>
<node id="tai nạn giao thông">
  <data key="d0">tai nạn giao thông</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nguyên nhân phổ biến gây ra chấn thương sọ não tại Việt Nam&lt;SEP&gt;Nguyên nhân thường gặp chiếm 48% dẫn đến chấn thương cột sống&lt;SEP&gt;Nguyên nhân gây chấn thương bụng.&lt;SEP&gt;Là nguyên nhân dẫn đến chấn thương nặng và tử vong</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-000&lt;SEP&gt;11-cap-cuu-chan-thuong-bung-chunk-000&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-000</data>
  <data key="d4">08-cap-cuu-chan-thuong-so-nao.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;11-cap-cuu-chan-thuong-bung.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1792919723</data>
  <data key="d6"></data>
</node>
<node id="cấp cứu trước bệnh viện">
  <data key="d0">cấp cứu trước bệnh viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một mắt xích trong dây truyền cấp cứu cho bệnh nhân chấn thương sọ não</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-000</data>
