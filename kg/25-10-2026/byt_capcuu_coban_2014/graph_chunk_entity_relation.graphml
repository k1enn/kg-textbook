  <data key="d0">di dời khẩn cấp</data>
  <data key="d1">khac</data>
  <data key="d2">Loại di dời bệnh nhân khi có tình huống khẩn cấp xảy ra.&lt;SEP&gt;Loại hình di dời được thực hiện khi tình huống nguy hiểm xảy ra và cần xử lý ngay lập tức.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
