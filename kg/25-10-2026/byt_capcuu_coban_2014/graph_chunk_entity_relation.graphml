  <data key="d1">khac</data>
  <data key="d2">Yêu cầu về việc điều chỉnh tư thế đứng để đảm bảo an toàn khi thực hiện các thao tác di dời.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-003</data>
