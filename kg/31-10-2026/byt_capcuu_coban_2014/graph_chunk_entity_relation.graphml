  <data key="d1">nguyen_nhan</data>
  <data key="d2">Nguyên nhân gây chấn thương ngực hở do vật thể xuyên thấu vào lồng ngực.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-000</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793019575</data>
