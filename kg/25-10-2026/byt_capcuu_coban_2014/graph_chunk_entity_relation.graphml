  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1792918293</data>
  <data key="d6"></data>
</node>
<node id="thăm khám thần kinh">
  <data key="d0">thăm khám thần kinh</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d2">Là triệu chứng được phát hiện trong thăm khám thần kinh</data>
