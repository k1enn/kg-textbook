<node id="phổi">
  <data key="d0">phổi</data>
  <data key="d1">khac</data>
  <data key="d2">Áp lực động mạch phổi được theo dõi để đánh giá chức năng phổi của bệnh nhân trong quá trình vận chuyển.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-006</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
