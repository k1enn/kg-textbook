  <data key="d7">1.0</data>
  <data key="d8">Sốc điện là một nguyên nhân gây ra tình trạng ngừng tuần hoàn trong cấp cứu.</data>
  <data key="d9">nguyen_nhan_cua,nguyên nhân</data>
