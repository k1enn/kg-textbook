  <data key="d1">khac</data>
  <data key="d2">Tư thế nằm ngửa, chân cao bị chống chỉ định khi có gẫy chân.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="nằm ngửa, đầu cao 10-30 độ">
  <data key="d0">nằm ngửa, đầu cao 10-30 độ</data>
  <data key="d1">khac</data>
  <data key="d2">Tư thế nằm ngửa đầu cao 10-30 độ được áp dụng để điều trị chấn thương sọ não.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
