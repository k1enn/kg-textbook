  <data key="d0">huyết áp hai tay khác nhau</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng huyết áp hai tay khác nhau trong bệnh nhân dập vỡ động mạch chủ.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-007</data>
  <data key="d4">10-cap-cuu-chan-thuong-nguc.md</data>
