  <data key="d0">sốc điện không đồng bộ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là hình thức sốc điện không đồng bộ được sử dụng trong điều trị.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-003</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1793453934</data>
  <data key="d6"></data>
</node>
<node id="nhân viên cấp cứu">
  <data key="d0">nhân viên cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người được tập luyện để thực hiện các thao tác cấp cứu trong tình trạng ngừng tuần hoàn.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-003</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md</data>
  <data key="d5">1793453934</data>
  <data key="d6"></data>
</node>
<node id="xe cấp cứu">
  <data key="d0">xe cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là phương tiện được trang bị để hỗ trợ cấp cứu trong tình trạng ngừng tuần hoàn.&lt;SEP&gt;Là phương tiện cấp cứu được trang bị thiết bị và thuốc cần thiết cho xử trí NTH.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-003&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-003</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1793454119</data>
  <data key="d6"></data>
</node>
<node id="cơ sở cấp cứu">
  <data key="d0">cơ sở cấp cứu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là cơ sở được chuẩn bị để thực hiện cấp cứu trong tình trạng ngừng tuần hoàn.&lt;SEP&gt;Là cơ sở y tế có đầy đủ thiết bị và thuốc để xử trí tình trạng NTH.</data>
  <data key="d3">05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-003&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-003</data>
  <data key="d4">05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;06-cap-cuu-ngung-tuan-hoan-nang-cao.md</data>
  <data key="d5">1793454119</data>
