  <data key="d0">dấu hiệu</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là các biểu hiện lâm sàng có thể quan sát được ở bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-008</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
