  <data key="d2">Là một phương pháp thăm khám nhằm đánh giá ý thức và các triệu chứng liệt cơ hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="xq phổi">
  <data key="d0">xq phổi</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một xét nghiệm chẩn đoán hình ảnh có ý nghĩa trong việc định hướng chẩn đoán bệnh lý hô hấp.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="khí máu động mạch">
  <data key="d0">khí máu động mạch</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một xét nghiệm cần thiết để chẩn đoán và phân loại suy hô hấp.&lt;SEP&gt;Là xét nghiệm dùng để đánh giá tình trạng oxy hóa máu và CO2 trong máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="tràn khí màng phổi">
  <data key="d0">tràn khí màng phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là một bệnh lý gây khó thở đột ngột, có thể xuất hiện sau gắng sức hoặc tự phát, kèm theo các dấu hiệu lâm sàng như lồng ngực căng và giảm RRFN.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-002</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="hô hấp hỗn hợp">
  <data key="d0">hô hấp hỗn hợp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng có giảm oxy máu và tăng CO2 trong máu.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="viêm phổi">
  <data key="d0">viêm phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là bệnh lý gây suy hô hấp do giảm oxy máu, có triệu chứng sốt, ho khạc đờm đục, khó thở và đau ngực.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="hội chứng suy hô hấp tiến triển">
  <data key="d0">hội chứng suy hô hấp tiến triển</data>
  <data key="d1">benh</data>
  <data key="d2">Là biểu hiện của đáp ứng viêm hệ thống do tổn thương phổi hoặc nguyên nhân ngoài phổi, gây suy hô hấp nặng với tăng shunt và P/F &lt; 200.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="suy tim ứ huyết mất bù">
  <data key="d0">suy tim ứ huyết mất bù</data>
  <data key="d1">benh</data>
  <data key="d2">Là dạng suy hô hấp chủ yếu do giảm oxy máu, có thể gặp thể tăng CO2 ở bệnh nhân có bệnh phổi mạn tính.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="x quang phổi">
  <data key="d0">x quang phổi</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm hình ảnh dùng để khẳng định chẩn đoán và đánh giá mức độ tổn thương phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="bạch cầu tăng">
  <data key="d0">bạch cầu tăng</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là dấu hiệu tăng trong xét nghiệm máu khi có viêm phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="crp tăng">
  <data key="d0">crp tăng</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là dấu hiệu tăng trong xét nghiệm máu khi có viêm phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="procalcitinin">
  <data key="d0">procalcitinin</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là chỉ số tăng trong xét nghiệm máu khi có viêm phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="máu lắng tăng">
  <data key="d0">máu lắng tăng</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là dấu hiệu tăng trong xét nghiệm máu khi có viêm phổi.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="nội khí quản">
  <data key="d0">nội khí quản</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật khai thông đường thở bằng cách đặt ống nội khí quản hoặc mở khí quản.&lt;SEP&gt;Là biện pháp hữu hiệu khai thông đường thở khi tắc nghẽn.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="tắc nghẽn đường hô hấp trên">
  <data key="d0">tắc nghẽn đường hô hấp trên</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến cần đặt nội khí quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
<node id="mất phản xạ bảo vệ đường thở">
  <data key="d0">mất phản xạ bảo vệ đường thở</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến cần đặt nội khí quản.</data>
  <data key="d3">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-004&lt;SEP&gt;03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap-chunk-003</data>
  <data key="d4">03-chan-doan-va-xu-tri-cap-cuu-ban-dau-suy-ho-hap-cap.md</data>
  <data key="d5">1793016196</data>
  <data key="d6"></data>
</node>
