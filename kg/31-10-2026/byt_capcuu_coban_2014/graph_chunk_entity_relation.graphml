  <data key="d1">thu_thuat</data>
  <data key="d2">Là biện pháp được thực hiện để đảm bảo cột sống cổ không bị di chuyển trong suốt quá trình đánh giá.</data>
  <data key="d3">10-cap-cuu-chan-thuong-nguc-chunk-001</data>
