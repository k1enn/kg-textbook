  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật giữ chi ở mức ngang tim để giảm áp lực lên khoang bị chèn ép.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-004&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
