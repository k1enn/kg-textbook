</node>
<node id="suy thận thể thiểu niệu hoặc vô niệu">
  <data key="d0">suy thận thể thiểu niệu hoặc vô niệu</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Một yếu tố nguy cơ chống chỉ định khi sử dụng lợi tiểu tích cực.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="dịch đẳng trương">
  <data key="d0">dịch đẳng trương</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại dịch truyền được sử dụng trong lợi tiểu tích cực, gồm glucose 5%, natri clorua 0,9% và natribicarrbonat 1,4% theo tỷ lệ 2:2:1.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="furosemide">
  <data key="d0">furosemide</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một loại thuốc lợi tiểu mạnh được dùng khi lượng nước tiểu không đạt mức yêu cầu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="paraquat">
  <data key="d0">paraquat</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Một loại độc chất gây ngộ độc, thường được xử lý bằng thay máu khi nhập viện trong vòng 2-4 giờ đầu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="Trung tâm Chống Độc">
  <data key="d0">Trung tâm Chống Độc</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Một cơ sở y tế nơi áp dụng và nghiên cứu các biện pháp lọc máu hấp phụ và thay máu cho bệnh nhân ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="thuốc giải độc">
  <data key="d0">thuốc giải độc</data>
  <data key="d1">thuoc</data>
  <data key="d2">Các chất có tác dụng đặc hiệu để chống lại độc chất trong cơ thể, được dùng sớm và đúng cách để đạt hiệu quả cao trong điều trị ngộ độc cấp.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="antidote">
  <data key="d0">antidote</data>
  <data key="d1">thuoc</data>
  <data key="d2">Một thuật ngữ chỉ các chất có tác dụng đặc hiệu để chống lại độc chất trong cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="Thuốc giải độc">
  <data key="d0">Thuốc giải độc</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là các chất có tác dụng đặc hiệu chống lại tác động hoặc hiệu quả độc hại của một độc chất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="ngộ độc cấp">
  <data key="d0">ngộ độc cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng xảy ra do tiếp xúc với độc chất trong thời gian ngắn, có thể gây hại nghiêm trọng nếu không được xử lý kịp thời.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-007</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="PAM">
  <data key="d0">PAM</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong điều trị ngộ độc phospho hữu cơ.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1792920333</data>
  <data key="d6"></data>
</node>
<node id="N Acetylcystein">
  <data key="d0">N Acetylcystein</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong điều trị ngộ độc paracetamol.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
