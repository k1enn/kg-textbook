  <data key="d0">khoa điều trị tích</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là các khoa điều trị tích cực được sử dụng để tiếp nhận bệnh nhân sau khi được vận chuyển</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="thảo luận trước khi chuyển">
  <data key="d0">thảo luận trước khi chuyển</data>
  <data key="d1">khac</data>
  <data key="d2">Là quá trình thảo luận giữa các bác sĩ, y tá để xác định tình trạng bệnh nhân và điều trị liên tục</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-005</data>
  <data key="d4">16-van-chuyen-benh-nhan-cap-cuu.md</data>
