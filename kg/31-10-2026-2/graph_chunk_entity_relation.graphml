</node>
<node id="cơn đau thắt ngực">
  <data key="d0">cơn đau thắt ngực</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng lâm sàng điển hình của nhồi máu cơ tim cấp, bao gồm đau sau xương ức, lan lên vai và ra tay trái.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="tái tưới máu">
  <data key="d0">tái tưới máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật điều trị nhồi máu cơ tim cấp bằng can thiệp hoặc thuốc, được thực hiện sớm để giảm tỷ lệ tử vong.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="suy tim">
  <data key="d0">suy tim</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Biến chứng nặng có thể xảy ra sau nhồi máu cơ tim cấp, đe dọa tính mạng bệnh nhân.&lt;SEP&gt;Là một biến chứng cấp tính xảy ra trong bệnh NMCT, được đánh giá bằng thang Killip.&lt;SEP&gt;một yếu tố tham gia thúc đẩy quá trình sốc chấn thương&lt;SEP&gt;Là tình trạng bệnh nền chống chỉ định khi sử dụng lợi tiểu tích cực.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-000&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="rối loạn nhịp tim">
  <data key="d0">rối loạn nhịp tim</data>
  <data key="d1">benh</data>
  <data key="d2">Biến chứng nặng có thể xảy ra sau nhồi máu cơ tim cấp, đe dọa tính mạng bệnh nhân.&lt;SEP&gt;Là một biến chứng xảy ra trong bệnh NMCT, liên quan đến rối loạn hoạt động của tim.&lt;SEP&gt;Là một biến chứng liên quan đến rối loạn hoạt động nhịp tim và dẫn truyền.&lt;SEP&gt;Là tình trạng bệnh lý xuất hiện do ngộ độc thuốc và chất độc, bao gồm nhịp chậm xoang, block nhĩ thất, nhịp nhanh xoang.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-005&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-006</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="rối loạn dẫn truyền">
  <data key="d0">rối loạn dẫn truyền</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Biến chứng nặng có thể xảy ra sau nhồi máu cơ tim cấp, đe dọa tính mạng bệnh nhân.&lt;SEP&gt;Là một biến chứng xảy ra trong bệnh NMCT, liên quan đến sự mất chức năng dẫn truyền trong tim.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="đau thắt ngực không ổn định">
  <data key="d0">đau thắt ngực không ổn định</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Trường hợp đau ngực không kéo dài và không hết khi ngậm nitroglycerin, có thể là cơn đau thắt ngực không ổn định hoặc không có ST chênh lên.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="can thiệp">
  <data key="d0">can thiệp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Phương pháp điều trị nhồi máu cơ tim cấp bằng can thiệp hoặc thuốc, được thực hiện để tái tưới máu sớm.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-000</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="đau ngực">
  <data key="d0">đau ngực</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng đặc trưng của thiếu máu cục bộ cơ tim, có thể kéo dài hơn 20 phút và không giảm khi ngậm nitroglycerin.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="nmct">
  <data key="d0">nmct</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng do thiếu máu cục bộ cơ tim, chẩn đoán dựa vào triệu chứng lâm sàng và các dấu hiệu điện tim, sinh học.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="st chenh len">
  <data key="d0">st chenh len</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số điện tim thể hiện sự thay đổi của sóng ST, xảy ra ở hai chuyển đạo liên tiếp hoặc ở V2, V3 với mức độ khác nhau tùy theo độ tuổi và giới tính.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="sóng q bệnh lý">
  <data key="d0">sóng q bệnh lý</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là hiện tượng xuất hiện trên điện tim, dùng để hỗ trợ chẩn đoán nhồi máu cơ tim.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="siu_am tim">
  <data key="d0">siu_am tim</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là xét nghiệm siêu âm tim, phát hiện bất thường vận động vùng cơ tim mới xuất hiện.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="troponin">
  <data key="d0">troponin</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là dấu ấn sinh học tăng lên khi có hoại tử cơ tim, dùng để hỗ trợ chẩn đoán nhồi máu cơ tim.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-001</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="chủ, tắc động mạch phổi">
  <data key="d0">chủ, tắc động mạch phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý liên quan đến tắc nghẽn động mạch phổi, cần được chẩn đoán bằng chụp CT.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="biến chứng cơ học">
  <data key="d0">biến chứng cơ học</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Là một biến chứng xảy ra trong bệnh NMCT, liên quan đến các tổn thương cơ học của tim.&lt;SEP&gt;Là một biến chứng cơ học xảy ra trong quá trình điều trị tiêu sợi huyết.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002&lt;SEP&gt;07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-005</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="đái tháo đường">
  <data key="d0">đái tháo đường</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là một bệnh lý kèm theo trong bệnh NMCT cấp, làm tăng nguy cơ diễn tiến nặng.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="aspirin">
  <data key="d0">aspirin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một thuốc ức chế ngưng tập tiểu cầu, dùng trong điều trị cấp cứu cho bệnh nhân NMCT.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="clopidogrel">
  <data key="d0">clopidogrel</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một thuốc ức chế ngưng tập tiểu cầu, dùng trong điều trị cấp cứu cho bệnh nhân NMCT.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="nitroglycerin">
  <data key="d0">nitroglycerin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một thuốc dùng để giảm đau ngực, có thể dùng tĩnh mạch hoặc ngậm dưới lưỡi.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="morphin sulphat">
  <data key="d0">morphin sulphat</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một thuốc giảm đau, dùng khi đau ngực không đáp ứng với nitrat.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="heparin">
  <data key="d0">heparin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một thuốc chống đông, dùng để điều trị trong bệnh NMCT cấp.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="killip">
  <data key="d0">killip</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một thang điểm đánh giá mức độ nặng của suy tim trong bệnh NMCT cấp.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="aptt">
  <data key="d0">aptt</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một chỉ số sinh học dùng để điều chỉnh liều heparin trong điều trị bệnh NMCT cấp.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="ct">
  <data key="d0">ct</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là một xét nghiệm chẩn đoán hình ảnh dùng để phát hiện tắc động mạch phổi.&lt;SEP&gt;Xét nghiệm hình ảnh được sử dụng để chẩn đoán tổn thương cột sống cổ.&lt;SEP&gt;Là xét nghiệm hình ảnh bằng CT để phát hiện tổn thương nội tạng.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-002&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song-chunk-007&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc-chunk-002</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md&lt;SEP&gt;09-cap-cuu-chan-thuong-cot-song.md&lt;SEP&gt;10-cap-cuu-chan-thuong-nguc.md</data>
  <data key="d5">1793456794</data>
  <data key="d6"></data>
</node>
<node id="4000 đơn vị">
  <data key="d0">4000 đơn vị</data>
  <data key="d1">khac</data>
  <data key="d2">Một đơn vị lượng thuốc được sử dụng trong điều trị, với liều tối đa là 1000 đơn vị/giờ.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="12 đơn vị/kg/giờ">
  <data key="d0">12 đơn vị/kg/giờ</data>
  <data key="d1">khac</data>
  <data key="d2">Liều lượng thuốc được điều chỉnh theo khối lượng cơ thể bệnh nhân.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
</node>
<node id="aptt bệnh/chứng = 1,5 – 2,0">
  <data key="d0">aptt bệnh/chứng = 1,5 – 2,0</data>
  <data key="d1">chi_so</data>
  <data key="d2">Giá trị ngưỡng của chỉ số aPTT để duy trì trong điều trị.</data>
  <data key="d3">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh-chunk-003</data>
  <data key="d4">07-chan-doan-va-xu-tri-cap-cuu-nhoi-mau-co-tim-cap-co-st-chenh.md</data>
  <data key="d5">1793454370</data>
  <data key="d6"></data>
