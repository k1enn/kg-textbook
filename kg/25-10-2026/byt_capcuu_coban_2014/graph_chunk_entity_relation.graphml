</node>
<node id="salycylates">
  <data key="d0">salycylates</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Loại chất độc có thể được loại bỏ bằng rửa dạ dày trong 8 giờ đầu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-006</data>
