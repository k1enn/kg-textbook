<node id="ký để ra sớm">
  <data key="d0">ký để ra sớm</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một tình trạng khi bệnh nhân ký ra sớm, có thể dẫn đến chẩn đoán sai hoặc bỏ sót.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010</data>
