<node id="đau bụng">
  <data key="d0">đau bụng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là triệu chứng lâm sàng phổ biến gợi ý chấn thương bụng ở bệnh nhân có yếu tố chấn thương.</data>
  <data key="d3">11-cap-cuu-chan-thuong-bung-chunk-000</data>
