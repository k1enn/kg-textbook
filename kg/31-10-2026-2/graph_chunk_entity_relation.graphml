  <data key="d0">cắt lọc nếu bẩn hoặc dập nát nhiều</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật cắt lọc mỏm cụt khi phát hiện nó bị bẩn hoặc dập nát nhiều.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="chườm lạnh đầu mỏm cụt">
  <data key="d0">chườm lạnh đầu mỏm cụt</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật chườm lạnh đầu mỏm cụt để giảm viêm và đau, không để đá tiếp xúc trực tiếp.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="bỏ vào túi nilon sạch dán kín">
  <data key="d0">bỏ vào túi nilon sạch dán kín</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước xử trí bỏ phần chi thể đứt rời vào túi nilon sạch và dán kín để bảo quản.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="chuyển ghép nối chi">
  <data key="d0">chuyển ghép nối chi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật chuyển ghép nối chi, thực hiện trong phòng mổ hoặc chuyển tuyến trên.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
<node id="cầm máu: băng ép, garo">
  <data key="d0">cầm máu: băng ép, garo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật cầm máu bằng băng ép hoặc garo trong vết thương cắt cụt không hoàn toàn.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
<node id="đặt lại tư thế giải phẫu">
  <data key="d0">đặt lại tư thế giải phẫu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước xử trí đặt lại tư thế giải phẫu sau khi xử trí vết thương cắt cụt không hoàn toàn.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458475</data>
  <data key="d6"></data>
</node>
