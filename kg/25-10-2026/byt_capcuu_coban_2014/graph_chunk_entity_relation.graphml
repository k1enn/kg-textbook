  <data key="d1">khac</data>
  <data key="d2">Hành động phối hợp giữa các nhân viên cứu hộ trong quá trình vận chuyển bệnh nhân.&lt;SEP&gt;Tăng hiệu quả và an toàn trong quá trình vận chuyển bệnh nhân bằng sự phối hợp nhóm.</data>
  <data key="d3">16-van-chuyen-benh-nhan-cap-cuu-chunk-001&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-002</data>
