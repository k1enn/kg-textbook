  <data key="d0">răng hàm mặt</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có các vấn đề liên quan đến răng hàm mặt.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="rối loạn/tổn thương nguy hiểm và">
  <data key="d0">rối loạn/tổn thương nguy hiểm và</data>
  <data key="d1">benh</data>
  <data key="d2">Là các tình trạng bệnh lý có nguy cơ cao gây tử vong nếu không được xử trí kịp thời.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="chẩn đoán">
  <data key="d0">chẩn đoán</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là kỹ thuật dùng để xác định nguyên nhân hoặc tình trạng bệnh lý của bệnh nhân.&lt;SEP&gt;Ghi chép của tuyến trước được dùng để hỗ trợ chẩn đoán và đánh giá tình trạng bệnh nhân.&lt;SEP&gt;Là bước đầu tiên được thực hiện khi phát hiện trường hợp nghi ngờ ngừng tuần hoàn.&lt;SEP&gt;Là một quá trình chẩn đoán được thực hiện để xác định nguyên nhân ngộ độc.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007&lt;SEP&gt;01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-010&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban-chunk-001&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-003</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md&lt;SEP&gt;05-cap-cuu-ngung-tuan-hoan-co-ban.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="xử trí">
  <data key="d0">xử trí</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là các hành động can thiệp được thực hiện để ổn định hoặc điều trị bệnh nhân trong tình trạng cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="thông tin">
  <data key="d0">thông tin</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là dữ liệu hoặc dữ kiện được thu thập để hỗ trợ chẩn đoán và xử trí bệnh nhân.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="kiến thức">
  <data key="d0">kiến thức</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nền tảng lý thuyết mà bác sĩ sử dụng để đưa ra quyết định trong điều trị cấp cứu.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
<node id="kỹ năng">
  <data key="d0">kỹ năng</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là khả năng thực hành được phát triển để xử lý các tình huống cấp cứu hiệu quả.</data>
  <data key="d3">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu-chunk-007</data>
  <data key="d4">01-nhan-dinh-va-kiem-soat-ban-dau-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793452662</data>
  <data key="d6"></data>
</node>
