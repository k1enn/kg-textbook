  <data key="d6"></data>
</node>
<node id="nhan_nhu">
  <data key="d0">nhan_nhu</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng ngừng tim phổi do nguyên nhân không rõ ràng, cần được chẩn đoán và xử trí kịp thời.</data>
  <data key="d3">06-cap-cuu-ngung-tuan-hoan-nang-cao-chunk-001</data>
