  <data key="d6"></data>
</node>
<node id="60 ml">
  <data key="d0">60 ml</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một lượng hỗn hợp được dùng cho trẻ em dưới 2 tuổi trong điều trị ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="120 ml">
  <data key="d0">120 ml</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một lượng hỗn hợp được dùng cho người lớn trong điều trị ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="8 giờ">
  <data key="d0">8 giờ</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một khoảng thời gian mà rửa dạ dày vẫn còn hiệu quả với một số loại chất độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="60 phút">
  <data key="d0">60 phút</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một khoảng thời gian mà rửa dạ dày hiệu quả nhất sau khi tiếp xúc chất độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="3 giờ">
  <data key="d0">3 giờ</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là một khoảng thời gian mà rửa dạ dày vẫn còn hiệu quả nếu đã uống than hoạt trước đó.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nghi">
  <data key="d0">nghi</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một tư thế nằm được dùng cho bệnh nhân trong quá trình rửa dạ dày.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="dạ dày">
  <data key="d0">dạ dày</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là bộ phận cơ quan được sử dụng trong quá trình xông và rửa để loại bỏ độc chất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="xông dạ dày">
  <data key="d0">xông dạ dày</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật dùng để đưa nước vào dạ dày qua miệng hoặc mũi nhằm làm sạch dạ dày.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="sorbitol">
  <data key="d0">sorbitol</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thuốc được dùng để kích thích co bóp ruột nhằm đẩy chất độc ra ngoài.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-008</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="lợi tiểu tích cực">
  <data key="d0">lợi tiểu tích cực</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật dùng để tăng đào thải độc chất qua đường tiết niệu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="gardenal">
  <data key="d0">gardenal</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là loại độc chất được đào thải qua đường tiết niệu, gây ngộ độc.&lt;SEP&gt;Loại dịch truyền chứa glucose 5%, natri clorua 0,9% và natribicarrbonat 1,4% theo tỉ lệ 2:2:1.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="ong đốt">
  <data key="d0">ong đốt</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ngộ độc dẫn đến tình trạng tiêu cơ vân.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="rắn hổ mang cắn">
  <data key="d0">rắn hổ mang cắn</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân gây ngộ độc dẫn đến tình trạng tiêu cơ vân.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="suy thận thể thiểu niệu">
  <data key="d0">suy thận thể thiểu niệu</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tình trạng bệnh nền chống chỉ định khi sử dụng lợi tiểu tích cực.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="dịch đẳng trương">
  <data key="d0">dịch đẳng trương</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là loại dịch truyền được sử dụng trong quá trình điều trị ngộ độc.&lt;SEP&gt;Dịch truyền thường là dịch đẳng trương gồm glucose 5% và natri clorua 0,9%.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="glucose 5%">
  <data key="d0">glucose 5%</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là thành phần của dịch đẳng trương được dùng trong điều trị ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="dịch truyền">
  <data key="d0">dịch truyền</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là phương pháp truyền dịch để hỗ trợ điều trị ngộ độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nhuận tràng">
  <data key="d0">nhuận tràng</data>
  <data key="d1">khac</data>
  <data key="d2">Sorbitol được dùng để kích thích co bóp ruột nhằm đẩy chất độc ra ngoài.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="20-100ml/giờ">
  <data key="d0">20-100ml/giờ</data>
  <data key="d1">chi_so</data>
  <data key="d2">Lượng dịch truyền cần thiết cho trẻ em tùy theo cân nặng và tổng số dịch truyền.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="furosemide">
  <data key="d0">furosemide</data>
  <data key="d1">thuoc</data>
  <data key="d2">Thuốc lợi tiểu mạnh được chỉ định khi lượng nước tiểu không đạt yêu cầu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="lọc ngoài thận">
  <data key="d0">lọc ngoài thận</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Phương pháp lọc ngoài thận áp dụng khi lợi tiểu không hiệu quả hoặc bệnh nhân suy thận.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="intermittent hemodialysis">
  <data key="d0">intermittent hemodialysis</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Loại lọc máu được áp dụng phổ biến trong điều trị lọc ngoài thận.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="lọc máu hấp phụ">
  <data key="d0">lọc máu hấp phụ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Phương pháp lọc máu hấp phụ bằng cột lọc than hoạt hoặc resin đang được nghiên cứu tại Trung tâm Chống Độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="thay huyết tương">
  <data key="d0">thay huyết tương</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Phương pháp thay huyết tương hoặc thay máu khi các biện pháp thải trừ khác không hiệu quả.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="ngộ độc paraquat">
  <data key="d0">ngộ độc paraquat</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Ngộ độc paraquat là nguyên nhân dẫn đến chỉ định thay máu khi bệnh nhân nhập viện trong vòng 2-4 giờ đầu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-010</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="thuốc giải độc">
  <data key="d0">thuốc giải độc</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là các chất có tác dụng đặc hiệu chống lại tác động hoặc hiệu quả độc hại của một độc chất.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="pam">
  <data key="d0">pam</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong ngộ độc phospho hữu cơ.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="n acetylcystein">
  <data key="d0">n acetylcystein</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong ngộ độc paracetamol.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="naloxon">
  <data key="d0">naloxon</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong quá liều thuốc phiện.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="d penicilamin">
  <data key="d0">d penicilamin</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại thuốc giải độc được sử dụng trong điều trị ngộ độc chì.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="huyết thanh kháng nọc">
  <data key="d0">huyết thanh kháng nọc</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là một loại huyết thanh kháng nọc được sử dụng trong điều trị ngộ độc từ các loài rắn.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="paracetamol">
  <data key="d0">paracetamol</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một loại độc chất gây ngộ độc được điều trị bằng thuốc giải độc N acetylcystein.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="chì">
  <data key="d0">chì</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một loại độc chất gây ngộ độc được điều trị bằng thuốc giải độc D penicilamin.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="người bệnh">
  <data key="d0">người bệnh</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh có phản ứng khác nhau khi dùng thuốc giải độc.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-011</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="điều trị ngộ độc chì">
  <data key="d0">điều trị ngộ độc chì</data>
  <data key="d1">khac</data>
  <data key="d2">Là phương pháp can thiệp nhằm xử lý các triệu chứng và phục hồi chức năng cơ thể khi mắc bệnh ngộ độc chì.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-012</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="huyết thanh kháng nọc các loại rắn">
  <data key="d0">huyết thanh kháng nọc các loại rắn</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là loại thuốc được sử dụng để chống lại độc tố từ nọc rắn của các loài như hổ chúa, hổ mang, cạp nia, lục tre, choàm quạp.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-012</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="huyết học">
  <data key="d0">huyết học</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một lĩnh vực trong điều trị triệu chứng và hồi sức toàn diện, liên quan đến chức năng của máu.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-012</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="nước điện giải">
  <data key="d0">nước điện giải</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là một yếu tố được điều trị trong quá trình hồi sức toàn diện nhằm phục hồi cân bằng điện giải trong cơ thể.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-012</data>
  <data key="d4">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="hổ chúa">
  <data key="d0">hổ chúa</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là một loại rắn có nọc độc gây ra tình trạng ngộ độc khi bị cắn.</data>
  <data key="d3">15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-012</data>
