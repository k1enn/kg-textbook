  <data key="d2">Là một triệu chứng lâm sàng biểu hiện sự suy yếu thể chất do chấn thương hoặc sốc.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="rối loạn ý thức">
  <data key="d0">rối loạn ý thức</data>
  <data key="d1">benh</data>
  <data key="d2">Là một triệu chứng lâm sàng do suy hô hấp, say rượu hoặc chấn thương sọ não.&lt;SEP&gt;Một tình trạng bệnh lý khi bệnh nhân không có ý thức rõ ràng.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-009</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="khát nước">
  <data key="d0">khát nước</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng do mất nước hoặc suy hô hấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="đái ít">
  <data key="d0">đái ít</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng do mất nước hoặc suy hô hấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="vô niệu">
  <data key="d0">vô niệu</data>
  <data key="d1">yeu_to_nguy_co</data>
  <data key="d2">Là tình trạng không có nước tiểu, với lượng nước tiểu dưới 0,5 ml/kg/h.&lt;SEP&gt;Là tình trạng bệnh nền chống chỉ định khi sử dụng lợi tiểu tích cực.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap-chunk-009</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;15-nguyen-tac-chan-doan-xu-tri-ngo-doc-cap.md</data>
  <data key="d5">1793459941</data>
  <data key="d6"></data>
</node>
<node id="hạ thân nhiệt">
  <data key="d0">hạ thân nhiệt</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng do suy hô hấp hoặc chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="gãy xương">
  <data key="d0">gãy xương</data>
  <data key="d1">benh</data>
  <data key="d2">Là biến chứng xảy ra do chấn thương, dẫn đến tổn thương xương và mô xung quanh.&lt;SEP&gt;Là một biểu hiện lâm sàng do chấn thương cơ xương.&lt;SEP&gt;Trật khớp cần được phân biệt với gãy xương trong đánh giá chấn thương.&lt;SEP&gt;Tình trạng gãy xương ở một khớp trên và một khớp dưới.&lt;SEP&gt;Là tình trạng tổn thương xương do va chạm hoặc chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-002&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="tắc mạch mỡ hoặc mạch hơi">
  <data key="d0">tắc mạch mỡ hoặc mạch hơi</data>
  <data key="d1">benh</data>
  <data key="d2">Là nguyên nhân gây ra cơ tim cấp do tắc nghẽn mạch máu cung cấp cho cơ tim.&lt;SEP&gt;Là một tình trạng bệnh lý do chấn thương, cần phân biệt với các bệnh khác.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="bicarbonate và lactat máu">
  <data key="d0">bicarbonate và lactat máu</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các chỉ số xét nghiệm dùng để đánh giá tình trạng mất máu hoặc suy hô hấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="xquang hoặc cắt lớp vi tính">
  <data key="d0">xquang hoặc cắt lớp vi tính</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các phương pháp cận lâm sàng để đánh giá tình trạng chấn thương ngực, bụng, khung chậu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="sốc thần kinh">
  <data key="d0">sốc thần kinh</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý do chấn thương tủy cổ cao, với tụt huyết áp nhẹ.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="tiếng tim mờ">
  <data key="d0">tiếng tim mờ</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng do suy hô hấp hoặc chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="tràn khí mạng phổi">
  <data key="d0">tràn khí mạng phổi</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý do chấn thương, có biểu hiện suy hô hấp và khí quản bị đẩy lệch.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="khí quản bị đẩy lệch">
  <data key="d0">khí quản bị đẩy lệch</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một triệu chứng lâm sàng do tràn khí màng phổi áp lực.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="giảm tiền gánh">
  <data key="d0">giảm tiền gánh</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là một hiện tượng do chèn ép vào tĩnh mạch chủ dưới, dẫn đến tụt huyết áp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="cấp cứu ngoại viện">
  <data key="d0">cấp cứu ngoại viện</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là tình huống xử lý khẩn cấp tại hiện trường trước khi đưa bệnh nhân đến bệnh viện.&lt;SEP&gt;Là nhóm người bệnh được xử lý ngay tại hiện trường trước khi vận chuyển đến bệnh viện.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-003&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="cơ tim cấp">
  <data key="d0">cơ tim cấp</data>
  <data key="d1">benh</data>
  <data key="d2">Là một tình trạng bệnh lý xảy ra đột ngột do tắc mạch máu cung cấp cho cơ tim.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="phân loại">
  <data key="d0">phân loại</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật đánh giá mức độ nghiêm trọng của chấn thương để xác định điều trị ưu tiên.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="nẹp cố định cột sống cổ">
  <data key="d0">nẹp cố định cột sống cổ</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật cố định cột sống để tránh tổn thương thần kinh trong chấn thương đầu cổ.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="tối ưu hóa oxy máu">
  <data key="d0">tối ưu hóa oxy máu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật cải thiện lượng oxy được vận chuyển trong máu để hỗ trợ chức năng sinh lý.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="đặt đường truyền lớn">
  <data key="d0">đặt đường truyền lớn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thao tác tạo đường truyền máu để truyền dịch trong tình trạng mất thể tích mạch máu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="siêu âm đánh giá dịch ổ bụng">
  <data key="d0">siêu âm đánh giá dịch ổ bụng</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là kỹ thuật sử dụng siêu âm để phát hiện dịch và nguồn chảy máu trong ổ bụng.&lt;SEP&gt;Dùng để đánh giá dịch ổ bụng và tìm nguồn chảy máu trong chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="thể tích lòng mạch">
  <data key="d0">thể tích lòng mạch</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số đo lường lượng máu trong lòng mạch, dùng để đánh giá tình trạng tuần hoàn.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="điều trị chấn thương">
  <data key="d0">điều trị chấn thương</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là quá trình can thiệp nhằm xử lý các tổn thương và phục hồi chức năng sau chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="định nhóm máu">
  <data key="d0">định nhóm máu</data>
  <data key="d1">khac</data>
  <data key="d2">Lấy máu làm xét nghiệm để xác định nhóm máu và hỗ trợ điều trị cho bệnh nhân chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-004</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="gãy xương chậu mất vững">
  <data key="d0">gãy xương chậu mất vững</data>
  <data key="d1">benh</data>
  <data key="d2">Một dạng chấn thương xương chậu dẫn đến mất vững và chảy máu.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="chấn thương mạch máu">
  <data key="d0">chấn thương mạch máu</data>
  <data key="d1">nguyen_nhan</data>
  <data key="d2">Là nguyên nhân dẫn đến sốc mất máu sau chấn thương.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="bù 2000 ml dịch nacl 0,9%">
  <data key="d0">bù 2000 ml dịch nacl 0,9%</data>
  <data key="d1">thuoc</data>
  <data key="d2">Phương pháp bù dịch qua đường ngoại vi hoặc tĩnh mạch trung tâm.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="dung dịch cao phân tử">
  <data key="d0">dung dịch cao phân tử</data>
  <data key="d1">thuoc</data>
  <data key="d2">Loại dung dịch thay thế cho NaCl 0,9% trong bù dịch.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="huyết áp trung bình">
  <data key="d0">huyết áp trung bình</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số huyết áp trung bình mục tiêu khoảng 65mmHg trong hồi sức dịch.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="huyết áp tâm thu">
  <data key="d0">huyết áp tâm thu</data>
  <data key="d1">chi_so</data>
  <data key="d2">Chỉ số huyết áp tâm thu mục tiêu khoảng 90mmHg trong hồi sức dịch.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="đặt dẫn lưu lớn">
  <data key="d0">đặt dẫn lưu lớn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật đặt dẫn lưu lớn để xử trí tràn máu hoặc tràn khí màng phổi.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="hút dẫn lưu khí bằng kim">
  <data key="d0">hút dẫn lưu khí bằng kim</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật hút khí bằng kim 12 hoặc 14G tại vị trí chọc khoang liên sườn 2 đường giữa đòn.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="siêu âm tại giường">
  <data key="d0">siêu âm tại giường</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Xét nghiệm dùng để chẩn đoán ép tim cấp trong chấn thương.&lt;SEP&gt;Là phương pháp chẩn đoán hình ảnh được thực hiện nhanh chóng và chính xác ngay lập tức.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="chấn thương ngực kín">
  <data key="d0">chấn thương ngực kín</data>
  <data key="d1">benh</data>
  <data key="d2">Loại chấn thương ngực có thể gây ra tràn khí màng phổi hoặc ép tim cấp.&lt;SEP&gt;Là nguyên nhân có thể gây ra tình trạng ép tim cấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="chấn thương thấu ngực">
  <data key="d0">chấn thương thấu ngực</data>
  <data key="d1">benh</data>
  <data key="d2">Loại chấn thương thấu ngực có thể gây ra ép tim cấp hoặc tràn khí màng phổi.&lt;SEP&gt;Là nguyên nhân có thể gây ra tình trạng ép tim cấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005&lt;SEP&gt;12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="bù dịch">
  <data key="d0">bù dịch</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Dung dịch cao phân tử được dùng để chống chỉ định trong bù dịch cho sốc mất máu.&lt;SEP&gt;Là thủ thuật điều trị bằng việc bù nước và điện giải cho bệnh nhân bỏng, phải điều chỉnh theo từng bệnh nhân cụ thể.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-005&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-005</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong.md</data>
  <data key="d5">1793458913</data>
  <data key="d6"></data>
</node>
<node id="chọc tháo dịch màng tim">
  <data key="d0">chọc tháo dịch màng tim</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được thực hiện để xử trí bệnh nhân có tình trạng ép tim cấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="mở ngực cấp cứu">
  <data key="d0">mở ngực cấp cứu</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là thủ thuật được chỉ định khi tình trạng lâm sàng cải thiện sau khi khôi phục huyết áp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="bão hòa oxy">
  <data key="d0">bão hòa oxy</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số được theo dõi với giá trị &gt; 94% để đảm bảo đủ oxy cho cơ thể.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="cvp">
  <data key="d0">cvp</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số được theo dõi trong khoảng 8 – 12 mmHg.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="lactat">
  <data key="d0">lactat</data>
  <data key="d1">chi_so</data>
  <data key="d2">Là chỉ số được theo dõi mỗi 4 giờ để đảm bảo tưới máu tạng phù hợp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="huyết tương tươi động lạnh">
  <data key="d0">huyết tương tươi động lạnh</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là loại dịch truyền được chỉ định khi INR &gt; 2.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="cryo">
  <data key="d0">cryo</data>
  <data key="d1">thuoc</data>
  <data key="d2">Là loại dịch truyền được chỉ định khi fibrinogen &lt; 100 mg/dl.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="hồng cầu">
  <data key="d0">hồng cầu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh cần truyền 2 đơn vị khối hồng cầu khi hemoglobin &lt; 80g/l hoặc &lt; 100g/l nếu có nguy cơ mạch vành cấp.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="tiểu cầu">
  <data key="d0">tiểu cầu</data>
  <data key="d1">doi_tuong</data>
  <data key="d2">Là nhóm người bệnh cần truyền tiểu cầu khi tiểu cầu &lt; 50 G/l.</data>
  <data key="d3">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi-chunk-006</data>
  <data key="d4">12-chan-doan-va-xu-tri-cap-cuu-ban-dau-soc-chan-thuong-o-nguoi.md</data>
  <data key="d5">1793457790</data>
  <data key="d6"></data>
</node>
<node id="chấn thương xương và mô mềm">
  <data key="d0">chấn thương xương và mô mềm</data>
  <data key="d1">benh</data>
  <data key="d2">Là tình trạng tổn thương xảy ra ở xương và mô mềm do va chạm hoặc tác động ngoại vi.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="gãy một chi">
  <data key="d0">gãy một chi</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng lâm sàng khi một chi bị gãy do chấn thương khu trú.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="gãy xương chậu">
  <data key="d0">gãy xương chậu</data>
  <data key="d1">benh</data>
  <data key="d2">Bệnh lý xảy ra khi xương chậu bị gãy, thường đi kèm với chấn thương ngực bụng và sọ não.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="gãy xương đùi">
  <data key="d0">gãy xương đùi</data>
  <data key="d1">benh</data>
  <data key="d2">Loại gãy xương xảy ra ở xương đùi, được đề cập trong phạm vi bài học.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="gãy xương kín">
  <data key="d0">gãy xương kín</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật xử trí khi xương bị gãy nhưng không có vết thương hở.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="trật khớp">
  <data key="d0">trật khớp</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Tình trạng khớp bị lệch vị trí do chấn thương, thường đi kèm với gãy xương.&lt;SEP&gt;Là tình trạng chấn thương xảy ra ở khớp do va chạm hoặc va đập.&lt;SEP&gt;Là biến chứng xảy ra khi có tổn thương xương và khớp.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu-chunk-011</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md&lt;SEP&gt;16-van-chuyen-benh-nhan-cap-cuu.md</data>
  <data key="d5">1793460553</data>
  <data key="d6"></data>
</node>
<node id="sai khớp">
  <data key="d0">sai khớp</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Tình trạng khớp không nằm đúng vị trí do chấn thương, gây ảnh hưởng đến chức năng vận động.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="vết thương đứt rời">
  <data key="d0">vết thương đứt rời</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Triệu chứng lâm sàng khi mô mềm bị đứt rời do chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="hội chứng khoang">
  <data key="d0">hội chứng khoang</data>
  <data key="d1">benh</data>
  <data key="d2">Tình trạng xảy ra khi có chèn ép khoang mô mềm do chấn thương.&lt;SEP&gt;Tình trạng tăng áp lực trong khoang giải phẫu dẫn đến suy giảm tuần hoàn và tổn thương tạng</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000&lt;SEP&gt;13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-005</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="đường thở – hô hấp – tuần hoàn">
  <data key="d0">đường thở – hô hấp – tuần hoàn</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Chế độ đánh giá và xử trí cấp cứu ban đầu cho bệnh nhân chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="băng ép">
  <data key="d0">băng ép</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật cầm máu bằng cách dùng băng ép lên vùng bị chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-000</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="garô">
  <data key="d0">garô</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Thủ thuật cầm máu bằng cách sử dụng garô để ức chế dòng máu chảy ra ngoài.</data>
