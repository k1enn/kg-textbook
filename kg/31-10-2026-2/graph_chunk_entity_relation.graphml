<node id="siêu âm phát hiện các tổn thương khác">
  <data key="d0">siêu âm phát hiện các tổn thương khác</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Phương pháp phát hiện các tổn thương như tràn dịch, tràn máu màng phổi, chấn thương tạng, tràn máu ổ bụng.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
<node id="chấn thương tạng">
  <data key="d0">chấn thương tạng</data>
  <data key="d1">bien_chung</data>
  <data key="d2">Biến chứng do tổn thương cột sống, được phát hiện bằng siêu âm.</data>
  <data key="d3">09-cap-cuu-chan-thuong-cot-song-chunk-004</data>
  <data key="d4">09-cap-cuu-chan-thuong-cot-song.md</data>
  <data key="d5">1793455779</data>
  <data key="d6"></data>
</node>
