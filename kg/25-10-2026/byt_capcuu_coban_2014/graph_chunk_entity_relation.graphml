  <data key="d1">thu_thuat</data>
  <data key="d2">Là các biện pháp được thực hiện để điều trị sốc trong giai đoạn cấp cứu</data>
  <data key="d3">04-xu-tri-cap-cuu-soc-chunk-000&lt;SEP&gt;14-xu-tri-cap-cuu-benh-nhan-bong-chunk-000</data>
