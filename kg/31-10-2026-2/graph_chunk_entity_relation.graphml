  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng phổ biến khi có tổn thương ở vùng khớp.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="sưng">
  <data key="d0">sưng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lâm sàng biểu hiện sự sưng tại vùng bị tổn thương sau chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="dấu hiệu lò xo">
  <data key="d0">dấu hiệu lò xo</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu lò xo thể hiện khi thay đổi tư thế và khi buông tay thì chi trở lại tư thế ban đầu.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="dấu hiệu biến dạng">
  <data key="d0">dấu hiệu biến dạng</data>
  <data key="d1">trieu_chung</data>
  <data key="d2">Là dấu hiệu biến dạng thể hiện sự thay đổi hình dáng ở các khớp, dễ nhận biết trong chẩn đoán.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="đánh giá và bảo đảm abc">
  <data key="d0">đánh giá và bảo đảm abc</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là bước đầu tiên trong xử trí chấn thương nhằm đảm bảo an toàn hô hấp, tuần hoàn và thần kinh.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="cố định">
  <data key="d0">cố định</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật cố định chi để ngăn ngừa tổn thương thêm trong quá trình điều trị chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="vết thương đứt rời hoàn toàn">
  <data key="d0">vết thương đứt rời hoàn toàn</data>
  <data key="d1">benh</data>
  <data key="d2">Là trường hợp vết thương đứt rời hoàn toàn không có cấu trúc giải phẫu nào nối kết giữa phần chi và mỏm cụt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="vết thương đứt rời không hoàn toàn">
  <data key="d0">vết thương đứt rời không hoàn toàn</data>
  <data key="d1">benh</data>
  <data key="d2">Là trường hợp vết thương đứt rời không hoàn toàn còn có cấu trúc giải phẫu nối kết giữa phần chi và mỏm cụt.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-007</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="xét nghiệm, thăm dò chẩn đoán hình ảnh">
  <data key="d0">xét nghiệm, thăm dò chẩn đoán hình ảnh</data>
  <data key="d1">xet_nghiem</data>
  <data key="d2">Là các xét nghiệm và phương pháp chẩn đoán hình ảnh được thực hiện khi tình trạng bệnh nhân cho phép.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
<node id="cầm máu bằng cách băng ép hoặc garo">
  <data key="d0">cầm máu bằng cách băng ép hoặc garo</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật cầm máu bằng cách sử dụng băng ép hoặc garo trong xử trí chấn thương.</data>
  <data key="d3">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi-chunk-008</data>
  <data key="d4">13-cap-cuu-chan-thuong-xuong-mo-mem-va-chi-the-dut-roi.md</data>
  <data key="d5">1793458474</data>
  <data key="d6"></data>
</node>
