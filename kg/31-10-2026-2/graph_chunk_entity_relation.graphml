</node>
<node id="thay đổi tư thế">
  <data key="d0">thay đổi tư thế</data>
  <data key="d1">thu_thuat</data>
  <data key="d2">Là một kỹ thuật đơn giản để khai thông đường thở bằng cách thay đổi tư thế đầu bệnh nhân.</data>
  <data key="d3">02-cac-ky-thuat-kiem-soat-duong-tho-chunk-000</data>
