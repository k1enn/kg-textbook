  <data key="d1">thu_thuat</data>
  <data key="d2">Là kỹ thuật hỗ trợ hô hấp bằng cách dùng bóng để duy trì sự thông thoáng đường thở.</data>
  <data key="d3">08-cap-cuu-chan-thuong-so-nao-chunk-006</data>
